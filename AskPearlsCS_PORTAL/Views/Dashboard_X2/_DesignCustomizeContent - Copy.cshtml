<!-- PAGE: DESIGN & CUSTOMIZE -->
<div class="design-customize-page container-fluid py-4">
    <!-- Shared AskPearls breadcrumb -->
    <nav class="ap-breadcrumb" aria-label="Breadcrumb">
        <a href="/Dashboard">AskPearls</a>
        <span class="ap-breadcrumb-separator" aria-hidden="true">/</span>
        <span class="ap-breadcrumb-current" aria-current="page">Design &amp; Customize</span>
    </nav>


    <div class="dc-page-header">
        <div>
            <h2>Design &amp; Customize</h2>
            <p>Personalize your widget's appearance and see your changes instantly.</p>
        </div>
        <div class="dc-header-actions">
            <span class="dc-draft-indicator" id="dcDraftIndicator">
                <i class="bi bi-circle-fill"></i> Unsaved changes
            </span>
            <button type="button" class="dc-btn-outline" id="dcReset">
                <i class="bi bi-arrow-counterclockwise"></i> Reset
            </button>
            <button type="button" class="dc-btn-primary" id="dcSave">
                <i class="bi bi-check-lg"></i> Save Draft
            </button>
        </div>
    </div>

    <div class="dc-widget-selector">
        <div class="dc-selector-icon"><i class="bi bi-grid-1x2"></i></div>
        <div class="dc-selector-info">
            <label for="dcWidgetSelect">Widget to customize</label>
            <select id="dcWidgetSelect">
                <option value="sofa">Sofa Finder Widget</option>
                <option value="furniture">Furniture Recommendation Widget</option>
                <option value="demo">Demo Recommendation Widget</option>
            </select>
        </div>
        <span class="dc-demo-badge">Preview mode</span>
    </div>

    <div class="dc-workspace">

        <!-- SETTINGS -->
        <section class="dc-settings">

            <div class="dc-section-heading">
                <div>
                    <h5>Widget Appearance</h5>
                    <p>Customize colors, typography, and shape.</p>
                </div>
                <i class="bi bi-palette"></i>
            </div>

            <div class="dc-settings-body">

                <div class="dc-field">
                    <label for="dcPrimaryColor">Primary color</label>
                    <div class="dc-color-control">
                        <input type="color" id="dcPrimaryColor" value="#0da88b">
                        <input type="text" id="dcPrimaryHex" value="#0DA88B"
                               maxlength="7" aria-label="Primary color hex value">
                    </div>
                    <small>Used for buttons and important accents.</small>
                </div>

                <div class="dc-field">
                    <label for="dcBackgroundColor">Widget background</label>
                    <div class="dc-color-control">
                        <input type="color" id="dcBackgroundColor" value="#ffffff">
                        <input type="text" id="dcBackgroundHex" value="#FFFFFF"
                               maxlength="7" aria-label="Widget background hex value">
                    </div>
                </div>

                <div class="dc-field">
                    <label for="dcTextColor">Text color</label>
                    <div class="dc-color-control">
                        <input type="color" id="dcTextColor" value="#17212b">
                        <input type="text" id="dcTextHex" value="#17212B"
                               maxlength="7" aria-label="Text color hex value">
                    </div>
                </div>

                <div class="dc-field">
                    <label for="dcFontFamily">Typography</label>
                    <select id="dcFontFamily">
                        <option value="Inter, Arial, sans-serif">Inter / System</option>
                        <option value="Arial, sans-serif">Arial</option>
                        <option value="Georgia, serif">Georgia</option>
                        <option value="Verdana, sans-serif">Verdana</option>
                    </select>
                </div>

                <div class="dc-field">
                    <div class="dc-label-row">
                        <label for="dcFontSize">Font size</label>
                        <span id="dcFontSizeValue">14 px</span>
                    </div>
                    <input type="range" id="dcFontSize" min="12" max="18" value="14">
                </div>

                <div class="dc-field">
                    <div class="dc-label-row">
                        <label for="dcRadius">Corner radius</label>
                        <span id="dcRadiusValue">12 px</span>
                    </div>
                    <input type="range" id="dcRadius" min="0" max="28" value="12">
                </div>

                <div class="dc-field">
                    <label>Widget shadow</label>
                    <label class="dc-toggle-row">
                        <span>
                            <strong>Enable shadow</strong>
                            <small>Add depth to the widget container.</small>
                        </span>
                        <span class="dc-switch">
                            <input type="checkbox" id="dcShadow" checked>
                            <span class="dc-switch-track"></span>
                        </span>
                    </label>
                </div>

                <div class="dc-divider"></div>

                <div class="dc-section-heading dc-subheading">
                    <div>
                        <h5>Layout &amp; Position</h5>
                        <p>Choose the widget's size and placement.</p>
                    </div>
                    <i class="bi bi-arrows-move"></i>
                </div>

                <div class="dc-field">
                    <div class="dc-label-row">
                        <label for="dcWidth">Widget width</label>
                        <span id="dcWidthValue">360 px</span>
                    </div>
                    <input type="range" id="dcWidth" min="300" max="520" step="10" value="360">
                </div>

                <div class="dc-field">
                    <label for="dcPosition">Widget position</label>
                    <select id="dcPosition">
                        <option value="bottom-right">Bottom right</option>
                        <option value="bottom-left">Bottom left</option>
                        <option value="center">Centered preview</option>
                    </select>
                </div>

                <div class="dc-field">
                    <label for="dcButtonShape">Button shape</label>
                    <select id="dcButtonShape">
                        <option value="rounded">Rounded</option>
                        <option value="pill">Pill</option>
                        <option value="square">Square</option>
                    </select>
                </div>

                <div class="dc-divider"></div>

                <div class="dc-section-heading dc-subheading">
                    <div>
                        <h5>Welcome Content</h5>
                        <p>Customize the message visitors see.</p>
                    </div>
                    <i class="bi bi-chat-square-text"></i>
                </div>

                <div class="dc-field">
                    <label for="dcHeading">Welcome heading</label>
                    <input type="text" id="dcHeading" maxlength="100"
                           value="Find your perfect sofa">
                </div>

                <div class="dc-field">
                    <label for="dcDescription">Welcome message</label>
                    <textarea id="dcDescription" rows="3" maxlength="250">Answer a few quick questions and discover the sofa that fits your home.</textarea>
                </div>

                <div class="dc-field">
                    <label for="dcButtonText">Button label</label>
                    <input type="text" id="dcButtonText" maxlength="40"
                           value="Get started">
                </div>

                <div class="dc-field">
                    <label for="dcFooterText">Footer text</label>
                    <input type="text" id="dcFooterText" maxlength="80"
                           value="Powered by AskPearls">
                </div>
            </div>
        </section>

        <!-- LIVE PREVIEW -->
        <section class="dc-preview-panel">
            <div class="dc-preview-header">
                <div>
                    <h5>Live Preview</h5>
                    <p>Changes appear here instantly.</p>
                </div>
                <div class="dc-preview-actions">
                    <button type="button" class="dc-preview-mode active"
                            data-dc-mode="light" title="Light preview">
                        <i class="bi bi-sun"></i>
                    </button>
                    <button type="button" class="dc-preview-mode"
                            data-dc-mode="dark" title="Dark preview">
                        <i class="bi bi-moon"></i>
                    </button>
                    <button type="button" class="dc-preview-mode"
                            data-dc-mode="mobile" title="Mobile preview">
                        <i class="bi bi-phone"></i>
                    </button>
                </div>
            </div>

            <div class="dc-preview-canvas" id="dcPreviewCanvas">
                <div class="dc-preview-position" id="dcPreviewPosition">
                    <div class="dc-widget-preview" id="dcWidgetPreview">
                        <div class="dc-widget-top">
                            <div class="dc-widget-brand">
                                <div class="dc-brand-icon"><i class="bi bi-stars"></i></div>
                                <span>AskPearls Assistant</span>
                            </div>
                            <button type="button" class="dc-widget-menu"
                                    aria-label="Preview menu">
                                <i class="bi bi-three-dots"></i>
                            </button>
                        </div>

                        <div class="dc-widget-content">
                            <div class="dc-welcome-icon"><i class="bi bi-stars"></i></div>
                            <h3 id="dcPreviewHeading">Find your perfect sofa</h3>
                            <p id="dcPreviewDescription">
                                Answer a few quick questions and discover the sofa that fits your home.
                            </p>

                            <div class="dc-preview-question">
                                <span class="dc-preview-step">01</span>
                                <div>
                                    <strong>What best describes your living space?</strong>
                                    <small>Choose the option that fits you best.</small>
                                </div>
                            </div>

                            <button type="button" class="dc-preview-answer">
                                <span><i class="bi bi-house"></i> Apartment</span>
                                <i class="bi bi-chevron-right"></i>
                            </button>
                            <button type="button" class="dc-preview-answer">
                                <span><i class="bi bi-house-door"></i> House</span>
                                <i class="bi bi-chevron-right"></i>
                            </button>

                            <button type="button" class="dc-preview-cta" id="dcPreviewButton">
                                Get started <i class="bi bi-arrow-right"></i>
                            </button>
                        </div>

                        <div class="dc-widget-footer" id="dcPreviewFooter">
                            Powered by AskPearls
                        </div>
                    </div>
                </div>

                <div class="dc-canvas-caption">
                    <i class="bi bi-info-circle"></i>
                    Illustrative preview — actual appearance may vary by website.
                </div>
            </div>
        </section>
    </div>

    <div class="dc-toast" id="dcToast" role="status" aria-live="polite"></div>
</div>

<style>
    .design-customize-page {
        --dc-primary: #0da88b;
        --dc-widget-bg: #ffffff;
        --dc-widget-text: #17212b;
        color: var(--ap-text, var(--bs-body-color, #17212b));
        min-width: 0;
    }

        .design-customize-page * {
            box-sizing: border-box;
        }

        .design-customize-page .dc-page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 16px;
            margin-bottom: 24px;
        }

            .design-customize-page .dc-page-header h2 {
                margin: 0 0 7px;
                font-size: 27px;
                font-weight: 750;
                color: var(--ap-text, var(--bs-body-color, #17212b));
            }

            .design-customize-page .dc-page-header p,
            .design-customize-page .dc-section-heading p,
            .design-customize-page .dc-preview-header p {
                margin: 0;
                color: var(--ap-muted, var(--bs-secondary-color, #718096));
                font-size: 13px;
            }

        .design-customize-page .dc-header-actions {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            flex-wrap: wrap;
            gap: 9px;
        }

        .design-customize-page .dc-draft-indicator {
            font-size: 11px;
            color: var(--ap-muted, #718096);
            margin-right: 5px;
        }

            .design-customize-page .dc-draft-indicator i {
                color: #e0a23c;
                font-size: 7px;
                vertical-align: middle;
                margin-right: 5px;
            }

        .design-customize-page .dc-btn-primary,
        .design-customize-page .dc-btn-outline {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            border-radius: 9px;
            padding: 10px 14px;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
        }

        .design-customize-page .dc-btn-primary {
            color: #fff;
            background: #0da88b;
            border: 1px solid #0da88b;
        }

            .design-customize-page .dc-btn-primary:hover {
                color: #fff;
                background: #078d74;
            }

        .design-customize-page .dc-btn-outline {
            color: var(--ap-text, var(--bs-body-color, #17212b));
            background: var(--ap-card-bg, var(--bs-body-bg, #fff));
            border: 1px solid var(--ap-border, var(--bs-border-color, #dce8e4));
        }

        .design-customize-page .dc-widget-selector,
        .design-customize-page .dc-settings,
        .design-customize-page .dc-preview-panel {
            border: 1px solid var(--ap-border, var(--bs-border-color, #e2e8f0));
            border-radius: 14px;
            background: var(--ap-card-bg, var(--bs-body-bg, #fff));
        }

        .design-customize-page .dc-widget-selector {
            display: flex;
            align-items: center;
            gap: 13px;
            padding: 16px 20px;
            margin-bottom: 20px;
        }

        .design-customize-page .dc-selector-icon {
            width: 43px;
            height: 43px;
            flex: 0 0 43px;
            display: grid;
            place-items: center;
            border-radius: 11px;
            background: rgba(13,168,139,.12);
            color: #0da88b;
            font-size: 19px;
        }

        .design-customize-page .dc-selector-info {
            display: flex;
            flex-direction: column;
            flex: 1;
            min-width: 0;
            gap: 5px;
        }

            .design-customize-page .dc-selector-info label {
                font-size: 11px;
                color: var(--ap-muted, #718096);
                font-weight: 700;
            }

            .design-customize-page .dc-selector-info select {
                width: 100%;
                max-width: 360px;
                border: 0;
                outline: 0;
                padding: 0;
                color: var(--ap-text, var(--bs-body-color, #17212b));
                background: transparent;
                font: inherit;
                font-size: 14px;
                font-weight: 700;
            }

        .design-customize-page .dc-demo-badge {
            color: #0d9278;
            background: rgba(13,168,139,.12);
            border-radius: 30px;
            padding: 6px 10px;
            font-size: 10px;
            font-weight: 700;
            white-space: nowrap;
        }

        .design-customize-page .dc-workspace {
            display: grid;
            grid-template-columns: minmax(300px, 420px) minmax(0, 1fr);
            gap: 20px;
            align-items: start;
        }

        .design-customize-page .dc-settings {
            overflow: hidden;
        }

        .design-customize-page .dc-section-heading {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 12px;
            padding: 21px 22px;
            border-bottom: 1px solid var(--ap-border, var(--bs-border-color, #e2e8f0));
        }

            .design-customize-page .dc-section-heading h5,
            .design-customize-page .dc-preview-header h5 {
                margin: 0 0 5px;
                font-size: 15px;
                font-weight: 750;
                color: var(--ap-text, var(--bs-body-color, #17212b));
            }

            .design-customize-page .dc-section-heading > i {
                color: #0da88b;
                font-size: 18px;
            }

        .design-customize-page .dc-settings-body {
            padding: 21px 22px;
        }

        .design-customize-page .dc-field {
            margin-bottom: 20px;
        }

            .design-customize-page .dc-field > label,
            .design-customize-page .dc-label-row label {
                display: block;
                margin-bottom: 8px;
                color: var(--ap-text, var(--bs-body-color, #17212b));
                font-size: 12px;
                font-weight: 700;
            }

            .design-customize-page .dc-field > small {
                display: block;
                margin-top: 7px;
                color: var(--ap-muted, #718096);
                font-size: 10px;
            }

            .design-customize-page .dc-field input[type="text"],
            .design-customize-page .dc-field select,
            .design-customize-page .dc-field textarea {
                width: 100%;
                min-width: 0;
                border: 1px solid var(--ap-border, var(--bs-border-color, #dce8e4));
                border-radius: 8px;
                padding: 10px 12px;
                background: var(--ap-input-bg, var(--bs-tertiary-bg, #f4f8f7));
                color: var(--ap-text, var(--bs-body-color, #17212b));
                font: inherit;
                font-size: 12px;
                outline: none;
            }

                .design-customize-page .dc-field input:focus,
                .design-customize-page .dc-field select:focus,
                .design-customize-page .dc-field textarea:focus {
                    border-color: #0da88b;
                    box-shadow: 0 0 0 3px rgba(13,168,139,.12);
                }

        .design-customize-page .dc-color-control {
            display: flex;
            gap: 9px;
        }

            .design-customize-page .dc-color-control input[type="color"] {
                width: 45px;
                height: 40px;
                flex: 0 0 45px;
                padding: 4px;
                border: 1px solid var(--ap-border, var(--bs-border-color, #dce8e4));
                border-radius: 8px;
                background: var(--ap-input-bg, #f4f8f7);
                cursor: pointer;
            }

            .design-customize-page .dc-color-control input[type="text"] {
                font-family: Consolas, monospace;
                text-transform: uppercase;
            }

        .design-customize-page .dc-label-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
        }

            .design-customize-page .dc-label-row label {
                margin-bottom: 8px;
            }

            .design-customize-page .dc-label-row span {
                color: #0da88b;
                font-size: 11px;
                font-weight: 700;
            }

        .design-customize-page .dc-field input[type="range"] {
            width: 100%;
            accent-color: #0da88b;
            cursor: pointer;
        }

        .design-customize-page .dc-toggle-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            border: 1px solid var(--ap-border, var(--bs-border-color, #dce8e4));
            border-radius: 9px;
            padding: 13px;
            background: var(--ap-input-bg, var(--bs-tertiary-bg, #f4f8f7));
        }

            .design-customize-page .dc-toggle-row strong {
                display: block;
                font-size: 12px;
                color: var(--ap-text, var(--bs-body-color, #17212b));
            }

            .design-customize-page .dc-toggle-row small {
                display: block;
                margin-top: 5px;
                color: var(--ap-muted, #718096);
                font-size: 10px;
            }

        .design-customize-page .dc-switch {
            position: relative;
            width: 40px;
            height: 23px;
            flex: 0 0 40px;
        }

            .design-customize-page .dc-switch input {
                position: absolute;
                width: 1px;
                height: 1px;
                opacity: 0;
            }

        .design-customize-page .dc-switch-track {
            position: absolute;
            inset: 0;
            border-radius: 20px;
            background: #9aa8a5;
            cursor: pointer;
        }

            .design-customize-page .dc-switch-track::before {
                content: "";
                position: absolute;
                left: 3px;
                top: 3px;
                width: 17px;
                height: 17px;
                border-radius: 50%;
                background: #fff;
                transition: transform .2s;
            }

        .design-customize-page .dc-switch input:checked + .dc-switch-track {
            background: #0da88b;
        }

            .design-customize-page .dc-switch input:checked + .dc-switch-track::before {
                transform: translateX(17px);
            }

        .design-customize-page .dc-divider {
            height: 1px;
            margin: 25px 0;
            background: var(--ap-border, var(--bs-border-color, #e2e8f0));
        }

        .design-customize-page .dc-subheading {
            padding: 0;
            margin-bottom: 22px;
            border: 0;
        }

        .design-customize-page .dc-preview-panel {
            min-width: 0;
            overflow: hidden;
            position: sticky;
            top: 20px;
        }

        .design-customize-page .dc-preview-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
            padding: 20px 22px;
            border-bottom: 1px solid var(--ap-border, var(--bs-border-color, #e2e8f0));
        }

        .design-customize-page .dc-preview-actions {
            display: flex;
            gap: 5px;
            padding: 4px;
            border: 1px solid var(--ap-border, var(--bs-border-color, #e2e8f0));
            border-radius: 9px;
        }

        .design-customize-page .dc-preview-mode {
            display: grid;
            place-items: center;
            width: 31px;
            height: 30px;
            border: 0;
            border-radius: 6px;
            background: transparent;
            color: var(--ap-muted, #718096);
            cursor: pointer;
        }

            .design-customize-page .dc-preview-mode.active {
                background: rgba(13,168,139,.14);
                color: #0da88b;
            }

        .design-customize-page .dc-preview-canvas {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 590px;
            padding: 30px;
            background-color: #eef3f1;
            background-image: radial-gradient(#cdd9d4 1px, transparent 1px);
            background-size: 17px 17px;
            transition: background .2s;
        }

        .design-customize-page .dc-preview-position {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            transition: justify-content .2s;
        }

            .design-customize-page .dc-preview-position[data-position="bottom-right"] {
                justify-content: flex-end;
            }

            .design-customize-page .dc-preview-position[data-position="bottom-left"] {
                justify-content: flex-start;
            }

            .design-customize-page .dc-preview-position[data-position="center"] {
                justify-content: center;
            }

        .design-customize-page .dc-widget-preview {
            width: min(100%, 360px);
            overflow: hidden;
            border-radius: 12px;
            background: #fff;
            color: #17212b;
            font-family: Inter, Arial, sans-serif;
            font-size: 14px;
            box-shadow: 0 18px 55px rgba(20,35,30,.18);
            transition: width .2s, border-radius .2s, box-shadow .2s, background .2s, color .2s;
        }

        .design-customize-page .dc-widget-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            padding: 15px 17px;
            background: var(--dc-primary);
            color: #fff;
        }

        .design-customize-page .dc-widget-brand {
            display: flex;
            align-items: center;
            gap: 9px;
            min-width: 0;
            font-size: 12px;
            font-weight: 700;
        }

        .design-customize-page .dc-brand-icon {
            display: grid;
            place-items: center;
            width: 30px;
            height: 30px;
            flex: 0 0 30px;
            border-radius: 9px;
            background: rgba(255,255,255,.2);
            font-size: 15px;
        }

        .design-customize-page .dc-widget-menu {
            border: 0;
            color: inherit;
            background: transparent;
            font-size: 19px;
        }

        .design-customize-page .dc-widget-content {
            padding: 22px 19px 19px;
        }

        .design-customize-page .dc-welcome-icon {
            display: grid;
            place-items: center;
            width: 42px;
            height: 42px;
            margin-bottom: 15px;
            border-radius: 12px;
            background: color-mix(in srgb, var(--dc-primary) 13%, transparent);
            color: var(--dc-primary);
            font-size: 20px;
        }

        .design-customize-page .dc-widget-content h3 {
            margin: 0 0 10px;
            color: var(--dc-widget-text);
            font-size: 20px;
            font-weight: 750;
            line-height: 1.3;
            overflow-wrap: anywhere;
        }

        .design-customize-page .dc-widget-content > p {
            margin: 0 0 21px;

    html[data-theme="dark"] .design-customize-page .dc-color-control input[type="text"],
    body[data-theme="dark"] .design-customize-page .dc-color-control input[type="text"],
    html[data-bs-theme="dark"] .design-customize-page .dc-color-control input[type="text"],
    body[data-bs-theme="dark"] .design-customize-page .dc-color-control input[type="text"] {
        background-color: #10221c !important;
        color: #f0f5f3 !important;
        border-color: #344d44 !important;
        caret-color: #0da88b;
    }

        /* Improve focus visibility */
        html[data-theme="dark"] .design-customize-page select:focus,
        html[data-theme="dark"] .design-customize-page .dc-color-control input[type="text"]:focus,
        body[data-theme="dark"] .design-customize-page select:focus,
        body[data-theme="dark"] .design-customize-page .dc-color-control input[type="text"]:focus,
        html[data-bs-theme="dark"] .design-customize-page select:focus,
        html[data-bs-theme="dark"] .design-customize-page .dc-color-control input[type="text"]:focus,
        body[data-bs-theme="dark"] .design-customize-page select:focus,
        body[data-bs-theme="dark"] .design-customize-page .dc-color-control input[type="text"]:focus {
            border-color: #0da88b !important;

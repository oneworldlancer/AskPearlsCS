
    <style>
            :root {
                color-scheme: light;
                --page: #f5faf8;
                --surface: #ffffff;
                --surface-2: #f2f8f6;
                --text: #172b3d;
                --muted: #698096;
                --border: #dce9e4;
                --primary: #0da88a;
                --primary-hover: #098b72;
                --active: #e4f7f1;
                --shadow: 0 16px 50px rgba(0, 0, 0, .18);
                --overlay: rgba(5, 20, 18, .65);
                --danger: #e65b70;
            }

            html[data-theme="dark"] {
                color-scheme: dark;
                --page: #071b18;
                --surface: #0e2722;
                --surface-2: #142f29;
                --text: #eff8f4;
                --muted: #a0b8ae;
                --border: #29483e;
                --primary: #0da88a;
                --primary-hover: #17bd9c;
                --active: #174b3e;
                --shadow: 0 16px 50px rgba(0, 0, 0, .4);
                --overlay: rgba(0, 0, 0, .72);
                --danger: #ff8795;
            }

            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                font-family: Inter, "Segoe UI", Arial, sans-serif;
                background: var(--page);
                color: var(--text);
                font-size: 14px;
            }

            button, input, textarea {
                font: inherit;
            }

            button {
                cursor: pointer;
            }

                button:focus-visible, input:focus-visible, textarea:focus-visible {
                    outline: 3px solid rgba(13, 168, 138, .3);
                    outline-offset: 2px;
                }

                button:disabled {
                    opacity: .5;
                    cursor: not-allowed;
                }

            .topbar {
                min-height: 68px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 16px;
                padding: 12px 24px;
                background: var(--surface);
                border-bottom: 1px solid var(--border);
            }

            .brand {
                font-size: 22px;
                font-weight: 800;
            }

                .brand span {
                    color: var(--primary);
                }

            .top-actions, .button-row {
                display: flex;
                align-items: center;
                flex-wrap: wrap;
                gap: 10px;
            }

            .page {
                max-width: 1600px;
                margin: auto;
                padding: 24px;
            }

            .page-heading {
                display: flex;
                justify-content: space-between;
                align-items: flex-start;
                gap: 20px;
                flex-wrap: wrap;
                margin-bottom: 24px;
            }

            .breadcrumb {
                color: var(--muted);
                margin-bottom: 12px;
            }

                .breadcrumb a {
                    color: var(--primary);
                    text-decoration: none;
                }

            h1 {
                margin: 0 0 10px;
                font-size: clamp(25px, 3vw, 34px);
            }

            h2, h3, p {
                margin-top: 0;
            }

            h2 {
                font-size: 19px;
            }

            h3 {
                font-size: 15px;
                margin-bottom: 8px;
            }

            .subtitle, .muted {
                color: var(--muted);
            }

            .subtitle {
                margin-bottom: 0;
                line-height: 1.6;
            }

            .button {
                min-height: 42px;
                padding: 10px 16px;
                border: 1px solid var(--border);
                border-radius: 9px;
                background: var(--surface);
                color: var(--text);
                font-weight: 650;
                display: inline-flex;
                justify-content: center;
                align-items: center;
                gap: 7px;
                white-space: nowrap;
                text-decoration: none;
            }

                .button:hover {
                    border-color: var(--primary);
                }

            .button-primary {
                color: #fff;
                background: var(--primary);
                border-color: var(--primary);
            }

                .button-primary:hover {
                    background: var(--primary-hover);
                }

            .button-small {
                min-height: 38px;
                padding: 8px 12px;
            }

            .button-danger {
                color: var(--danger);
                border-color: var(--danger);
            }

            .status-pill {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                padding: 10px 14px;
                border: 1px solid var(--border);
                border-radius: 24px;
                background: var(--surface);
                color: var(--muted);
                white-space: nowrap;
            }

            .status-dot {
                width: 8px;
                height: 8px;
                background: #f5a623;
                border-radius: 50%;
            }

            .widget-summary {
                display: flex;
                align-items: center;
                gap: 16px;
                padding: 20px;
                margin-bottom: 24px;
                background: var(--surface);
                border: 1px solid var(--border);
                border-radius: 14px;
            }

            .widget-icon {
                width: 48px;
                height: 48px;
                flex: 0 0 48px;
                display: grid;
                place-items: center;
                border-radius: 12px;
                background: var(--primary);
                color: white;
                font-size: 25px;
            }

            .widget-meta {
                flex: 1;
                min-width: 0;
            }

                .widget-meta strong {
                    display: block;
                    font-size: 17px;
                    margin-bottom: 6px;
                }

                .widget-meta span {
                    color: var(--muted);
                }

            .workspace {
                display: grid;
                grid-template-columns: minmax(230px, .82fr) minmax(320px, 1.5fr) minmax(280px, 1.1fr);
                gap: 20px;
                align-items: start;
            }

            .card {
                min-width: 0;
                background: var(--surface);
                border: 1px solid var(--border);
                border-radius: 14px;
                overflow: hidden;
            }

            .card-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 12px;
                padding: 20px;
                border-bottom: 1px solid var(--border);
            }

                .card-header h2 {
                    margin-bottom: 8px;
                }

                .card-header p {
                    margin-bottom: 0;
                    line-height: 1.5;
                }

            .question-list {
                padding: 10px;
            }

            .question-item {
                display: flex;
                align-items: center;
                gap: 12px;
                width: 100%;
                padding: 13px 10px;
                margin-bottom: 8px;
                text-align: left;
                color: var(--text);
                background: transparent;
                border: 1px solid transparent;
                border-radius: 10px;
            }

                .question-item:hover {
                    background: var(--surface-2);
                }

                .question-item.active {
                    background: var(--active);
                    border-color: #86d9c5;
                }

            .question-number {
                width: 34px;
                height: 34px;
                flex: 0 0 34px;
                display: grid;
                place-items: center;
                border: 1px solid var(--border);
                border-radius: 50%;
                font-weight: 750;
            }

            .question-item.active .question-number {
                background: var(--primary);
                border-color: var(--primary);
                color: #fff;
            }

            .question-label {
                min-width: 0;
            }

                .question-label strong {
                    display: block;
                    line-height: 1.45;
                }

                .question-label small {
                    display: block;
                    margin-top: 4px;
                    color: var(--muted);
                }

            .card-body {
                padding: 20px;
            }

            .section-heading {
                display: flex;
                align-items: flex-start;
                justify-content: space-between;
                gap: 12px;
                margin-bottom: 22px;
            }

                .section-heading p {
                    margin-bottom: 0;
                    line-height: 1.5;
                }

            .field {
                margin-bottom: 18px;
            }

                .field label, .field-label {
                    display: block;
                    margin-bottom: 8px;
                    font-size: 12px;
                    font-weight: 750;
                    text-transform: uppercase;
                    letter-spacing: .035em;
                }

            .readonly-value {
                width: 100%;
                padding: 13px;
                min-height: 44px;
                border: 1px solid var(--border);
                border-radius: 8px;
                background: var(--surface-2);
                overflow-wrap: anywhere;
            }

            .option-display {
                display: flex;
                gap: 10px;
                align-items: center;
                padding: 11px 12px;
                border: 1px solid var(--border);
                border-radius: 8px;
                margin-bottom: 8px;
            }

                .option-display span:first-child {
                    color: var(--muted);
                    width: 20px;
                }

            .empty-state {
                color: var(--muted);
                line-height: 1.6;
            }

            .preview-title {
                margin: 0 0 8px;
            }

            .preview-shell {
                margin-top: 18px;
                padding: 16px;
                background: var(--surface-2);
                border: 1px solid var(--border);
                border-radius: 14px;
            }

            .preview-card {
                background: #fff;
                color: #172b3d;
                padding: 20px;
                border: 1px solid #e1eae6;
                border-radius: 14px;
            }

            .preview-brand {
                display: flex;
                align-items: center;
                gap: 10px;
                font-weight: 750;
            }

            .preview-brand-icon {
                display: grid;
                place-items: center;
                width: 38px;
                height: 38px;
                border-radius: 9px;
                background: var(--primary);
                color: white;
                font-size: 20px;
            }

            .progress-meta {
                display: flex;
                justify-content: space-between;
                color: #698096;
                font-size: 12px;
                margin: 22px 0 10px;
            }

            .progress-track {
                height: 6px;
                background: #e2ece8;
                border-radius: 10px;
                overflow: hidden;
            }

            .progress-fill {
                height: 100%;
                width: 33%;
                background: var(--primary);
            }

            .preview-question {
                font-size: 22px;
                line-height: 1.4;
                margin: 24px 0 12px;
            }

            .preview-help {
                color: #698096;
                line-height: 1.6;
            }

            .preview-option {
                padding: 12px;
                margin-top: 9px;
                border: 1px solid #dce9e4;
                border-radius: 8px;
                color: #344c60;
            }

            .footer {
                margin-top: 32px;
                padding: 14px;
                text-align: center;
                color: var(--muted);
                border-top: 1px solid var(--border);
            }

            /* Modal is HIDDEN by default. JavaScript opens it only on Add/Edit. */
            .qna-modal-backdrop[hidden] {
                display: none !important;
            }

            .qna-modal-backdrop {
                position: fixed;
                inset: 0;
                z-index: 9999;
                display: flex;
                justify-content: center;
                align-items: center;
                padding: 16px;
                background: var(--overlay);
                backdrop-filter: blur(5px);
            }

            .qna-modal {
                width: min(960px, 100%);
                height: auto;
                max-height: calc(100vh - 32px);
                max-height: calc(100dvh - 32px);
                min-height: 0;
                display: flex;
                flex-direction: column;
                overflow: hidden;
                background: var(--surface);
                color: var(--text);
                border: 1px solid var(--border);
                border-radius: 16px;
                box-shadow: var(--shadow);
            }

            .qna-modal-header {
                flex: 0 0 auto;
                display: flex;
                justify-content: space-between;
                align-items: flex-start;
                gap: 16px;
                padding: 20px 24px;
                border-bottom: 1px solid var(--border);
            }

            .qna-modal-heading {
                display: flex;
                gap: 14px;
                align-items: center;
            }

            .qna-modal-heading-icon {
                width: 34px;
                height: 34px;
                display: grid;
                place-items: center;
                color: var(--primary);
                font-size: 23px;
            }

            .qna-modal-title {
                margin: 0 0 5px;
                font-size: 20px;
            }

            .qna-modal-subtitle {
                margin: 0;
                color: var(--muted);
                line-height: 1.5;
            }

            .qna-modal-close {
                flex: 0 0 auto;
                border: 0;
                background: transparent;
                color: var(--text);
                font-size: 27px;
                line-height: 1;
                padding: 3px 6px;
            }

            #qnaQuestionForm {
                display: flex;
                flex-direction: column;
                flex: 1 1 auto;
                min-height: 0;
                overflow: hidden;
            }

            .qna-modal-body {
                flex: 1 1 auto;
                min-height: 0;
                overflow-x: hidden;
                overflow-y: auto;
                overscroll-behavior: contain;
                -webkit-overflow-scrolling: touch;
                padding: 22px 24px;
            }

            .qna-modal-grid {
                display: grid;
                grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
                gap: 24px;
            }

            .qna-modal-section {
                min-width: 0;
            }

            .qna-modal-section-title {
                margin: 0 0 8px;
                font-size: 15px;
            }

            .qna-modal-section-description {
                color: var(--muted);
                line-height: 1.5;
                margin-bottom: 22px;
                font-size: 13px;
            }

            .qna-required-star {
                color: #e65b70;
            }

            .qna-form-field {
                margin-bottom: 18px;
            }

            .qna-form-label {
                display: block;
                margin-bottom: 8px;
                font-size: 12px;
                font-weight: 750;
            }

            .qna-form-control {
                display: block;
                width: 100%;
                min-width: 0;
                padding: 12px;
                color: var(--text);
                background: var(--surface-2);
                border: 1px solid var(--border);
                border-radius: 8px;
            }

            textarea.qna-form-control {
                min-height: 94px;
                resize: vertical;
                line-height: 1.5;
            }

            #qnaInputHelper {
                min-height: 90px;
            }

            .qna-form-control::placeholder {
                color: var(--muted);
                opacity: 1;
            }

            .qna-field-help {
                display: block;
                margin-top: 8px;
                color: var(--muted);
                line-height: 1.5;
                font-size: 12px;
            }

            .qna-required-setting {
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 12px;
                padding: 14px;
                background: var(--surface-2);
                border: 1px solid var(--border);
                border-radius: 9px;
            }

                .qna-required-setting strong {
                    display: block;
                    font-size: 12px;
                    margin-bottom: 5px;
                }

                .qna-required-setting small {
                    display: block;
                    color: var(--muted);
                    line-height: 1.5;
                }

            .qna-switch {
                position: relative;
                flex: 0 0 42px;
                width: 42px;
                height: 24px;
            }

                .qna-switch input {
                    position: absolute;
                    opacity: 0;
                    width: 1px;
                    height: 1px;
                }

            .qna-switch-track {
                position: absolute;
                inset: 0;
                cursor: pointer;
                border-radius: 20px;
                background: #9eaaa5;
                transition: background .2s;
            }

                .qna-switch-track::before {
                    content: "";
                    position: absolute;
                    width: 18px;
                    height: 18px;
                    top: 3px;
                    left: 3px;
                    border-radius: 50%;
                    background: #fff;
                    transition: transform .2s;
                }

            .qna-switch input:checked + .qna-switch-track {
                background: var(--primary);
            }

                .qna-switch input:checked + .qna-switch-track::before {
                    transform: translateX(18px);
                }

            .qna-answer-editor-header {
                display: flex;
                justify-content: space-between;
                align-items: flex-start;
                gap: 12px;
                margin-bottom: 16px;
            }

                .qna-answer-editor-header .qna-modal-section-description {
                    margin-bottom: 0;
                }

                .qna-answer-editor-header .button {
                    flex: 0 0 auto;
                }

            .qna-answer-row {
                display: grid;
                grid-template-columns: 24px minmax(0, 1fr) 38px;
                gap: 8px;
                align-items: center;
                margin-bottom: 10px;
            }

            .qna-answer-number {
                text-align: center;
                font-weight: 750;
                color: var(--muted);
            }

            .qna-answer-row .qna-form-control {
                min-height: 42px;
            }

            .qna-remove-option {
                min-height: 38px;
                width: 38px;
                display: grid;
                place-items: center;
                border: 1px solid var(--danger);
                border-radius: 8px;
                background: transparent;
                color: var(--danger);
                font-size: 19px;
            }

            .qna-modal-error {
                display: none;
                margin-top: 16px;
                padding: 12px;
                color: var(--danger);
                background: var(--surface-2);
                border: 1px solid var(--danger);
                border-radius: 8px;
                line-height: 1.5;
            }

                .qna-modal-error.visible {
                    display: block;
                }

            .qna-modal-footer {
                flex: 0 0 auto;
                display: flex;
                justify-content: flex-end;
                align-items: center;
                flex-wrap: nowrap;
                gap: 10px;
                padding: 16px 24px;
                border-top: 1px solid var(--border);
                background: var(--surface);
            }

                .qna-modal-footer .button {
                    flex: 0 0 auto;
                    white-space: nowrap;
                }

            .toast {
                position: fixed;
                z-index: 10001;
                bottom: 20px;
                right: 20px;
                max-width: calc(100% - 40px);
                padding: 14px 18px;
                color: white;
                background: #137b61;
                border-radius: 9px;
                box-shadow: var(--shadow);
            }

                .toast[hidden] {
                    display: none !important;
                }

            @@media (max-width: 1100px) {
                .workspace {
                    grid-template-columns: minmax(220px, .8fr) minmax(0, 1.4fr);
                }

                .preview-column {
                    grid-column: 1 / -1;
                }

                .preview-shell {
                    max-width: 540px;
                }
            }

            @@media (max-width: 700px) {
                .topbar {
                    padding: 12px 16px;
                }

                .page {
                    padding: 18px 12px;
                }

                .page-heading {
                    gap: 16px;
                }

                .workspace {
                    grid-template-columns: minmax(0, 1fr);
                    gap: 16px;
                }

                .preview-column {
                    grid-column: auto;
                }

                .widget-summary {
                    padding: 14px;
                }

                .qna-modal-backdrop {
                    padding: 8px;
                }

                .qna-modal {
                    max-height: calc(100vh - 16px);
                    max-height: calc(100dvh - 16px);
                    border-radius: 12px;
                }

                .qna-modal-header {
                    padding: 16px;
                }

                .qna-modal-body {
                    padding: 16px;
                }

                .qna-modal-grid {
                    grid-template-columns: minmax(0, 1fr);
                    gap: 24px;
                }

                .qna-modal-footer {
                    padding: 12px 16px;
                }

                .qna-answer-editor-header {
                    flex-wrap: wrap;
                }
            }

            @@media (max-width: 380px) {
                .qna-modal-title {
                    font-size: 18px;
                }

                .qna-modal-footer {
                    gap: 6px;
                }

                    .qna-modal-footer .button {
                        padding: 9px 10px;
                        font-size: 12px;
                    }
            }



            
/* =====================================================
   Q&A PAGE — FIX CONTENT SPACING IN THE PORTAL
   ===================================================== */

/* Main content injected by the AJAX section loader */
#apMainContent {
    min-width: 0;
}

/* Scope spacing to this page only */
#apMainContent .page-heading,
#apMainContent .widget-summary,
#apMainContent .workspace {
    margin-left: 28px;
    margin-right: 28px;
}

/* Add breathing room above the page heading */
#apMainContent .page-heading {
    margin-top: 28px;
}

/* Keep the summary and workspace spaced consistently */
#apMainContent .widget-summary {
    margin-top: 0;
}

#apMainContent .workspace {
    margin-top: 0;
}

/* Responsive adjustments */
@@media (max-width: 700px) {
    #apMainContent .page-heading,
    #apMainContent .widget-summary,
    #apMainContent .workspace {
        margin-left: 14px;
        margin-right: 14px;
    }

    #apMainContent .page-heading {
        margin-top: 20px;
    }
}


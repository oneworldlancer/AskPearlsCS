       ========================================================= */

    /* Full-screen overlay */
    #qnaModalBackdrop.qna-modal-backdrop {
        position: fixed;
        inset: 0;
        z-index: 2000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 16px;
        box-sizing: border-box;

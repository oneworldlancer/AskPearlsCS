                </div>
            </div>

            <button type="button" class="qna-modal-close"
                    id="qnaModalClose" aria-label="Close dialog">
                ×
            </button>
        </div>

        <form id="qnaQuestionForm">
            <div class="qna-modal-body">
                <div class="qna-modal-grid">

                    <!-- Question details -->
                    <section class="qna-modal-section">
                        <h3 class="qna-modal-section-title">Question details</h3>
                        <p class="qna-modal-section-description">
                            Define the question visitors will see.
                        </p>

                        <div class="qna-form-field">
                            <label class="qna-form-label" for="qnaInputText">
                                Question text <span class="qna-required-star">*</span>
                            </label>
                            <textarea class="qna-form-control"
                                      id="qnaInputText"
                                      maxlength="300"
                                      required
                                      placeholder="e.g. How many people will use the sofa?"></textarea>
                        </div>

                        <div class="qna-form-field">
                            <label class="qna-form-label" for="qnaInputKey">
                                Question identifier <span class="qna-required-star">*</span>
                            </label>
                            <input class="qna-form-control"
                                   id="qnaInputKey"
                                   maxlength="80"
                                   required
                                   pattern="[a-zA-Z][a-zA-Z0-9_]*"
                                   placeholder="e.g. users"
                                   autocomplete="off">
                            <small class="qna-field-help">
                                A unique technical key for identifying this question
                                in the decision flow. Use letters, numbers and
                                underscores; start with a letter.
                            </small>
                        </div>

                        <div class="qna-form-field">
                            <label class="qna-form-label" for="qnaInputHelper">
                                Helper text
                            </label>
                            <textarea class="qna-form-control"
                                      id="qnaInputHelper"
                                      maxlength="200"
                                      rows="3"
                                      placeholder="Optional guidance for visitors"></textarea>
                        </div>

                        <div class="qna-required-setting">
                            <div>
                                <strong>Required question</strong>
                                <small>Visitors must answer before continuing.</small>
                            </div>

                            <label class="qna-switch">
                                <input type="checkbox" id="qnaInputRequired" checked>
                                <span class="qna-switch-track"></span>
                            </label>
                        </div>
                    </section>

                    <!-- Answer options -->
                    <section class="qna-modal-section">
                        <div class="qna-answer-editor-header">
                            <div>
                                <h3 class="qna-modal-section-title">Answer options</h3>
                                <p class="qna-modal-section-description" style="margin-bottom:0">
                                    Add the possible answers visitors can choose.
                                </p>
                            </div>

                            <button type="button"
                                    class="qna-btn qna-btn-outline"
                                    id="qnaAddOptionButton">
                                + Add option
                            </button>
                        </div>

                        <div class="qna-answer-editor-list" id="qnaAnswerEditorList"></div>

                        <small class="qna-field-help">
                            Keep each answer short and distinct. Reorder and
                            decision-scoring configuration can be connected later.
                        </small>
                    </section>
                </div>

                <div class="qna-modal-error" id="qnaModalError"
                     role="alert"></div>
            </div>

            <div class="qna-modal-footer">
                <button type="button" class="qna-btn qna-btn-outline"
                        id="qnaCancelButton">
                    Cancel
                </button>

                <button type="submit" class="qna-btn qna-btn-primary"
                        id="qnaSaveQuestionButton">
                    ✓ Save Question
                </button>
            </div>
        </form>
    </section>
</div>

<script>
    (function() {
        "use strict";

        /* =========================================================
           Demo data
           Replace this initial array with API-loaded data later.
           ========================================================= */

        let questions = [
            {
                id: 1,
                text: "How many people will use the sofa?",
                key: "users",
                helper: "Choose the option that best matches your needs.",
                required: true,
                answers: ["1–2 people", "3–4 people", "5 or more people"]
            },
            {
                id: 2,
                text: "What matters most to you?",
                key: "priority",
                helper: "Choose the feature that matters most.",
                required: true,
                answers: ["Comfort", "Style", "Space"]
            },
            {
                id: 3,
                text: "How much space do you have?",
                key: "space",
                helper: "Think about the available room in your home.",
                required: true,
                answers: ["Small room", "Medium room", "Large room"]
            }
        ];

        let selectedQuestionId = 1;
        let editingQuestionId = null;
        let nextQuestionId = 4;
        let visitorQuestionIndex = 0;
        let visitorAnswers = {};
        let isDirty = false;
        let previousFocusElement = null;

        const $ = function(id) {
            return document.getElementById(id);
        };

        const elements = {
            list: $("qnaQuestionList"),
            count: $("qnaQuestionCount"),
            overview: $("qnaOverview"),
            modal: $("qnaModalBackdrop"),
            modalTitle: $("qnaModalTitle"),
            form: $("qnaQuestionForm"),
            inputText: $("qnaInputText"),
            inputKey: $("qnaInputKey"),
            inputHelper: $("qnaInputHelper"),
            inputRequired: $("qnaInputRequired"),
            answerList: $("qnaAnswerEditorList"),
            modalError: $("qnaModalError"),
            draftStatus: $("qnaDraftStatus"),
            pageMessage: $("qnaPageMessage"),
            visitorQuestion: $("qnaVisitorQuestion"),
            visitorHelper: $("qnaVisitorHelper"),
            visitorOptions: $("qnaVisitorOptions"),
            visitorStep: $("qnaVisitorStep"),
            visitorPercent: $("qnaVisitorPercent"),
            visitorProgress: $("qnaVisitorProgress"),
            visitorBack: $("qnaVisitorBack"),
            visitorContinue: $("qnaVisitorContinue")
        };

        function escapeHtml(value) {
            return String(value == null ? "" : value)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#39;");
        }

        function getSelectedQuestion() {
            return questions.find(function(question) {
                return question.id === selectedQuestionId;
            }) || null;
        }

        function markDirty() {
            isDirty = true;
            elements.draftStatus.textContent = "Unsaved draft";
        }

        function showPageMessage(message) {
            elements.pageMessage.textContent = message;
            elements.pageMessage.classList.add("is-visible");

            window.setTimeout(function() {
                elements.pageMessage.classList.remove("is-visible");
            }, 4000);
        }

        function renderQuestionList() {
            elements.count.textContent = String(questions.length);

            if (questions.length === 0) {
                elements.list.innerHTML =
                    '<div class="qna-empty-list">' +
                    '<strong>No questions yet</strong><br>' +
                    'Click Add to create your first question.' +
                    '</div>';
                return;
            }

            elements.list.innerHTML = questions.map(function(question, index) {
                const selected = question.id === selectedQuestionId;

                return (
                    '<button type="button" class="qna-question-item' +
                    (selected ? ' is-selected' : '') +
                    '" data-question-id="' + question.id + '"' +
                    ' aria-pressed="' + selected + '">' +

                    '<span class="qna-question-number">' +
                    (index + 1) +
                    '</span>' +

                    '<span class="qna-question-copy">' +
                    '<span class="qna-question-text">' +
                    escapeHtml(question.text || "Untitled question") +
                    '</span>' +
                    '<span class="qna-question-key">' +
                    escapeHtml(question.key || "No identifier") +
                    '</span>' +
                    '</span>' +

                    '</button>'
                );
            }).join("");
        }

        function renderOverview() {
            const question = getSelectedQuestion();

            if (!question) {
                elements.overview.innerHTML =
                    '<div class="qna-overview-empty">' +
                    '<strong>No question selected</strong>' +
                    '<p>Add a question to start building your decision experience.</p>' +
                    '<button type="button" class="qna-btn qna-btn-primary" ' +
                    'id="qnaOverviewAddButton">+ Add Question</button>' +
                    '</div>';

                return;
            }

            const answers = question.answers || [];

            elements.overview.innerHTML =
                '<div class="qna-overview-heading">' +
                '<div class="qna-overview-heading-copy">' +
                '<h2 class="qna-panel-title">Question overview</h2>' +
                '<p class="qna-panel-subtitle">' +
                'View the selected question and its answer options. ' +
                'Click Edit to make changes.' +
                '</p>' +
                '</div>' +
                '<button type="button" class="qna-btn qna-btn-outline" ' +
                'id="qnaEditButton">✎ Edit Question</button>' +
                '</div>' +

                '<div class="qna-overview-fields">' +

                '<div class="qna-overview-field">' +
                '<span class="qna-overview-label">Question text</span>' +
                '<div class="qna-overview-value qna-value-box">' +
                escapeHtml(question.text || "—") +
                '</div>' +
                '</div>' +

                '<div class="qna-overview-field">' +
                '<span class="qna-overview-label">Question identifier</span>' +
                '<div class="qna-overview-value qna-value-box">' +
                escapeHtml(question.key || "—") +
                '</div>' +
                '</div>' +

                '<div class="qna-overview-field">' +
                '<span class="qna-overview-label">Helper text</span>' +
                '<div class="qna-overview-value qna-value-box">' +
                escapeHtml(question.helper || "No helper text") +
                '</div>' +
                '</div>' +

                '<div class="qna-overview-field">' +
                '<span class="qna-overview-label">Required question</span>' +
                '<div class="qna-overview-value">' +
                '<span class="qna-required-label">' +
                '<span class="qna-required-indicator">' +
                (question.required ? "✓" : "–") +
                '</span>' +
                (question.required ? "Yes" : "No") +
                '</span>' +
                '</div>' +
                '</div>' +

                '<div class="qna-overview-field">' +
                '<span class="qna-overview-label">Answer options (' +
                answers.length + ')</span>' +
                '<div class="qna-answer-list">' +
                (answers.length
                    ? answers.map(function(answer, index) {
                        return (
                            '<div class="qna-answer-preview">' +
                            '<span class="qna-answer-letter">' +
                            String.fromCharCode(65 + index) +
                            '</span>' +
                            '<span>' + escapeHtml(answer) + '</span>' +
                            '</div>'
                        );
                    }).join("")
                    : '<div class="qna-overview-value">No answer options configured.</div>'
                ) +
                '</div>' +
                '</div>' +

                '</div>';
        }

        function renderVisitorPreview() {
            const question = questions[visitorQuestionIndex];

            if (!question) {
                elements.visitorStep.textContent = "No questions";
                elements.visitorPercent.textContent = "0%";
                elements.visitorProgress.style.width = "0%";
                elements.visitorQuestion.textContent = "Your questions will appear here.";
                elements.visitorHelper.textContent = "";
                elements.visitorOptions.innerHTML = "";
                elements.visitorBack.disabled = true;
                elements.visitorContinue.disabled = true;
                return;
            }

            const total = questions.length;
            const percentage = Math.round(((visitorQuestionIndex + 1) / total) * 100);

            elements.visitorStep.textContent =
                "Question " + (visitorQuestionIndex + 1) + " of " + total;

            elements.visitorPercent.textContent = percentage + "%";
            elements.visitorProgress.style.width = percentage + "%";

            elements.visitorQuestion.textContent =
                question.text || "Untitled question";

            elements.visitorHelper.textContent =
                question.helper || "Choose the option that best matches your needs.";

            elements.visitorOptions.innerHTML = (question.answers || []).map(function(answer) {
                return (
                    '<div class="qna-visitor-option">' +
                    '<span class="qna-radio" aria-hidden="true"></span>' +
                    '<span>' + escapeHtml(answer) + '</span>' +
                    '</div>'
                );
            }).join("");

            elements.visitorBack.disabled = visitorQuestionIndex === 0;
            elements.visitorContinue.disabled = false;

            elements.visitorContinue.textContent =
                visitorQuestionIndex === total - 1 ? "Finish →" : "Continue →";
        }

        function renderAll() {
            renderQuestionList();
            renderOverview();
            renderVisitorPreview();
        }

        function showModalError(message) {
            elements.modalError.textContent = message;
            elements.modalError.classList.add("is-visible");
        }

        function clearModalError() {
            elements.modalError.textContent = "";
            elements.modalError.classList.remove("is-visible");
        }

        function renderAnswerEditor(answers) {
            const values = Array.isArray(answers) ? answers : [];

            if (values.length === 0) {
                elements.answerList.innerHTML =
                    '<div class="qna-answer-editor-empty">' +
                    'No answer options yet. Click Add option to create one.' +
                    '</div>';
                return;
            }

            elements.answerList.innerHTML = values.map(function(answer, index) {
                return (
                    '<div class="qna-answer-editor-row">' +
                    '<span class="qna-answer-order">' + (index + 1) + '</span>' +
                    '<input type="text" class="qna-answer-input" ' +
                    'maxlength="200" required ' +
                    'aria-label="Answer option ' + (index + 1) + '" ' +
                    'value="' + escapeHtml(answer) + '" ' +
                    'placeholder="Enter answer option">' +
                    '<button type="button" class="qna-answer-remove" ' +
                    'data-remove-answer="' + index + '" ' +
                    'aria-label="Remove answer option">×</button>' +
                    '</div>'
                );
            }).join("");
        }

        function readAnswerEditor() {
            return Array.from(
                elements.answerList.querySelectorAll(".qna-answer-input")
            ).map(function(input) {
                return input.value.trim();
            });
        }

        function openModal(questionId) {
            previousFocusElement = document.activeElement;
            clearModalError();

            const question = questionId == null
                ? null
                : questions.find(function(item) {
                    return item.id === questionId;
                });

            editingQuestionId = question ? question.id : null;

            elements.modalTitle.textContent =
                question ? "Edit Question" : "Add Question";

            elements.inputText.value = question ? question.text : "";
            elements.inputKey.value = question ? question.key : "";
            elements.inputHelper.value = question ? question.helper : "";
            elements.inputRequired.checked = question ? question.required : true;

            renderAnswerEditor(
                question
                    ? question.answers.slice()
                    : ["", ""]
            );

            elements.modal.classList.add("is-open");
            elements.modal.setAttribute("aria-hidden", "false");
            document.body.style.overflow = "hidden";

            window.setTimeout(function() {
                elements.inputText.focus();
            }, 50);
        }

        function closeModal() {
            elements.modal.classList.remove("is-open");
            elements.modal.setAttribute("aria-hidden", "true");
            document.body.style.overflow = "";

            clearModalError();

            if (previousFocusElement &&
                typeof previousFocusElement.focus === "function") {
                previousFocusElement.focus();
            }
        }

        function validateAndSaveQuestion(event) {
            event.preventDefault();
            clearModalError();

            const text = elements.inputText.value.trim();
            const key = elements.inputKey.value.trim();
            const helper = elements.inputHelper.value.trim();
            const required = elements.inputRequired.checked;
            const answers = readAnswerEditor();

            if (!text) {
                showModalError("Please enter the question text.");
                elements.inputText.focus();
                return;
            }

            if (!key || !/^[a-zA-Z][a-zA-Z0-9_]*$/.test(key)) {
                showModalError(
                    "Enter a valid identifier. Start with a letter and use only letters, numbers or underscores."
                );
                elements.inputKey.focus();
                return;
            }

            const duplicateKey = questions.some(function(question) {
                return question.key.toLowerCase() === key.toLowerCase() &&
                    question.id !== editingQuestionId;
            });

            if (duplicateKey) {
                showModalError(
                    "This identifier is already used by another question. Please choose a unique identifier."
                );
                elements.inputKey.focus();
                return;
            }

            if (answers.length < 2) {
                showModalError("Add at least two answer options.");
                return;
            }

            if (answers.some(function(answer) { return !answer; })) {
                showModalError("Please fill in every answer option or remove the empty ones.");
                return;
            }

            const normalizedAnswers = answers.map(function(answer) {
                return answer.toLowerCase();
            });

            if (new Set(normalizedAnswers).size !== normalizedAnswers.length) {
                showModalError("Answer options must be unique.");
                return;
            }

            const updatedQuestion = {
                id: editingQuestionId == null ? nextQuestionId++ : editingQuestionId,
                text: text,
                key: key,
                helper: helper,
                required: required,
                answers: answers
            };

            if (editingQuestionId == null) {
                questions.push(updatedQuestion);
            } else {
                const index = questions.findIndex(function(question) {
                    return question.id === editingQuestionId;
                });

                if (index >= 0) {
                    questions[index] = updatedQuestion;
                }
            }

            selectedQuestionId = updatedQuestion.id;
            visitorQuestionIndex = Math.max(
                0,
                questions.findIndex(function(question) {
                    return question.id === selectedQuestionId;
                })
            );

            visitorAnswers = {};
            markDirty();
            closeModal();
            renderAll();

            showPageMessage(
                editingQuestionId == null
                    ? "Question added to the current draft."
                    : "Question updated in the current draft."
            );
        }

        /* Page interactions */

        elements.list.addEventListener("click", function(event) {
            const button = event.target.closest("[data-question-id]");

            if (!button) return;

            selectedQuestionId = Number(button.getAttribute("data-question-id"));

            const index = questions.findIndex(function(question) {
                return question.id === selectedQuestionId;
            });

            if (index >= 0) {
                visitorQuestionIndex = index;
            }

            renderAll();
        });

        elements.overview.addEventListener("click", function(event) {
            if (event.target.closest("#qnaEditButton")) {
                if (selectedQuestionId != null) {
                    openModal(selectedQuestionId);
                }
            }

            if (event.target.closest("#qnaOverviewAddButton")) {
                openModal(null);
            }
        });

        $("qnaAddButton").addEventListener("click", function() {
            openModal(null);
        });

        $("qnaModalClose").addEventListener("click", closeModal);
        $("qnaCancelButton").addEventListener("click", closeModal);

        elements.modal.addEventListener("click", function(event) {
            if (event.target === elements.modal) {
                closeModal();
            }
        });

        document.addEventListener("keydown", function(event) {
            if (event.key === "Escape" &&
                elements.modal.classList.contains("is-open")) {
                closeModal();
            }
        });

        $("qnaAddOptionButton").addEventListener("click", function() {
            const answers = readAnswerEditor();

            if (answers.length >= 20) {
                showModalError("A question can have a maximum of 20 answer options in this prototype.");
                return;
            }

            clearModalError();
            answers.push("");
            renderAnswerEditor(answers);

            const inputs = elements.answerList.querySelectorAll(".qna-answer-input");
            if (inputs.length) {
                inputs[inputs.length - 1].focus();
            }
        });

        elements.answerList.addEventListener("click", function(event) {
            const button = event.target.closest("[data-remove-answer]");

            if (!button) return;

            const index = Number(button.getAttribute("data-remove-answer"));
            const answers = readAnswerEditor();

            answers.splice(index, 1);
            renderAnswerEditor(answers);
            clearModalError();
        });

        elements.form.addEventListener("submit", validateAndSaveQuestion);

        elements.visitorBack.addEventListener("click", function() {
            if (visitorQuestionIndex > 0) {
                visitorQuestionIndex--;
                renderVisitorPreview();
            }
        });

        elements.visitorContinue.addEventListener("click", function() {
            if (visitorQuestionIndex < questions.length - 1) {
                visitorQuestionIndex++;
                renderVisitorPreview();
            } else {
                showPageMessage("You reached the end of the visitor preview.");
            }
        });

        $("qnaPreviewButton").addEventListener("click", function() {
            const visitorColumn = document.querySelector(".qna-visitor-column");

            if (visitorColumn) {
                visitorColumn.scrollIntoView({
                    behavior: "smooth",
                    block: "start"
                });
            }
        });

        $("qnaSaveDraftButton").addEventListener("click", function() {
            /*
             * Prototype only:
             * This button does NOT call the database or API yet.
             * Connect it to your AskPearls API before production use.
             */
            isDirty = false;
            elements.draftStatus.textContent = "Local preview only";
            showPageMessage(
                "This prototype has no database connection yet. Your changes will be lost when the page reloads."
            );
        });

        /* Initial render */
        renderAll();

    })();
</script>
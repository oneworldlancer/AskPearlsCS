        flex: 0 0 auto;
    }

    /* Only the content area scrolls */
    #qnaModalBackdrop .qna-modal-body {
        flex: 1 1 auto;
        min-height: 0;
        height: auto;
        overflow-x: hidden;
        overflow-y: auto;
        overscroll-behavior: contain;
        -webkit-overflow-scrolling: touch;
    }

    /* Footer always remains visible */
    #qnaModalBackdrop .qna-modal-footer {
        display: flex;
        flex: 0 0 auto;
        align-items: center;
        justify-content: flex-end;

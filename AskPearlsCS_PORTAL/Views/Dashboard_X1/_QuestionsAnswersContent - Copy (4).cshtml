<style>
    /* =========================================================
           AskPearls DecisionOS - Questions & Answers
           All styles are scoped to .qna-page
           ========================================================= */

    .qna-page {
        --qna-bg: #f7faf9;
        --qna-card: #ffffff;
        --qna-text: #182b3b;
        --qna-muted: #687e90;
        --qna-border: #dce7e3;
        --qna-soft: #f5f9f7;
        --qna-selected: #e5f7f1;
        --qna-primary: #10a889;
        --qna-primary-hover: #078b72;
        --qna-danger: #ef476f;
        --qna-shadow: 0 5px 18px rgba(25, 55, 45, .055);
        color: var(--qna-text);
        background: transparent;
        font-size: 14px;
        line-height: 1.5;
        min-width: 0;
    }

        .qna-page *,
        .qna-modal *,
        .qna-modal-backdrop * {
            box-sizing: border-box;
        }

        .qna-page button,
        .qna-modal button {
            font-family: inherit;
        }

            .qna-page button:focus-visible,
            .qna-modal button:focus-visible,
            .qna-page input:focus-visible,
            .qna-modal input:focus-visible,
            .qna-modal textarea:focus-visible {
                outline: 3px solid rgba(16, 168, 137, .25);
                outline-offset: 2px;
            }

    /* Dark theme */

    body[data-bs-theme="dark"] .qna-page,
    body.dark-theme .qna-page,
    .dark-theme .qna-page,
    [data-theme="dark"] .qna-page {
        --qna-bg: #0b1715;
        --qna-card: #10231f;
        --qna-text: #eef8f4;
        --qna-muted: #a8beb7;
        --qna-border: #29443c;
        --qna-soft: #142b25;
        --qna-selected: #16483b;
        --qna-shadow: 0 5px 18px rgba(0, 0, 0, .15);
    }

    /* Page heading */

    .qna-page-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 18px;
        margin-bottom: 24px;
    }

    .qna-heading-left {
        min-width: 0;
        flex: 1 1 320px;
    }

    .qna-breadcrumb {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 9px;
        color: var(--qna-muted);
        margin-bottom: 10px;
        font-size: 13px;
    }

        .qna-breadcrumb a {
            color: var(--qna-primary);
            text-decoration: none;
        }

            .qna-breadcrumb a:hover {
                text-decoration: underline;
            }

    .qna-page-title {
        color: var(--qna-text);
        font-size: clamp(24px, 2vw, 30px);
        font-weight: 750;
        letter-spacing: -.6px;
        line-height: 1.25;
        margin: 0 0 8px;
    }

    .qna-page-description {
        color: var(--qna-muted);
        font-size: 14px;
        margin: 0;
        line-height: 1.7;
    }

    .qna-page-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        flex-wrap: wrap;
        gap: 10px;
    }

    .qna-draft-status {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 9px 13px;
        border: 1px solid var(--qna-border);
        border-radius: 24px;
        color: var(--qna-muted);
        background: var(--qna-card);
        font-size: 12px;
        white-space: nowrap;
    }

    .qna-status-dot {
        width: 7px;
        height: 7px;
        background: #f0a53a;
        border-radius: 50%;
    }

    .qna-btn {
        min-height: 40px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 9px 15px;
        border-radius: 7px;
        border: 1px solid transparent;
        font-size: 13px;
        font-weight: 650;
        line-height: 1.3;
        text-decoration: none;
        cursor: pointer;
        transition: background .18s ease, border-color .18s ease;
    }

    .qna-btn-primary {
        background: var(--qna-primary);
        border-color: var(--qna-primary);
        color: #ffffff !important;
    }

        .qna-btn-primary:hover {
            background: var(--qna-primary-hover);
            border-color: var(--qna-primary-hover);
            color: #ffffff !important;
        }

    .qna-btn-outline {
        background: var(--qna-card);
        border-color: var(--qna-border);
        color: var(--qna-text) !important;
    }

        .qna-btn-outline:hover {
            background: var(--qna-soft);
        }

    .qna-btn-danger {
        background: transparent;
        border-color: var(--qna-danger);
        color: var(--qna-danger) !important;
    }

        .qna-btn-danger:hover {
            background: rgba(239, 71, 111, .08);
        }

    .qna-btn:disabled {
        opacity: .5;
        cursor: not-allowed;
    }

    /* Widget information bar */

    .qna-widget-banner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 17px 20px;
        margin-bottom: 24px;
        border: 1px solid var(--qna-border);
        border-radius: 13px;
        background: var(--qna-card);
        box-shadow: var(--qna-shadow);
    }

    .qna-widget-identity {
        display: flex;
        align-items: center;
        gap: 14px;
        min-width: 0;
    }

    .qna-widget-icon {
        width: 46px;
        height: 46px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 46px;
        border-radius: 12px;
        background: var(--qna-primary);
        color: #ffffff;
        font-size: 23px;
        font-weight: 700;
    }

    .qna-widget-name {
        color: var(--qna-text);
        font-size: 16px;
        font-weight: 750;
        margin: 0 0 3px;
    }

    .qna-widget-subtitle {
        color: var(--qna-muted);
        font-size: 13px;
        margin: 0;
        overflow-wrap: anywhere;
    }

    .qna-widget-count {
        display: flex;
        align-items: center;
        gap: 9px;
        color: var(--qna-muted);
        white-space: nowrap;
        font-size: 13px;
    }

    .qna-count-badge {
        min-width: 25px;
        height: 25px;
        padding: 0 7px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 20px;
        background: var(--qna-soft);
        border: 1px solid var(--qna-border);
        color: var(--qna-text);
        font-weight: 700;
    }

    /* Main three-column workspace */

    .qna-workspace {
        display: grid;
        grid-template-columns: minmax(230px, .88fr) minmax(330px, 1.55fr) minmax(280px, 1.18fr);
        align-items: start;
        gap: 20px;
    }

    .qna-panel {
        min-width: 0;
        background: var(--qna-card);
        border: 1px solid var(--qna-border);
        border-radius: 13px;
        box-shadow: var(--qna-shadow);
        overflow: hidden;
    }

    .qna-panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 17px 16px;
        border-bottom: 1px solid var(--qna-border);
    }

    .qna-panel-title {
        color: var(--qna-text);
        font-size: 16px;
        font-weight: 750;
        line-height: 1.4;
        margin: 0;
    }

    .qna-panel-subtitle {
        color: var(--qna-muted);
        font-size: 12px;
        line-height: 1.65;
        margin: 8px 0 0;
    }

    /* Question list */

    .qna-question-list {
        padding: 10px;
    }

    .qna-question-item {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        width: 100%;
        padding: 12px 10px;
        margin-bottom: 7px;
        border: 1px solid transparent;
        border-radius: 9px;
        background: transparent;
        color: var(--qna-text);
        text-align: left;
        cursor: pointer;
        transition: background .18s ease, border-color .18s ease;
    }

        .qna-question-item:hover {
            background: var(--qna-soft);
            border-color: var(--qna-border);
        }

        .qna-question-item.is-selected {
            background: var(--qna-selected);
            border-color: rgba(16, 168, 137, .35);
        }

    .qna-question-number {
        width: 32px;
        height: 32px;
        flex: 0 0 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        border: 1px solid var(--qna-border);
        background: var(--qna-card);
        color: var(--qna-text);
        font-weight: 750;
        font-size: 13px;
    }

    .qna-question-item.is-selected .qna-question-number {
        background: var(--qna-primary);
        border-color: var(--qna-primary);
        color: #ffffff;
    }

    .qna-question-copy {
        min-width: 0;
        flex: 1;
    }

    .qna-question-text {
        display: block;
        color: var(--qna-text);
        font-size: 12px;
        line-height: 1.55;
        font-weight: 700;
        overflow-wrap: anywhere;
    }

    .qna-question-key {
        display: block;
        color: var(--qna-muted);
        font-size: 11px;
        margin-top: 4px;
    }

    .qna-question-hint {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 14px 16px;
        border-top: 1px solid var(--qna-border);
        color: var(--qna-muted);
        font-size: 12px;
        line-height: 1.6;
    }

    .qna-hint-icon {
        color: var(--qna-primary);
        font-size: 17px;
        line-height: 1.2;
    }

    .qna-empty-list {
        padding: 24px 12px;
        text-align: center;
        color: var(--qna-muted);
        font-size: 13px;
    }

    /* Question overview */

    .qna-overview {
        padding: 18px;
    }

    .qna-overview-heading {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 22px;
    }

    .qna-overview-heading-copy {
        min-width: 0;
    }

    .qna-overview-fields {
        display: grid;
        gap: 15px;
    }

    .qna-overview-field {
        min-width: 0;
    }

    .qna-overview-label {
        display: block;
        color: var(--qna-muted);
        font-size: 11px;
        font-weight: 750;
        text-transform: uppercase;
        letter-spacing: .55px;
        margin-bottom: 6px;
    }

    .qna-overview-value {
        color: var(--qna-text);
        font-size: 13px;
        overflow-wrap: anywhere;
        white-space: pre-wrap;
    }

    .qna-value-box {
        padding: 10px 12px;
        background: var(--qna-soft);
        border: 1px solid var(--qna-border);
        border-radius: 7px;
        min-height: 39px;
    }

    .qna-required-label {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: var(--qna-text);
    }

    .qna-required-indicator {
        width: 20px;
        height: 20px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: var(--qna-primary);
        color: white;
        font-size: 12px;
        font-weight: 750;
    }

    .qna-answer-list {
        display: grid;
        gap: 7px;
    }

    .qna-answer-preview {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 9px 11px;
        border: 1px solid var(--qna-border);
        background: var(--qna-card);
        color: var(--qna-text);
        border-radius: 7px;
        font-size: 12px;
        overflow-wrap: anywhere;
    }

    .qna-answer-letter {
        width: 24px;
        height: 24px;
        flex: 0 0 24px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: var(--qna-soft);
        color: var(--qna-primary);
        border: 1px solid var(--qna-border);
        font-size: 11px;
        font-weight: 750;
    }

    .qna-overview-empty {
        padding: 30px 12px;
        text-align: center;
        color: var(--qna-muted);
    }

        .qna-overview-empty strong {
            display: block;
            color: var(--qna-text);
            font-size: 15px;
            margin-bottom: 8px;
        }

        .qna-overview-empty p {
            margin: 0 0 16px;
            font-size: 13px;
            line-height: 1.7;
        }

    /* Visitor preview */

    .qna-visitor-column {
        min-width: 0;
    }

    .qna-visitor-heading {
        margin: 0 0 16px;
    }

    .qna-visitor-title {
        color: var(--qna-text);
        font-size: 17px;
        font-weight: 750;
        margin: 0 0 6px;
    }

    .qna-visitor-description {
        color: var(--qna-muted);
        font-size: 13px;
        line-height: 1.6;
        margin: 0;
    }

    .qna-visitor-stage {
        padding: 15px;
        border-radius: 13px;
        border: 1px dashed var(--qna-border);
        background: linear-gradient(145deg, #eaf6f2, #f8fbfa);
    }

    .qna-page body {
        color: var(--qna-text);
    }

    body[data-bs-theme="dark"] .qna-visitor-stage,
    body.dark-theme .qna-visitor-stage,
    .dark-theme .qna-visitor-stage,
    [data-theme="dark"] .qna-visitor-stage {
        background: linear-gradient(145deg, #17352d, #11251f);
    }

    .qna-visitor-card {
        padding: 20px;
        border: 1px solid #dfe9e5;
        border-radius: 15px;
        background: #ffffff;
        color: #243744;
        box-shadow: 0 5px 20px rgba(20, 55, 43, .05);
    }

    .qna-visitor-brand {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 24px;
        color: #243744;
        font-size: 13px;
        font-weight: 750;
    }

    .qna-visitor-brand-icon {
        width: 35px;
        height: 35px;
        flex: 0 0 35px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        background: #10a889;
        color: #ffffff;
        font-size: 18px;
    }

    .qna-progress-labels {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        color: #687e90;
        font-size: 12px;
        margin-bottom: 8px;
    }

    .qna-progress-track {
        width: 100%;
        height: 6px;
        border-radius: 10px;
        background: #e3ece8;
        overflow: hidden;
        margin-bottom: 23px;
    }

    .qna-progress-fill {
        height: 100%;
        width: 33.333%;
        border-radius: inherit;
        background: #10a889;
        transition: width .2s ease;
    }

    .qna-visitor-question {
        color: #243744;
        font-size: 21px;
        font-weight: 750;
        line-height: 1.4;
        margin: 0 0 12px;
        overflow-wrap: anywhere;
    }

    .qna-visitor-helper {
        color: #687e90;
        font-size: 12px;
        line-height: 1.7;
        margin: 0 0 20px;
        overflow-wrap: anywhere;
    }

    .qna-visitor-options {
        display: grid;
        gap: 8px;
        margin-bottom: 20px;
    }

    .qna-visitor-option {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px;
        min-height: 42px;
        border: 1px solid #dce7e3;
        border-radius: 8px;
        background: #ffffff;
        color: #334b59;
        font-size: 12px;
        line-height: 1.5;
        overflow-wrap: anywhere;
    }

    .qna-radio {
        width: 17px;
        height: 17px;
        flex: 0 0 17px;
        border: 1.5px solid #cbdad4;
        border-radius: 50%;
    }

    .qna-visitor-navigation {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        margin-top: 22px;
    }

        .qna-visitor-navigation button {
            min-width: 0;
            padding: 10px 12px;
            font-size: 12px;
            border-radius: 7px;
        }

    .qna-powered-by {
        color: var(--qna-muted);
        text-align: center;
        font-size: 11px;
        margin: 13px 0 0;
    }

    .qna-prototype-note {
        display: flex;
        gap: 10px;
        padding: 13px;
        margin-top: 14px;
        border: 1px solid var(--qna-border);
        border-radius: 9px;
        color: var(--qna-muted);
        font-size: 11px;
        line-height: 1.6;
        background: var(--qna-card);
    }

        .qna-prototype-note strong {
            display: block;
            color: var(--qna-text);
            margin-bottom: 3px;
            font-size: 12px;
        }

    /* Modal */

    .qna-modal-backdrop {
        position: fixed;
        inset: 0;
        z-index: 20000;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 22px;
        background: rgba(4, 17, 15, .66);
        backdrop-filter: blur(4px);
    }

        .qna-modal-backdrop.is-open {
            display: flex;
        }

    .qna-modal {
        display: flex;
        flex-direction: column;
        width: min(900px, 100%);
        max-height: min(88vh, 850px);
        background: var(--qna-card);
        color: var(--qna-text);
        border: 1px solid var(--qna-border);
        border-radius: 15px;
        box-shadow: 0 25px 80px rgba(0, 0, 0, .3);
        overflow: hidden;
        animation: qnaModalIn .18s ease-out;
    }

    @@keyframes qnaModalIn {
        from {
            opacity: 0;
            transform: translateY(8px) scale(.99);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .qna-modal-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 18px 22px;
        border-bottom: 1px solid var(--qna-border);
        flex: 0 0 auto;
    }

    .qna-modal-heading {
        display: flex;
        align-items: center;
        gap: 11px;
        min-width: 0;
    }

    .qna-modal-heading-icon {
        width: 36px;
        height: 36px;
        flex: 0 0 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--qna-primary);
        color: white;
        border-radius: 10px;
        font-size: 18px;
    }

    .qna-modal-title {
        color: var(--qna-text);
        font-size: 17px;
        font-weight: 750;
        margin: 0;
    }

    .qna-modal-subtitle {
        color: var(--qna-muted);
        font-size: 12px;
        margin: 3px 0 0;
    }

    .qna-modal-close {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 35px;
        height: 35px;
        flex: 0 0 35px;
        border: 1px solid var(--qna-border);
        border-radius: 8px;
        background: var(--qna-card);
        color: var(--qna-muted);
        font-size: 22px;
        cursor: pointer;
    }

        .qna-modal-close:hover {
            background: var(--qna-soft);
            color: var(--qna-text);
        }

    .qna-modal-body {
        padding: 22px;
        overflow-y: auto;
        overscroll-behavior: contain;
    }

    .qna-modal-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 24px;
    }

    .qna-modal-section {
        min-width: 0;
    }

    .qna-modal-section-title {
        color: var(--qna-text);
        font-size: 14px;
        font-weight: 750;
        margin: 0 0 5px;
    }

    .qna-modal-section-description {
        color: var(--qna-muted);
        font-size: 12px;
        line-height: 1.6;
        margin: 0 0 19px;
    }

    .qna-form-field {
        margin-bottom: 17px;
    }

    .qna-form-label {
        display: block;
        color: var(--qna-text);
        font-size: 12px;
        font-weight: 700;
        margin-bottom: 7px;
    }

    .qna-required-star {
        color: #e34b68;
    }

    .qna-form-control {
        display: block;
        width: 100%;
        min-height: 42px;
        padding: 10px 12px;
        border: 1px solid var(--qna-border);
        border-radius: 7px;
        background: var(--qna-card);
        color: var(--qna-text);
        font-size: 13px;
        line-height: 1.5;
        box-shadow: none;
    }

        .qna-form-control::placeholder {
            color: var(--qna-muted);
            opacity: .8;
        }

        .qna-form-control:focus {
            border-color: var(--qna-primary);
            outline: 0;
            box-shadow: 0 0 0 3px rgba(16, 168, 137, .12);
        }

    textarea.qna-form-control {
        min-height: 95px;
        resize: vertical;
    }

    .qna-field-help {
        display: block;
        color: var(--qna-muted);
        font-size: 11px;
        line-height: 1.6;
        margin-top: 6px;
    }

    .qna-required-setting {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 13px;
        border: 1px solid var(--qna-border);
        border-radius: 8px;
        background: var(--qna-soft);
    }

        .qna-required-setting strong {
            display: block;
            color: var(--qna-text);
            font-size: 12px;
            margin-bottom: 3px;
        }

        .qna-required-setting small {
            display: block;
            color: var(--qna-muted);
            font-size: 11px;
            line-height: 1.5;
        }

    .qna-switch {
        position: relative;
        display: inline-flex;
        flex: 0 0 42px;
        width: 42px;
        height: 24px;
    }

        .qna-switch input {
            position: absolute;
            opacity: 0;
            width: 1px;
            height: 1px;
        }

    .qna-switch-track {
        position: absolute;
        inset: 0;
        border-radius: 30px;
        background: #9baaa5;
        cursor: pointer;
        transition: background .2s ease;
    }

        .qna-switch-track::before {

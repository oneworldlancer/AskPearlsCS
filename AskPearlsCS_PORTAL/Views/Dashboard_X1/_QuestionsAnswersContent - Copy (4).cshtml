        display: flex;
        flex-direction: column;
        width: 100%;
        max-width: 960px;
        /* Never exceed the available viewport height */
        height: auto;
        max-height: calc(100dvh - 32px);
        min-height: 0;
        margin: 0;
        box-sizing: border-box;
        overflow: hidden;
    }

    /* Form fills the modal and becomes a flex column */
    #qnaModalBackdrop #qnaQuestionForm {
        display: flex;
        flex-direction: column;
        flex: 1 1 auto;
        min-height: 0;
        height: auto;
        overflow: hidden;

                }

                html[data-theme="dark"] .decision-rules-page .dr-status-box p,
                body[data-theme="dark"] .decision-rules-page .dr-status-box p,
                html[data-bs-theme="dark"] .decision-rules-page .dr-status-box p,
                body[data-bs-theme="dark"] .decision-rules-page .dr-status-box p {
                    color: #aab8c8 !important;
                }

            /* Cancel button and close icon */
            html[data-theme="dark"] .decision-rules-page .dr-modal .dr-btn:not(.dr-btn-primary),
            body[data-theme="dark"] .decision-rules-page .dr-modal .dr-btn:not(.dr-btn-primary),
            html[data-bs-theme="dark"] .decision-rules-page .dr-modal .dr-btn:not(.dr-btn-primary),
            body[data-bs-theme="dark"] .decision-rules-page .dr-modal .dr-btn:not(.dr-btn-primary) {
                background-color: #10221c !important;
                color: #e6edf5 !important;
                border-color: #344d44 !important;
            }

            html[data-theme="dark"] .decision-rules-page .dr-modal-close,
            body[data-theme="dark"] .decision-rules-page .dr-modal-close,
            html[data-bs-theme="dark"] .decision-rules-page .dr-modal-close,
            body[data-bs-theme="dark"] .decision-rules-page .dr-modal-close {
                color: #c5d2dc !important;
            }


    </style>

    <div class="dr-header">
        <div>
            <h2>Decision Rules</h2>
            <p>Define how visitor answers determine the recommendations your widgets display.</p>
        </div>
        <button type="button" class="dr-btn dr-btn-primary" data-dr-action="add">
            <span aria-hidden="true">＋</span> Create Rule
        </button>
    </div>

    <div class="dr-stats">
        <div class="dr-stat">
            <div class="dr-stat-icon dr-purple">◇</div>
            <div>
                <div class="dr-stat-label">Total Rules</div>
                <div class="dr-stat-value" data-dr-stat="total">0</div>
            </div>
        </div>
        <div class="dr-stat">
            <div class="dr-stat-icon dr-green">✓</div>
            <div>
                <div class="dr-stat-label">Active Rules</div>
                <div class="dr-stat-value" data-dr-stat="active">0</div>
            </div>
        </div>
        <div class="dr-stat">
            <div class="dr-stat-icon dr-blue">⚙</div>
            <div>
                <div class="dr-stat-label">Draft Rules</div>
                <div class="dr-stat-value" data-dr-stat="draft">0</div>
            </div>
        </div>
        <div class="dr-stat">
            <div class="dr-stat-icon dr-orange">↗</div>
            <div>
                <div class="dr-stat-label">Recommendations Covered</div>
                <div class="dr-stat-value" data-dr-stat="covered">0</div>
            </div>
        </div>
    </div>

    <section class="dr-panel">
        <div class="dr-panel-header">
            <h3>Rules Inventory</h3>
            <p>Create and manage the conditions that control your recommendation outcomes.</p>
        </div>

        <div class="dr-toolbar">
            <div class="dr-search">
                <span aria-hidden="true">⌕</span>
                <input type="search" class="dr-input" data-dr-search
                       placeholder="Search by rule name or identifier..."
                       aria-label="Search decision rules">
            </div>
            <select class="dr-select" data-dr-filter aria-label="Filter by status">
                <option value="all">All statuses</option>
                <option value="active">Active</option>
                <option value="draft">Draft</option>
                <option value="inactive">Inactive</option>
            </select>
        </div>

        <div class="dr-table-wrap">
            <table class="dr-table">
                <thead>
                    <tr>
                        <th>Rule</th>
                        <th>Conditions</th>
                        <th>Recommendation</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th style="text-align:right;">Actions</th>
                    </tr>
                </thead>
                <tbody data-dr-rows></tbody>
            </table>
        </div>

        <div class="dr-empty" data-dr-empty hidden>
            <strong>No decision rules found</strong>
            Try another search or create your first rule.
        </div>

        <div class="dr-table-footer" data-dr-count>Showing 0 rules</div>
    </section>

    <!-- Create/Edit modal -->
    <div class="dr-modal-overlay" data-dr-modal aria-hidden="true">
        <section class="dr-modal" role="dialog" aria-modal="true"
                 aria-labelledby="dr-modal-title">
            <div class="dr-modal-header">
                <div class="dr-modal-icon">⚙</div>
                <div>
                    <h3 data-dr-modal-title id="dr-modal-title">Create Decision Rule</h3>
                    <p>Configure the rule details. Conditions can be configured in the next UI step.</p>
                </div>
                <button type="button" class="dr-modal-close" data-dr-action="close"
                        aria-label="Close modal">
                    &times;
                </button>
            </div>

            <form data-dr-form>
                <div class="dr-modal-body">
                    <div class="dr-validation" data-dr-validation role="alert"></div>

                    <div class="dr-field">
                        <label for="dr-name">Rule name <span class="dr-required">*</span></label>
                        <input id="dr-name" name="name" class="dr-input" required
                               maxlength="100" placeholder="e.g. Small Space — Sofa Finder">
                    </div>

                    <div class="dr-field">
                        <label for="dr-key">Unique identifier <span class="dr-required">*</span></label>
                        <input id="dr-key" name="key" class="dr-input" required
                               maxlength="80" pattern="[a-z][a-z0-9_]*"
                               placeholder="e.g. small_space_sofa">
                        <div class="dr-help">Use lowercase letters, numbers and underscores. Start with a letter.</div>
                    </div>

                    <div class="dr-field">
                        <label for="dr-description">Description</label>
                        <textarea id="dr-description" name="description" class="dr-textarea"
                                  rows="3" maxlength="500"
                                  placeholder="Explain when this rule should apply."></textarea>
                    </div>

                    <div class="dr-field">
                        <label for="dr-recommendation">Recommendation item <span class="dr-required">*</span></label>
                        <select id="dr-recommendation" name="recommendation" class="dr-select"
                                style="width:100%;" required>
                            <option value="">Select a recommendation</option>
                            <option value="Oslo Sofa">Oslo Sofa</option>
                            <option value="Luna Sofa">Luna Sofa</option>
                            <option value="Haven Sofa">Haven Sofa</option>
                        </select>
                        <div class="dr-help">These are sample items for the UI prototype.</div>
                    </div>

                    <div class="dr-field">
                        <label for="dr-priority">Priority</label>
                        <input id="dr-priority" name="priority" class="dr-input"
                               type="number" min="1" max="999" value="1" required>
                        <div class="dr-help">Lower numbers indicate higher priority.</div>
                    </div>

                    <div class="dr-field">
                        <label>Status</label>
                        <div class="dr-status-box">
                            <div>
                                <strong>Active rule</strong>
                                <p>Allow this rule to be considered by the decision engine.</p>
                            </div>
                            <label class="dr-toggle" aria-label="Active rule">
                                <input type="checkbox" name="active" checked>
                                <span></span>
                            </label>
                        </div>
                    </div>
                </div>

                <div class="dr-modal-footer">
                    <button type="button" class="dr-btn" data-dr-action="close">Cancel</button>
                    <button type="submit" class="dr-btn dr-btn-primary">
                        ✓ <span data-dr-save-label>Save Rule</span>
                    </button>
                </div>
            </form>
        </section>
    </div>

    <!-- Delete confirmation -->
    <div class="dr-modal-overlay" data-dr-delete-modal aria-hidden="true">
        <section class="dr-modal" role="dialog" aria-modal="true"
                 aria-labelledby="dr-delete-title" style="max-width:440px;">
            <div class="dr-modal-header">
                <div class="dr-modal-icon" style="background:#ffebee;color:#c62828;">!</div>
                <div>
                    <h3 id="dr-delete-title">Delete Decision Rule?</h3>
                    <p>This action removes the rule from the local demo.</p>
                </div>
                <button type="button" class="dr-modal-close" data-dr-action="cancel-delete"
                        aria-label="Close confirmation">
                    &times;
                </button>
            </div>
            <div class="dr-modal-body">
                <p style="margin:0;color:var(--ap-text,#172033);font-size:13px;"
                   data-dr-delete-message></p>
            </div>
            <div class="dr-modal-footer">
                <button type="button" class="dr-btn" data-dr-action="cancel-delete">Cancel</button>
                <button type="button" class="dr-btn dr-btn-danger" data-dr-action="confirm-delete">
                    Delete Rule
                </button>
            </div>
        </section>
    </div>

    <div class="dr-toast" data-dr-toast role="status" aria-live="polite"></div>
</div>

<script>
    (function() {
        const root = document.querySelector(".decision-rules-page");
        if (!root || root.dataset.drInitialized === "true") return;
        root.dataset.drInitialized = "true";

        let nextId = 4;
        let editingId = null;
        let deletingId = null;
        let toastTimer = null;

        let rules = [
            {
                id: 1,
                name: "Small Space — Sofa Finder",
                key: "small_space_sofa",
                description: "Recommend a compact sofa for smaller living spaces.",
                recommendation: "Oslo Sofa",
                conditions: 2,
                priority: 1,
                status: "active"
            },
            {
                id: 2,
                name: "Premium Comfort",
                key: "premium_comfort",
                description: "Recommend a comfort-focused option.",
                recommendation: "Luna Sofa",
                conditions: 3,
                priority: 2,
                status: "active"
            },
            {
                id: 3,
                name: "Large Living Room",
                key: "large_living_room",
                description: "Recommend an option suitable for larger living areas.",
                recommendation: "Haven Sofa",
                conditions: 1,
                priority: 3,
                status: "draft"
            }
        ];

        const $ = (selector) => root.querySelector(selector);

        function escapeHtml(value) {
            return String(value ?? "").replace(/[&<>"']/g, function(char) {
                return {
                    "&": "&amp;",
                    "<": "&lt;",
                    ">": "&gt;",
                    '"': "&quot;",
                    "'": "&#39;"
                }[char];
            });
        }

        function showToast(message) {
            const toast = $("[data-dr-toast]");
            toast.textContent = message;
            toast.classList.add("is-visible");

            clearTimeout(toastTimer);
            toastTimer = setTimeout(function() {
                toast.classList.remove("is-visible");
            }, 2600);
        }

        function openModal(modal) {
            modal.classList.add("is-open");
            modal.setAttribute("aria-hidden", "false");
            document.body.style.overflow = "hidden";
        }

        function closeModal(modal) {
            modal.classList.remove("is-open");
            modal.setAttribute("aria-hidden", "true");

            if (!root.querySelector(".dr-modal-overlay.is-open")) {
                document.body.style.overflow = "";
            }
        }

        function updateStats() {
            $("[data-dr-stat='total']").textContent = rules.length;
            $("[data-dr-stat='active']").textContent =
                rules.filter(rule => rule.status === "active").length;
            $("[data-dr-stat='draft']").textContent =
                rules.filter(rule => rule.status === "draft").length;

            const covered = new Set(
                rules.filter(rule => rule.status === "active")
                    .map(rule => rule.recommendation)
                    .filter(Boolean)
            );

            $("[data-dr-stat='covered']").textContent = covered.size;
        }

        function statusMarkup(status) {
            const labels = {
                active: "Active",
                draft: "Draft",
                inactive: "Inactive"
            };

            return '<span class="dr-status dr-status-' + status + '">' +
                labels[status] + '</span>';
        }

        function renderRows() {
            const search = $("[data-dr-search]").value.trim().toLowerCase();
            const filter = $("[data-dr-filter]").value;

            const filtered = rules
                .filter(rule => {
                    const matchesSearch =
                        rule.name.toLowerCase().includes(search) ||
                        rule.key.toLowerCase().includes(search) ||
                        rule.recommendation.toLowerCase().includes(search);

                    return matchesSearch && (filter === "all" || rule.status === filter);
                })
                .sort((a, b) => a.priority - b.priority);

            const tbody = $("[data-dr-rows]");

            tbody.innerHTML = filtered.map(rule => {
                const toggleLabel = rule.status === "active" ? "Deactivate" : "Activate";

                return `
                    <tr>
                        <td>
                            <div class="dr-rule-name">${escapeHtml(rule.name)}</div>
                            <div class="dr-rule-id">${escapeHtml(rule.key)}</div>
                        </td>
                        <td>${rule.conditions} condition${rule.conditions === 1 ? "" : "s"}</td>
                        <td>${escapeHtml(rule.recommendation)}</td>
                        <td>${rule.priority}</td>
                        <td>${statusMarkup(rule.status)}</td>
                        <td>
                            <div class="dr-actions">
                                <button type="button" class="dr-btn"
                                    data-dr-action="edit" data-id="${rule.id}">Edit</button>
                                <button type="button" class="dr-btn"
                                    data-dr-action="duplicate" data-id="${rule.id}">Duplicate</button>
                                <button type="button" class="dr-btn"
                                    data-dr-action="toggle" data-id="${rule.id}">${toggleLabel}</button>
                                <button type="button" class="dr-btn dr-btn-danger"
                                    data-dr-action="delete" data-id="${rule.id}">Delete</button>
                            </div>
                        </td>
                    </tr>`;
            }).join("");

            $("[data-dr-empty]").hidden = filtered.length > 0;
            $("[data-dr-count]").textContent =
                `Showing ${filtered.length} of ${rules.length} rule${rules.length === 1 ? "" : "s"}`;

            updateStats();
        }

        function resetForm() {
            const form = $("[data-dr-form]");
            form.reset();
            $("[data-dr-validation]").classList.remove("is-visible");
        }

        function openCreate() {
            editingId = null;
            resetForm();

            $("[data-dr-modal-title]").textContent = "Create Decision Rule";
            $("[data-dr-save-label]").textContent = "Save Rule";
            $("#dr-priority").value = "1";
            $("#dr-name").focus();

            openModal($("[data-dr-modal]"));
        }

        function openEdit(id) {
            const rule = rules.find(item => item.id === id);
            if (!rule) return;

            editingId = id;
            resetForm();

            $("#dr-name").value = rule.name;
            $("#dr-key").value = rule.key;
            $("#dr-description").value = rule.description;
            $("#dr-recommendation").value = rule.recommendation;
            $("#dr-priority").value = rule.priority;
            $("[name='active']").checked = rule.status === "active";

            $("[data-dr-modal-title]").textContent = "Edit Decision Rule";
            $("[data-dr-save-label]").textContent = "Save Changes";

            openModal($("[data-dr-modal]"));
            $("#dr-name").focus();
        }

        function makeUniqueKey(baseKey) {
            let key = baseKey;
            let suffix = 2;

            while (rules.some(rule => rule.key === key)) {
                key = baseKey + "_" + suffix++;
            }

            return key;
        }

        function handleSave(event) {
            event.preventDefault();

            const form = $("[data-dr-form]");
            const validation = $("[data-dr-validation]");

            if (!form.reportValidity()) return;

            const name = $("#dr-name").value.trim();
            const key = $("#dr-key").value.trim();
            const description = $("#dr-description").value.trim();
            const recommendation = $("#dr-recommendation").value;
            const priority = Number($("#dr-priority").value);
            const active = $("[name='active']").checked;

            if (!name || !key || !recommendation || !Number.isInteger(priority) ||
                priority < 1 || priority > 999) {
                validation.textContent = "Please complete the required fields correctly.";
                validation.classList.add("is-visible");
                return;
            }

            const duplicateKey = rules.some(rule =>
                rule.key.toLowerCase() === key.toLowerCase() &&
                rule.id !== editingId
            );

            if (duplicateKey) {
                validation.textContent = "This unique identifier is already in use.";
                validation.classList.add("is-visible");
                $("#dr-key").focus();
                return;
            }

            const existing = editingId
                ? rules.find(rule => rule.id === editingId)
                : null;

            const record = {
                id: editingId ?? nextId++,
                name,
                key,
                description,
                recommendation,
                conditions: existing ? existing.conditions : 0,
                priority,
                status: active ? "active" : "draft"
            };

            if (editingId) {
                rules = rules.map(rule => rule.id === editingId ? record : rule);
            } else {
                rules.push(record);
            }

            closeModal($("[data-dr-modal]"));
            renderRows();
            showToast(editingId ? "Rule updated in the demo." : "Rule created in the demo.");
        }

        function duplicateRule(id) {
            const source = rules.find(rule => rule.id === id);
            if (!source) return;

            const copy = {
                ...source,
                id: nextId++,
                name: source.name + " (Copy)",
                key: makeUniqueKey(source.key + "_copy"),
                status: "draft",
                priority: Math.max(1, ...rules.map(rule => rule.priority)) + 1
            };

            rules.push(copy);
            renderRows();
            showToast("Rule duplicated as a draft.");
        }

        function toggleRule(id) {
            const rule = rules.find(item => item.id === id);
            if (!rule) return;

            rule.status = rule.status === "active" ? "inactive" : "active";
            renderRows();
            showToast(rule.status === "active" ? "Rule activated." : "Rule deactivated.");
        }

        function askDelete(id) {
            const rule = rules.find(item => item.id === id);
            if (!rule) return;

            deletingId = id;
            $("[data-dr-delete-message]").textContent =
                `Delete "${rule.name}"? This cannot be undone in this demo.`;

            openModal($("[data-dr-delete-modal]"));
        }

        function confirmDelete() {
            if (deletingId === null) return;

            rules = rules.filter(rule => rule.id !== deletingId);
            deletingId = null;

            closeModal($("[data-dr-delete-modal]"));
            renderRows();
            showToast("Rule deleted from the demo.");
        }

        root.addEventListener("click", function(event) {
            const button = event.target.closest("[data-dr-action]");
            if (!button || !root.contains(button)) return;

            const action = button.dataset.drAction;
            const id = Number(button.dataset.id);

            switch (action) {
                case "add":
                    openCreate();
                    break;
                case "edit":
                    openEdit(id);
                    break;
                case "duplicate":
                    duplicateRule(id);
                    break;
                case "toggle":
                    toggleRule(id);
                    break;
                case "delete":
                    askDelete(id);
                    break;
                case "close":
                    closeModal($("[data-dr-modal]"));
                    break;
                case "cancel-delete":
                    closeModal($("[data-dr-delete-modal]"));
                    deletingId = null;
                    break;
                case "confirm-delete":
                    confirmDelete();
                    break;
            }
        });

        $("[data-dr-form]").addEventListener("submit", handleSave);
        $("[data-dr-search]").addEventListener("input", renderRows);
        $("[data-dr-filter]").addEventListener("change", renderRows);

        root.querySelectorAll(".dr-modal-overlay").forEach(modal => {
            modal.addEventListener("click", function(event) {
                if (event.target === modal) {
                    closeModal(modal);
                    if (modal === $("[data-dr-delete-modal]")) deletingId = null;
                }
            });
        });

        document.addEventListener("keydown", function(event) {
            if (event.key === "Escape") {
                root.querySelectorAll(".dr-modal-overlay.is-open").forEach(closeModal);
                deletingId = null;
            }
        });

        renderRows();
    })();
</script>

            /* =========================================
   Decision Rules — Condition Builder
   ========================================= */

.decision-rules-page .dr-condition-builder {
    margin: 24px 0;
    padding: 20px;
    border: 1px solid var(--ap-border, #dce3e8);
    border-radius: 14px;
    background: var(--ap-input-bg, rgba(148, 163, 184, .04));
}

.decision-rules-page .dr-condition-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 18px;
}

.decision-rules-page .dr-condition-heading h4 {
    margin: 0 0 6px;
    color: var(--ap-text, #172033);
    font-size: 16px;
    font-weight: 700;
}

.decision-rules-page .dr-condition-heading p {
    margin: 0;
    color: var(--ap-muted, #64748b);
    font-size: 12px;
    line-height: 1.6;
}

.decision-rules-page .dr-condition-count {
    flex-shrink: 0;
    padding: 6px 10px;
    border-radius: 20px;
    background: rgba(12, 168, 140, .12);
    color: #0b997e;
    font-size: 11px;
    font-weight: 700;
}

.decision-rules-page .dr-logic-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px;
    border: 1px solid var(--ap-border, #dce3e8);
    border-radius: 10px;
    background: var(--ap-card-bg, #fff);
}

.decision-rules-page .dr-logic-copy {
    display: flex;
    flex-direction: column;
    gap: 5px;
}

.decision-rules-page .dr-logic-copy strong {
    color: var(--ap-text, #172033);
    font-size: 12px;
}

.decision-rules-page .dr-logic-copy span {
    color: var(--ap-muted, #64748b);
    font-size: 11px;
    line-height: 1.5;
}

.decision-rules-page .dr-logic-toggle {
    display: inline-flex;
    flex-shrink: 0;
    gap: 3px;
    padding: 4px;
    border: 1px solid var(--ap-border, #dce3e8);
    border-radius: 9px;
    background: var(--ap-input-bg, #f4f7f9);
}

.decision-rules-page .dr-logic-option {
    min-width: 58px;
    padding: 8px 12px;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: var(--ap-muted, #64748b);
    font: inherit;
    font-size: 11px;
    font-weight: 800;
    cursor: pointer;
    transition: background .15s ease, color .15s ease;
}

.decision-rules-page .dr-logic-option.is-selected {
    background: #0ca88c;
    color: #fff;
    box-shadow: 0 2px 5px rgba(12, 168, 140, .2);
}

.decision-rules-page .dr-logic-option:focus-visible {
    outline: 2px solid #0ca88c;
    outline-offset: 2px;
}

.decision-rules-page .dr-logic-explanation {
    margin: 10px 0 16px;
    color: var(--ap-muted, #64748b);
    font-size: 11px;
    line-height: 1.6;
}

.decision-rules-page .dr-condition-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.decision-rules-page .dr-condition-card {
    position: relative;
    padding: 16px;
    border: 1px solid var(--ap-border, #dce3e8);
    border-radius: 11px;
    background: var(--ap-card-bg, #fff);
}

.decision-rules-page .dr-condition-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 14px;
}

.decision-rules-page .dr-condition-card-title {
    display: flex;
    align-items: center;
    gap: 9px;
    color: var(--ap-text, #172033);
    font-size: 12px;
    font-weight: 700;
}

.decision-rules-page .dr-condition-number {
    display: grid;
    place-items: center;
    width: 27px;
    height: 27px;
    flex-shrink: 0;
    border-radius: 8px;
    background: rgba(12, 168, 140, .12);
    color: #0b997e;
    font-size: 11px;
    font-weight: 800;
}

.decision-rules-page .dr-condition-remove {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    padding: 6px 8px;
    border: 1px solid transparent;
    border-radius: 7px;
    background: transparent;
    color: #dc3545;
    font: inherit;
    font-size: 11px;
    font-weight: 600;
    cursor: pointer;
}

.decision-rules-page .dr-condition-remove:hover {
    background: rgba(220, 53, 69, .08);
    border-color: rgba(220, 53, 69, .2);
}

.decision-rules-page .dr-condition-fields {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 14px;
}

.decision-rules-page .dr-condition-field {
    min-width: 0;
}

.decision-rules-page .dr-condition-field label {
    display: block;
    margin-bottom: 7px;
    color: var(--ap-muted, #64748b);
    font-size: 11px;
    font-weight: 700;
}

.decision-rules-page .dr-condition-field .dr-select {
    width: 100%;
    min-width: 0;
}

.decision-rules-page .dr-condition-field-full {
    grid-column: 1 / -1;
}

.decision-rules-page .dr-condition-connector {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    margin: 0;
    color: var(--ap-muted, #64748b);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .08em;
}

.decision-rules-page .dr-condition-connector::before,
.decision-rules-page .dr-condition-connector::after {
    content: "";
    height: 1px;
    flex: 1;
    background: var(--ap-border, #dce3e8);
}

.decision-rules-page .dr-add-condition {
    width: 100%;
    margin-top: 14px;
    border-style: dashed;
    border-color: rgba(12, 168, 140, .55);
    background: rgba(12, 168, 140, .05);
    color: #0b997e;
}

.decision-rules-page .dr-add-condition:hover {
    background: rgba(12, 168, 140, .12);
}

.decision-rules-page .dr-rule-summary {
    display: flex;
    align-items: flex-start;
    gap: 11px;
    margin-top: 18px;
    padding: 14px;
    border: 1px solid rgba(12, 168, 140, .25);
    border-radius: 10px;
    background: rgba(12, 168, 140, .07);
}

.decision-rules-page .dr-summary-icon {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    flex-shrink: 0;
    border-radius: 8px;
    background: rgba(12, 168, 140, .15);
    color: #0b997e;
    font-size: 15px;
}

.decision-rules-page .dr-rule-summary strong {
    display: block;
    margin-bottom: 5px;
    color: var(--ap-text, #172033);
    font-size: 12px;
}

.decision-rules-page .dr-rule-summary p {
    margin: 0;
    color: var(--ap-muted, #64748b);
    font-size: 11px;
    line-height: 1.7;
    overflow-wrap: anywhere;
}

.decision-rules-page .dr-rule-summary p strong {
    display: inline;
    color: var(--ap-text, #172033);
    font-size: inherit;
}

.decision-rules-page .dr-condition-error {
    display: none;
    margin-top: 10px;
    color: #dc3545;
    font-size: 11px;
}

.decision-rules-page .dr-condition-error.is-visible {
    display: block;
}

.decision-rules-page .dr-condition-card.has-error {
    border-color: #dc3545;
}

/* Dark theme */
html[data-theme="dark"] .decision-rules-page .dr-condition-builder,
body[data-theme="dark"] .decision-rules-page .dr-condition-builder,
html[data-bs-theme="dark"] .decision-rules-page .dr-condition-builder,
body[data-bs-theme="dark"] .decision-rules-page .dr-condition-builder {

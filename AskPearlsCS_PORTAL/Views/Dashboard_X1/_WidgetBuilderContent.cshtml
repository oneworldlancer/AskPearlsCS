
<div class="page-widget-builder container-fluid py-4">

    <!-- Page heading -->
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-2">
                <a href="#" class="text-decoration-none small"
                   data-page="widgets">
                    <i class="bi bi-arrow-left me-1"></i> My Widgets
                </a>
                <span class="text-muted">/</span>
                <span class="text-muted small">Widget Builder</span>
            </div>

            <h1 class="h3 fw-bold mb-1">Widget Builder</h1>
            <p class="text-muted mb-0">
                Create and customize your DecisionOS experience.
            </p>
        </div>

        <div class="d-flex align-items-center gap-2">
            <span class="badge rounded-pill border text-secondary px-3 py-2">
                <i class="bi bi-circle-fill me-1"
                   style="font-size:7px"></i>
                Unsaved draft
            </span>

            <button type="button"
                    class="btn btn-outline-secondary"
                    id="wbPreviewButton">
                <i class="bi bi-eye me-1"></i> Preview
            </button>

            <button type="button"
                    class="btn btn-primary"
                    id="wbSaveButton">
                <i class="bi bi-save me-1"></i> Save Draft
            </button>
        </div>
    </div>

    <!-- Builder steps -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <div class="wb-steps">

                <button type="button"
                        class="wb-step active"
                        data-wb-tab="basics">
                    <span class="wb-step-number">1</span>
                    <span>
                        <strong>Basics</strong>
                        <small>Identity and content</small>
                    </span>
                </button>

                <button type="button"
                        class="wb-step"
                        data-wb-tab="appearance">
                    <span class="wb-step-number">2</span>
                    <span>
                        <strong>Appearance</strong>
                        <small>Colors and styling</small>
                    </span>
                </button>

                <button type="button"
                        class="wb-step"
                        data-wb-tab="behavior">
                    <span class="wb-step-number">3</span>
                    <span>
                        <strong>Behavior</strong>
                        <small>Display preferences</small>
                    </span>
                </button>

            </div>
        </div>
    </div>

    <div class="row g-4">

        <!-- Configuration -->
        <div class="col-12 col-xl-7">

            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">

                    <!-- BASICS -->
                    <div class="wb-panel active" data-wb-panel="basics">

                        <h2 class="h5 fw-bold mb-1">Widget basics</h2>
                        <p class="text-muted small mb-4">
                            Define the identity and content visitors will see.
                        </p>

                        <div class="mb-3">
                            <label for="wbWidgetName"
                                   class="form-label fw-semibold">
                                Internal widget name
                                <span class="text-danger">*</span>
                            </label>

                            <input id="wbWidgetName"
                                   type="text"
                                   class="form-control"
                                   value="Sofa Finder"
                                   maxlength="100"
                                   placeholder="e.g. Sofa Finder">

                            <div class="form-text">
                                Used to identify this widget in your portal.
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="wbWidgetType"
                                   class="form-label fw-semibold">
                                Widget type
                            </label>

                            <select id="wbWidgetType" class="form-select">
                                <option value="decision" selected>
                                    DecisionOS — Decision Assistant
                                </option>
                            </select>

                            <div class="form-text">
                                Additional agent types can be enabled later.
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="wbWebsite"
                                   class="form-label fw-semibold">
                                Target website
                                <span class="text-danger">*</span>
                            </label>

                            <select id="wbWebsite" class="form-select">
                                <option value="demo" selected>
                                    Demo Website
                                </option>
                                <option value="new">
                                    + Add website (coming later)
                                </option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="wbWidgetTitle"
                                   class="form-label fw-semibold">
                                Visitor-facing title
                                <span class="text-danger">*</span>
                            </label>

                            <input id="wbWidgetTitle"
                                   type="text"
                                   class="form-control"
                                   value="Find Your Perfect Sofa"
                                   maxlength="120"
                                   placeholder="Give your widget a title">
                        </div>

                        <div class="mb-3">
                            <label for="wbWidgetDescription"
                                   class="form-label fw-semibold">
                                Description
                            </label>

                            <textarea id="wbWidgetDescription"
                                      class="form-control"
                                      rows="3"
                                      maxlength="500"
                                      placeholder="Explain how this assistant helps visitors.">Answer a few simple questions and discover the sofa that suits your needs.</textarea>
                        </div>

                        <div class="alert alert-info d-flex gap-2 small mb-0">
                            <i class="bi bi-info-circle fs-5"></i>
                            <div>
                                Questions, answers, recommendation items,
                                and scoring rules will be configured in the
                                following builder stages.
                            </div>
                        </div>

                    </div>

                    <!-- APPEARANCE -->
                    <div class="wb-panel" data-wb-panel="appearance">

                        <h2 class="h5 fw-bold mb-1">Appearance</h2>
                        <p class="text-muted small mb-4">
                            Customize the visitor-facing experience.
                        </p>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">
                                Color theme
                            </label>

                            <div class="d-flex flex-wrap gap-2">
                                <label class="wb-theme-option">
                                    <input type="radio"
                                           name="wbTheme"
                                           value="light"
                                           checked>
                                    <span>
                                        <i class="bi bi-sun me-1"></i>
                                        Light
                                    </span>
                                </label>

                                <label class="wb-theme-option">
                                    <input type="radio"
                                           name="wbTheme"
                                           value="dark">
                                    <span>
                                        <i class="bi bi-moon me-1"></i>
                                        Dark
                                    </span>
                                </label>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label for="wbPrimaryColor"
                                   class="form-label fw-semibold">
                                Primary color
                            </label>

                            <div class="d-flex align-items-center gap-3">
                                <input id="wbPrimaryColor"
                                       type="color"
                                       class="form-control form-control-color"
                                       value="#16a085"
                                       title="Choose primary color">

                                <span id="wbColorValue"
                                      class="small text-muted">
                                    #16a085
                                </span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label for="wbButtonText"
                                   class="form-label fw-semibold">
                                Primary button label
                            </label>

                            <input id="wbButtonText"
                                   type="text"
                                   class="form-control"
                                   value="Find My Sofa"
                                   maxlength="40">
                        </div>

                        <div class="mb-4">
                            <label for="wbCornerStyle"
                                   class="form-label fw-semibold">
                                Corner style
                            </label>

                            <select id="wbCornerStyle" class="form-select">
                                <option value="rounded" selected>
                                    Rounded
                                </option>
                                <option value="soft">
                                    Soft rounded
                                </option>
                                <option value="square">
                                    Square
                                </option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="wbWidgetPosition"
                                   class="form-label fw-semibold">
                                Widget position
                            </label>

                            <select id="wbWidgetPosition" class="form-select">
                                <option value="bottom-right" selected>
                                    Bottom right
                                </option>
                                <option value="bottom-left">
                                    Bottom left
                                </option>
                            </select>
                        </div>

                    </div>

                    <!-- BEHAVIOR -->
                    <div class="wb-panel" data-wb-panel="behavior">

                        <h2 class="h5 fw-bold mb-1">Display behavior</h2>
                        <p class="text-muted small mb-4">
                            Configure how the widget appears to visitors.
                        </p>

                        <div class="wb-setting-row">
                            <div>
                                <div class="fw-semibold">
                                    Show widget title
                                </div>
                                <div class="text-muted small">
                                    Display the title above the description.
                                </div>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="wbShowTitle"
                                       checked>
                            </div>
                        </div>

                        <div class="wb-setting-row">
                            <div>
                                <div class="fw-semibold">
                                    Show description
                                </div>
                                <div class="text-muted small">
                                    Display the introductory message.
                                </div>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="wbShowDescription"
                                       checked>
                            </div>
                        </div>

                        <div class="wb-setting-row">
                            <div>
                                <div class="fw-semibold">
                                    Show introductory screen
                                </div>
                                <div class="text-muted small">
                                    Let visitors read the introduction before
                                    starting the experience.
                                </div>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="wbShowIntroduction"
                                       checked>
                            </div>
                        </div>

                        <div class="mb-4 mt-4">
                            <label for="wbStartButtonText"
                                   class="form-label fw-semibold">
                                Start button label
                            </label>

                            <input id="wbStartButtonText"
                                   type="text"
                                   class="form-control"
                                   value="Get Started"
                                   maxlength="40">
                        </div>

                        <div class="alert alert-secondary small mb-0">
                            <i class="bi bi-lightbulb me-1"></i>
                            These are proposed UI settings. We'll confirm
                            supported behavior and persistence before backend
                            integration.
                        </div>

                    </div>

                    <!-- Form navigation -->
                    <div class="d-flex justify-content-between gap-2 mt-4 pt-3 border-top">
                        <button type="button"
                                class="btn btn-outline-secondary"
                                id="wbPreviousButton"
                                disabled>
                            <i class="bi bi-arrow-left me-1"></i> Previous
                        </button>

                        <button type="button"
                                class="btn btn-primary"
                                id="wbNextButton">
                            Next <i class="bi bi-arrow-right ms-1"></i>
                        </button>
                    </div>

                </div>
            </div>

        </div>

        <!-- Live preview -->
        <div class="col-12 col-xl-5">

            <div class="wb-preview-sticky">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h2 class="h5 fw-bold mb-1">Live preview</h2>
                        <p class="text-muted small mb-0">
                            Sample visitor-facing appearance
                        </p>
                    </div>

                    <span class="badge border text-secondary">
                        <i class="bi bi-eye me-1"></i> Demo
                    </span>
                </div>

                <div class="wb-preview-stage" id="wbPreviewStage">

                    <div class="wb-preview-widget"
                         id="wbPreviewWidget"
                         data-theme="light"
                         data-corners="rounded">

                        <div class="wb-preview-brand">
                            <span class="wb-preview-brand-icon">
                                <i class="bi bi-stars"></i>
                            </span>
                            <span>DecisionOS</span>
                        </div>

                        <div id="wbPreviewContent">
                            <h3 id="wbPreviewTitle">
                                Find Your Perfect Sofa
                            </h3>

                            <p id="wbPreviewDescription">
                                Answer a few simple questions and discover
                                the sofa that suits your needs.
                            </p>
                        </div>

                        <button type="button"
                                class="btn wb-preview-primary"
                                id="wbPreviewPrimary">
                            Find My Sofa
                        </button>

                        <div class="wb-preview-footer">
                            Powered by DecisionOS
                        </div>

                    </div>

                </div>

                <div class="card border-0 shadow-sm mt-3">
                    <div class="card-body p-3">
                        <div class="d-flex gap-2 align-items-start">
                            <i class="bi bi-info-circle text-primary fs-5"></i>
                            <div>
                                <div class="fw-semibold small">
                                    Preview limitations
                                </div>
                                <p class="text-muted small mb-0">
                                    This is a visual mockup, not the live
                                    embedded widget. Question flows,
                                    recommendation results, and saved settings
                                    will be connected later.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

        </div>

    </div>

</div>

<style>

    /* =========================================================
       ASKPEARLS — DECISIONOS WIDGET BUILDER
       Complete page stylesheet
       Supports light/dark portal themes
       ========================================================= */

    /* ---------------------------------------------------------
       1. PAGE FOUNDATION
       --------------------------------------------------------- */

    .page-widget-builder {
        --wb-primary: #16a085;
        --wb-primary-hover: #12856f;
        --wb-tab-dark-bg: #102a22;
        --wb-tab-dark-hover: #193c30;
        --wb-tab-dark-border: #34544b;
        --wb-tab-dark-title: #ffffff;
        --wb-tab-dark-subtitle: #c2d8ce;
        --wb-tab-dark-number-bg: #29463c;
        --wb-active-green: #16a085;
        --wb-active-green-dark: #12856f;
        min-width: 0;
    }

        .page-widget-builder *,
        .page-widget-builder *::before,
        .page-widget-builder *::after {
            box-sizing: border-box;
        }

        .page-widget-builder .text-muted {
            color: var(--bs-secondary-color) !important;
        }

        /* ---------------------------------------------------------
       2. BUILDER STEPS CONTAINER
       --------------------------------------------------------- */

        .page-widget-builder .wb-steps {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 12px;
            padding: 4px;
        }

        /* ---------------------------------------------------------
       3. STEP TABS — HIGH CONTRAST
       Inactive tabs intentionally stay dark green in both themes.
       --------------------------------------------------------- */

        .page-widget-builder .wb-step {
            display: flex;
            align-items: center;
            gap: 12px;
            min-width: 0;
            padding: 14px;
            border: 1px solid var(--wb-tab-dark-border);
            border-radius: 10px;
            background-color: var(--wb-tab-dark-bg) !important;
            color: var(--wb-tab-dark-title) !important;
            text-align: left;
            cursor: pointer;
            opacity: 1 !important;
            transition: background-color .2s ease, border-color .2s ease, box-shadow .2s ease;
        }

            /* Prevent inherited button/theme styles from fading labels */

            .page-widget-builder .wb-step strong,
            .page-widget-builder .wb-step:not(.active) strong {
                display: block;
                margin: 0;
                color: var(--wb-tab-dark-title) !important;
                font-size: 14px;
                font-weight: 700;
                line-height: 1.4;
                opacity: 1 !important;
            }

            .page-widget-builder .wb-step small,
            .page-widget-builder .wb-step:not(.active) small {
                display: block;
                margin-top: 4px;
                color: var(--wb-tab-dark-subtitle) !important;
                font-size: 12px;
                font-weight: 400;
                line-height: 1.4;
                opacity: 1 !important;
            }

        /* Number circles */

        .page-widget-builder .wb-step-number {
            display: flex;
            align-items: center;
            justify-content: center;
            flex: 0 0 34px;
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background-color: var(--wb-tab-dark-number-bg) !important;
            color: #ffffff !important;
            font-size: 15px;
            font-weight: 700;
            opacity: 1 !important;
        }

        /* Inactive hover */

        .page-widget-builder .wb-step:not(.active):hover {
            background-color: var(--wb-tab-dark-hover) !important;
            border-color: #65cba6 !important;
        }

        /* Keyboard focus */

        .page-widget-builder .wb-step:focus-visible {
            outline: 3px solid #65cba6;
            outline-offset: 3px;
            position: relative;
            z-index: 1;
        }

      
        /* Active step — AskPearls green branding */

        .page-widget-builder .wb-step.active {
            background-color: #ffffff !important;
            border: 2px solid var(--wb-active-green) !important;
            color: #17212b !important;
            box-shadow: 0 0 0 1px rgba(22, 160, 133, .10);
        }

            .page-widget-builder .wb-step.active strong {
                color: #17212b !important;
            }

            .page-widget-builder .wb-step.active small {
                color: #526579 !important;
            }

            .page-widget-builder .wb-step.active .wb-step-number {
                background-color: var(--wb-active-green) !important;
                color: #ffffff !important;
            }

        /* Keyboard focus */
        .page-widget-builder .wb-step:focus-visible {
            outline: 3px solid #16a085;
            outline-offset: 3px;
        }


        /* ---------------------------------------------------------
       4. FORM PANELS
       --------------------------------------------------------- */

        .page-widget-builder .wb-panel {
            display: none;
            min-width: 0;
        }

            .page-widget-builder .wb-panel.active {
                display: block;
            }

        .page-widget-builder .form-label {
            color: var(--bs-body-color);
        }

        .page-widget-builder .form-control,
        .page-widget-builder .form-select {
            max-width: 100%;
        }

        .page-widget-builder textarea.form-control {
            resize: vertical;
            min-height: 80px;
        }

        .page-widget-builder .form-text {
            color: var(--bs-secondary-color);
        }

        .page-widget-builder .form-control-color {
            width: 54px;
            height: 42px;
            padding: 4px;
        }

        /* ---------------------------------------------------------
       5. APPEARANCE THEME OPTIONS
       --------------------------------------------------------- */

        .page-widget-builder .wb-theme-option {
            position: relative;
            display: inline-flex;
        }

            .page-widget-builder .wb-theme-option input {
                position: absolute;
                width: 1px;
                height: 1px;
                opacity: 0;
                pointer-events: none;
            }

            .page-widget-builder .wb-theme-option span {
                display: inline-block;
                padding: 10px 16px;
                border: 1px solid var(--bs-border-color);
                border-radius: 8px;
                background-color: var(--bs-body-bg);
                color: var(--bs-body-color);
                cursor: pointer;
                transition: border-color .2s ease, background-color .2s ease;
            }

            .page-widget-builder .wb-theme-option input:checked + span {
                border-color: var(--bs-primary);
                background-color: var(--bs-tertiary-bg);
                box-shadow: 0 0 0 1px var(--bs-primary);
            }

            .page-widget-builder .wb-theme-option input:focus-visible + span {
                outline: 3px solid var(--bs-primary);
                outline-offset: 3px;
            }

        /* ---------------------------------------------------------
       6. BEHAVIOR SETTINGS
       --------------------------------------------------------- */

        .page-widget-builder .wb-setting-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
            padding: 16px 0;
            border-bottom: 1px solid var(--bs-border-color);
        }

            .page-widget-builder .wb-setting-row > div:first-child {
                min-width: 0;
            }

            .page-widget-builder .wb-setting-row .form-check {
                flex: 0 0 auto;
                margin: 0;
                padding-left: 2.5em;
            }

            .page-widget-builder .wb-setting-row .form-check-input {
                cursor: pointer;
            }

        /* ---------------------------------------------------------
       7. LIVE PREVIEW POSITIONING
       --------------------------------------------------------- */

        .page-widget-builder .wb-preview-sticky {
            position: sticky;
            top: 90px;
            min-width: 0;
        }

        /* Preview canvas */

        .page-widget-builder .wb-preview-stage {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 390px;
            padding: 24px;
            border: 1px dashed var(--bs-border-color);
            border-radius: 14px;
            background: radial-gradient( circle at 15% 15%, rgba(22, 160, 133, .10), transparent 45% ), var(--bs-tertiary-bg);
        }

        /* ---------------------------------------------------------
       8. VISITOR-FACING PREVIEW CARD
       --------------------------------------------------------- */

        .page-widget-builder .wb-preview-widget {
            width: 100%;
            max-width: 370px;
            padding: 24px;
            border: 1px solid #dfe5e8;
            border-radius: 16px;
            background-color: #ffffff;
            color: #20313b;
            box-shadow: 0 12px 35px rgba(0, 0, 0, .09);
            transition: background-color .2s ease, color .2s ease, border-radius .2s ease;
        }

            /* Visitor preview dark theme */

            .page-widget-builder .wb-preview-widget[data-theme="dark"] {
                background-color: #10242b;
                color: #edf5f7;
                border-color: #29454e;
            }

            /* Preview corner options */

            .page-widget-builder .wb-preview-widget[data-corners="rounded"] {
                border-radius: 16px;
            }

            .page-widget-builder .wb-preview-widget[data-corners="soft"] {
                border-radius: 24px;
            }

            .page-widget-builder .wb-preview-widget[data-corners="square"] {
                border-radius: 3px;
            }

        /* Preview brand */

        .page-widget-builder .wb-preview-brand {
            display: flex;
            align-items: center;
            gap: 9px;
            margin-bottom: 24px;
            font-size: 13px;
            font-weight: 700;
        }

        .page-widget-builder .wb-preview-brand-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex: 0 0 32px;
            width: 32px;
            height: 32px;
            border-radius: 9px;
            background-color: var(--wb-primary);
            color: #ffffff;
        }

        /* Preview title */

        .page-widget-builder .wb-preview-widget h3 {
            margin-bottom: 12px;
            color: inherit;
            font-size: 23px;
            font-weight: 750;
            line-height: 1.35;
        }

        /* Preview description */

        .page-widget-builder .wb-preview-widget p {
            margin-bottom: 22px;
            color: inherit;
            font-size: 14px;
            line-height: 1.7;
            opacity: .82;
        }

        /* Preview primary button */

        .page-widget-builder .wb-preview-primary {
            display: block;
            width: 100%;
            padding: 12px 16px;
            border: 1px solid var(--wb-primary);
            border-radius: 4px;
            background-color: var(--wb-primary);
            color: #ffffff;
            font-weight: 600;
            line-height: 1.5;
            transition: background-color .2s ease, border-color .2s ease;
        }

            .page-widget-builder .wb-preview-primary:hover,
            .page-widget-builder .wb-preview-primary:focus-visible {
                border-color: var(--wb-primary-hover);
                background-color: var(--wb-primary-hover);
                color: #ffffff;
            }

        /* Preview footer */

        .page-widget-builder .wb-preview-footer {
            margin-top: 18px;
            color: inherit;
            font-size: 11px;
            text-align: center;
            opacity: .7;
        }

        /* ---------------------------------------------------------
       9. ALERTS AND STATUS ELEMENTS
       --------------------------------------------------------- */

        .page-widget-builder .alert {
            overflow-wrap: anywhere;
        }

        .page-widget-builder .badge {
            font-weight: 500;
        }

    /* ---------------------------------------------------------
       10. RESPONSIVE LAYOUT
       --------------------------------------------------------- */

    @@media (max-width: 1199.98px) {
        .page-widget-builder .wb-preview-sticky {
            position: static;
        }
    }

    @@media (max-width: 767.98px) {
        .page-widget-builder .wb-steps {
            grid-template-columns: 1fr;
            gap: 8px;
        }

        .page-widget-builder .wb-step {
            padding: 12px;
        }

        .page-widget-builder .wb-preview-stage {
            min-height: 320px;
            padding: 16px;
        }

        .page-widget-builder .wb-preview-widget {
            max-width: 100%;
            padding: 20px;
        }

            .page-widget-builder .wb-preview-widget h3 {
                font-size: 21px;
            }

        .page-widget-builder .wb-setting-row {
            gap: 12px;
        }
    }

    @@media (max-width: 399.98px) {
        .page-widget-builder .wb-preview-stage {
            padding: 10px;
        }

        .page-widget-builder .wb-preview-widget {
            padding: 16px;
        }

        .page-widget-builder .wb-step {
            gap: 10px;
        }
    }

    /* ---------------------------------------------------------
       11. REDUCED MOTION ACCESSIBILITY
       --------------------------------------------------------- */

    @@media (prefers-reduced-motion: reduce) {
        .page-widget-builder *,
        .page-widget-builder *::before,
        .page-widget-builder *::after {
            scroll-behavior: auto !important;
            transition-duration: .01ms !important;
            animation-duration: .01ms !important;
            animation-iteration-count: 1 !important;
        }
    }

</style>

<script>
    (function($) {
        "use strict";

        const root = ".page-widget-builder";
        let currentStep = 0;

        const steps = ["basics", "appearance", "behavior"];

        function showStep(index) {
            currentStep = Math.max(0, Math.min(index, steps.length - 1));

            $(root + " .wb-step").removeClass("active");
            $(root + " .wb-panel").removeClass("active");

            const stepName = steps[currentStep];

            $(root + ' .wb-step[data-wb-tab="' + stepName + '"]')
                .addClass("active");

            $(root + ' .wb-panel[data-wb-panel="' + stepName + '"]')
                .addClass("active");

            $("#wbPreviousButton").prop("disabled", currentStep === 0);

            $("#wbNextButton").html(
                currentStep === steps.length - 1
                    ? 'Finish <i class="bi bi-check2 ms-1"></i>'
                    : 'Next <i class="bi bi-arrow-right ms-1"></i>'
            );
        }

        function updatePreview() {
            const title = $("#wbWidgetTitle").val().trim();
            const description = $("#wbWidgetDescription").val().trim();
            const buttonText = $("#wbButtonText").val().trim();
            const primaryColor = $("#wbPrimaryColor").val();
            const corners = $("#wbCornerStyle").val();
            const theme = $('input[name="wbTheme"]:checked').val();

            $("#wbPreviewTitle")
                .text(title || "Your Widget Title")
                .toggle($("#wbShowTitle").is(":checked"));

            $("#wbPreviewDescription")
                .text(description || "Your widget description.")
                .toggle($("#wbShowDescription").is(":checked"));

            $("#wbPreviewPrimary").text(buttonText || "Get Started");

            $("#wbPreviewWidget")
                .attr("data-theme", theme)
                .attr("data-corners", corners);

            $(".page-widget-builder")
                .css("--wb-primary", primaryColor);

            $("#wbColorValue").text(primaryColor);
        }

        $(document)
            .off("click.widgetBuilder", root + " .wb-step")
            .on("click.widgetBuilder", root + " .wb-step", function() {
                showStep(steps.indexOf($(this).data("wb-tab")));
            });

        $(document)
            .off("click.widgetBuilderNext", "#wbNextButton")
            .on("click.widgetBuilderNext", "#wbNextButton", function() {
                if (currentStep < steps.length - 1) {
                    showStep(currentStep + 1);
                } else {
                    // UI-only: the next page will be connected later.
                    alert("Widget Builder UI preview: next step is Questions & Answers.");
                }
            });

        $(document)
            .off("click.widgetBuilderPrevious", "#wbPreviousButton")
            .on("click.widgetBuilderPrevious", "#wbPreviousButton", function() {
                showStep(currentStep - 1);
            });

        $(document)
            .off("input.widgetBuilder change.widgetBuilder",
                root + " input, " + root + " textarea, " + root + " select")
            .on("input.widgetBuilder change.widgetBuilder",
                root + " input, " + root + " textarea, " + root + " select",
                updatePreview);

        $(document)
            .off("click.widgetBuilderPreview", "#wbPreviewButton")
            .on("click.widgetBuilderPreview", "#wbPreviewButton", function() {
                $("#wbPreviewStage")[0].scrollIntoView({
                    behavior: "smooth",
                    block: "center"
                });
            });

        $(document)
            .off("click.widgetBuilderSave", "#wbSaveButton")
            .on("click.widgetBuilderSave", "#wbSaveButton", function() {
                alert("UI prototype only: Save Draft will be connected to the API later.");
            });

        $(document)
            .off("click.widgetBuilderPrimary", "#wbPreviewPrimary")
            .on("click.widgetBuilderPrimary", "#wbPreviewPrimary", function() {
                alert("Visitor interaction will be implemented in a later stage.");
            });

        // Reinitialize safely when this partial is loaded through AJAX.
        showStep(0);
        updatePreview();

    })(jQuery);
</script>

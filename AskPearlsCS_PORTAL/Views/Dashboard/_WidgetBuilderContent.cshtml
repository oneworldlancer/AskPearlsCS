
<div class="ap-page page-widget-builder"
     data-ap-page="widget-builder">

    @Html.AntiForgeryToken()

    <!-- =====================================================
         BREADCRUMB
         ===================================================== -->
    <nav class="ap-breadcrumb" aria-label="Breadcrumb">
        <a href="/Dashboard">AskPearls</a>
        <span class="ap-breadcrumb-separator" aria-hidden="true">/</span>
        <span class="ap-breadcrumb-current" aria-current="page">
            Widget Builder
        </span>
    </nav>

    <!-- =====================================================
         PAGE HEADER
         ===================================================== -->
    <header class="ap-page-header wb-page-header">

        <div class="ap-page-heading">
            <h1 class="ap-page-title" id="wbPageTitle">
                Widget Builder
            </h1>

            <p class="ap-page-description" id="wbPageDescription">
                Create and customize your DecisionOS experience.
            </p>
        </div>

        <div class="ap-page-actions wb-header-actions">

            <span class="wb-draft-indicator" id="wbDraftIndicator">
                <i class="bi bi-circle-fill me-1"
                   style="font-size:7px"></i>
                Unsaved draft
            </span>

            <button type="button"
                    class="btn btn-outline-secondary"
                    id="wbPreviewButton">
                <i class="bi bi-eye me-1"></i>
                Preview
            </button>

            <!-- TOP SAVE DRAFT -->
            <button type="button"
                    class="btn btn-primary"
                    id="wbSaveButton"
                    disabled>
                <i class="bi bi-save me-1"></i>
                Save Draft
            </button>

        </div>
    </header>

    <!-- =====================================================
         WIDGET SELECTOR
         ===================================================== -->
    <section class="wb-widget-selector ap-widget-selector"
             aria-label="Widget selection">

        <button type="button" id="wbCreateWidgetButton" class="wb-create-widget-button" title="Create new widget" aria-label="Create new widget"><i class="bi bi-plus-lg" aria-hidden="true"></i></button>

        <div class="wb-selector-icon" aria-hidden="true">
            <i class="bi bi-grid-1x2"></i>
        </div>

        <div class="wb-selector-info">

            <label for="wbWidgetSelect">
                Select widget
            </label>

            <select id="wbWidgetSelect"
                    class="form-select"
                    aria-describedby="wbSelectorHelp"
                    disabled>
                <option value="">-- Select a widget --</option>
            </select>

            <small id="wbSelectorHelp">
                Choose the widget you want to edit.
            </small>

        </div>

        <div class="wb-selector-version">
            <span>Draft / live</span>
            <strong id="wbWidgetVersion">—</strong>
        </div>

    </section>

    <p class="wb-api-note" id="wbApiNote">
        Choose an existing widget to edit, or open this page
        from “Create new widget” to start a new widget.
    </p>

    <div class="wb-api-message"
         id="wbApiMessage"
         role="status"
         aria-live="polite"
         hidden>
    </div>

    <!-- =====================================================
         WIZARD STEPS
         ===================================================== -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">

            <div class="wb-steps">

                <button type="button"
                        class="wb-step active"
                        data-wb-tab="basics">

                    <span class="wb-step-number">1</span>

                    <span>
                        <strong>Basics</strong>
                        <small>Identity and content</small>
                    </span>

                </button>

                <button type="button"
                        class="wb-step"
                        data-wb-tab="appearance">

                    <span class="wb-step-number">2</span>

                    <span>
                        <strong>Appearance</strong>
                        <small>Colors and styling</small>
                    </span>

                </button>

                <button type="button"
                        class="wb-step"
                        data-wb-tab="behavior">

                    <span class="wb-step-number">3</span>

                    <span>
                        <strong>Behavior</strong>
                        <small>Display preferences</small>
                    </span>

                </button>

            </div>

        </div>
    </div>

    <!-- =====================================================
         MAIN CONTENT
         ===================================================== -->
    <div class="row g-4">

        <!-- =================================================
             LEFT: WIDGET CONFIGURATION
             ================================================= -->
        <div class="col-12 col-xl-7">

            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">

                    <!-- =====================================
                         STEP 1: BASICS
                         ===================================== -->
                    <div class="wb-panel active"
                         data-wb-panel="basics">

                        <h2 class="h5 fw-bold mb-1">
                            Widget basics
                        </h2>

                        <p class="text-muted small mb-4">
                            Define the identity and content visitors will see.
                        </p>

                        <!-- Internal widget name -->
                        <div class="mb-3">

                            <label for="wbWidgetName"
                                   class="form-label fw-semibold">
                                Internal widget name
                                <span class="text-danger">*</span>
                            </label>

                            <input id="wbWidgetName"
                                   type="text"
                                   class="form-control"
                                   maxlength="100"
                                   placeholder="e.g. Product Finder">

                            <div class="form-text">
                                Used to identify this widget in your portal.
                            </div>

                        </div>

                        <!-- Widget type -->
                        <div class="mb-3">

                            <label for="wbWidgetType"
                                   class="form-label fw-semibold">
                                Widget type
                            </label>

                            <select id="wbWidgetType"
                                    class="form-select">

                                <option value="decision" selected>
                                    DecisionOS — Decision Assistant
                                </option>

                            </select>

                            <div class="form-text">
                                Additional agent types can be enabled later.
                            </div>

                        </div>

                        <!-- Target website -->
                        <div class="mb-3">

                            <label for="wbWebsite"
                                   class="form-label fw-semibold">
                                Target website
                                <span class="text-danger">*</span>
                            </label>

                            <input id="wbWebsite"
                                   type="url"
                                   class="form-control"
                                   maxlength="250"
                                   placeholder="https://example.com">

                            <div class="form-text">
                                Enter the website where this widget will be used.
                            </div>

                        </div>

                        <!-- Visitor-facing title -->
                        <div class="mb-3">

                            <label for="wbWidgetTitle"
                                   class="form-label fw-semibold">
                                Visitor-facing title
                                <span class="text-danger">*</span>
                            </label>

                            <input id="wbWidgetTitle"
                                   type="text"
                                   class="form-control"
                                   maxlength="100"
                                   placeholder="Give your widget a title">

                        </div>

                        <!-- Description -->
                        <div class="mb-3">

                            <label for="wbWidgetDescription"
                                   class="form-label fw-semibold">
                                Description
                            </label>

                            <textarea id="wbWidgetDescription"
                                      class="form-control"
                                      rows="3"
                                      maxlength="250"
                                      placeholder="Explain how this assistant helps visitors."></textarea>

                        </div>

                        <!-- Information -->
                        <div class="alert alert-info d-flex gap-2 small mb-0">

                            <i class="bi bi-info-circle fs-5"></i>

                            <div>
                                Questions, answers, recommendation items,
                                and scoring rules will be configured in
                                the following builder stages.
                            </div>

                        </div>

                    </div>

                    <!-- =====================================
                         STEP 2: APPEARANCE
                         ===================================== -->
                    <div class="wb-panel"
                         data-wb-panel="appearance"
                         hidden>

                        <h2 class="h5 fw-bold mb-1">
                            Appearance
                        </h2>

                        <p class="text-muted small mb-4">
                            Customize the visitor-facing experience.
                        </p>

                        <!-- Color theme -->
                        <div class="mb-4">

                            <label class="form-label fw-semibold">
                                Color theme
                            </label>

                            <div class="d-flex flex-wrap gap-2">

                                <label class="wb-theme-option">

                                    <input type="radio"
                                           name="wbTheme"
                                           value="light"
                                           checked>

                                    <span>
                                        <i class="bi bi-sun me-1"></i>
                                        Light
                                    </span>

                                </label>

                                <label class="wb-theme-option">

                                    <input type="radio"
                                           name="wbTheme"
                                           value="dark">

                                    <span>
                                        <i class="bi bi-moon me-1"></i>
                                        Dark
                                    </span>

                                </label>

                            </div>

                        </div>

                        <!-- Primary color -->
                        <div class="mb-4">

                            <label for="wbPrimaryColor"
                                   class="form-label fw-semibold">
                                Primary color
                            </label>

                            <div class="d-flex align-items-center gap-3">

                                <input id="wbPrimaryColor"
                                       type="color"
                                       class="form-control form-control-color"
                                       value="#16a085"
                                       title="Choose primary color">

                                <span id="wbColorValue"
                                      class="small text-muted">
                                    #16a085
                                </span>

                            </div>

                        </div>

                        <!-- Primary button label -->
                        <div class="mb-4">

                            <label for="wbButtonText"
                                   class="form-label fw-semibold">
                                Primary button label
                            </label>

                            <input id="wbButtonText"
                                   type="text"
                                   class="form-control"
                                   value="Get Started"
                                   maxlength="40">

                        </div>

                        <!-- Corner style -->
                        <div class="mb-4">

                            <label for="wbCornerStyle"
                                   class="form-label fw-semibold">
                                Corner style
                            </label>

                            <select id="wbCornerStyle"
                                    class="form-select">

                                <option value="rounded" selected>
                                    Rounded
                                </option>

                                <option value="soft">
                                    Soft rounded
                                </option>

                                <option value="square">
                                    Square
                                </option>

                            </select>

                        </div>

                        <!-- Widget position -->
                        <div class="mb-3">

                            <label for="wbWidgetPosition"
                                   class="form-label fw-semibold">
                                Widget position
                            </label>

                            <select id="wbWidgetPosition"
                                    class="form-select">

                                <option value="bottom-right" selected>
                                    Bottom right
                                </option>

                                <option value="bottom-left">
                                    Bottom left
                                </option>

                            </select>

                        </div>

                    </div>

                    <!-- =====================================
                         STEP 3: BEHAVIOR
                         ===================================== -->
                    <div class="wb-panel"
                         data-wb-panel="behavior"
                         hidden>

                        <h2 class="h5 fw-bold mb-1">
                            Display behavior
                        </h2>

                        <p class="text-muted small mb-4">
                            Configure how the widget appears to visitors.
                        </p>

                        <!-- Show title -->
                        <div class="wb-setting-row">

                            <div>

                                <div class="fw-semibold">
                                    Show widget title
                                </div>

                                <div class="text-muted small">
                                    Display the title above the description.
                                </div>

                            </div>

                            <div class="form-check form-switch">

                                <input class="form-check-input"
                                       type="checkbox"
                                       id="wbShowTitle"
                                       checked
                                       aria-label="Show widget title">

                            </div>

                        </div>

                        <!-- Show description -->
                        <div class="wb-setting-row">

                            <div>

                                <div class="fw-semibold">
                                    Show description
                                </div>

                                <div class="text-muted small">
                                    Display the introductory message.
                                </div>

                            </div>

                            <div class="form-check form-switch">

                                <input class="form-check-input"
                                       type="checkbox"
                                       id="wbShowDescription"
                                       checked
                                       aria-label="Show description">

                            </div>

                        </div>

                        <!-- Show introduction -->
                        <div class="wb-setting-row">

                            <div>

                                <div class="fw-semibold">
                                    Show introductory screen
                                </div>

                                <div class="text-muted small">
                                    Let visitors read the introduction
                                    before starting the experience.
                                </div>

                            </div>

                            <div class="form-check form-switch">

                                <input class="form-check-input"
                                       type="checkbox"
                                       id="wbShowIntroduction"
                                       checked
                                       aria-label="Show introductory screen">

                            </div>

                        </div>

                        <div class="alert alert-secondary small mb-0 mt-3">

                            <i class="bi bi-lightbulb me-1"></i>

                            These settings are saved as part of the
                            widget design configuration when supported
                            by the API.

                        </div>

                    </div>

                    <!-- =====================================
                         WIZARD FOOTER NAVIGATION
                         ===================================== -->
                    <div class="wb-wizard-footer mt-4 pt-3 border-top">

                        <!-- Previous -->
                        <button type="button"
                                class="btn btn-outline-secondary"
                                id="wbPreviousButton"
                                disabled>

                            <i class="bi bi-arrow-left me-1"></i>
                            Previous

                        </button>

                        <!-- Right actions -->
                        <div class="wb-wizard-footer-actions">

                            <!-- Next -->
                            <button type="button"
                                    class="btn btn-outline-secondary"
                                    id="wbNextButton">

                                Next
                                <i class="bi bi-arrow-right ms-1"></i>

                            </button>

                            <!-- BOTTOM SAVE DRAFT -->
                            <button type="button"
                                    class="btn btn-primary wb-save-draft-button"
                                    id="wbSaveBottomButton"
                                    disabled>

                                <i class="bi bi-save me-1"></i>
                                Save Draft

                            </button>

                        </div>

                    </div>

                </div>
            </div>

        </div>

        <!-- =================================================
             RIGHT: LIVE PREVIEW
             ================================================= -->
        <div class="col-12 col-xl-5">

            <div class="wb-preview-sticky">

                <!-- Preview heading -->
                <div class="d-flex justify-content-between align-items-center mb-3">

                    <div>

                        <h2 class="h5 fw-bold mb-1">
                            Live preview
                        </h2>

                        <p class="text-muted small mb-0">
                            Sample visitor-facing appearance
                        </p>

                    </div>

                    <span class="badge border text-secondary">

                        <i class="bi bi-eye me-1"></i>
                        Demo

                    </span>

                </div>

                <!-- Preview stage -->
                <div class="wb-preview-stage"
                     id="wbPreviewStage">

                    <div class="wb-preview-widget"
                         id="wbPreviewWidget"
                         data-theme="light"
                         data-corners="rounded">

                        <!-- Branding -->
                        <div class="wb-preview-brand">

                            <span class="wb-preview-brand-icon" id="wbPreviewAssistantIcon">
                                <i class="bi bi-stars"></i>
                            </span>

                            <span><strong id="wbPreviewHeaderTitle">DecisionOS</strong><small id="wbPreviewCompanyName" class="d-block"></small></span>

                        </div>

                        <!-- Preview content -->
                        <div id="wbPreviewContent">
                            <div id="wbPreviewCompanyLogo" class="wb-company-logo"><i class="bi bi-stars"></i></div>

                            <h3 id="wbPreviewTitle">
                                Your widget title
                            </h3>

                            <p id="wbPreviewDescription">
                                Your widget description will appear here.
                            </p>

                        </div>

                        <!-- Preview button -->
                        <button type="button"
                                class="btn wb-preview-primary"
                                id="wbPreviewPrimary">

                            Get Started

                        </button>

                        <!-- Preview footer -->
                        <div class="wb-preview-footer" id="wbPreviewFooter">
                            Powered by AskPearls
                        </div>

                    </div>

                </div>

                <!-- Preview limitations -->
                <div class="card border-0 shadow-sm mt-3">

                    <div class="card-body p-3">

                        <div class="d-flex gap-2 align-items-start">

                            <i class="bi bi-info-circle text-primary fs-5"></i>

                            <div>

                                <div class="fw-semibold small">
                                    Preview limitations
                                </div>

                                <p class="text-muted small mb-0">

                                    This is a visual mockup, not the live
                                    embedded widget. Question flows,
                                    recommendation results, and saved settings
                                    will be connected later.

                                </p>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

<!-- =====================================================
     PAGE STYLES
     ===================================================== -->
<link href="~/app_page_css/app_page_widget_builder_css.css?v=20261107-builder-routing-1"
      rel="stylesheet" />

<!-- =====================================================
     PAGE JAVASCRIPT
     ===================================================== -->
<script src="~/app_page_js/app_page_widget_builder_js.js?v=20261107-builder-routing-1"></script>

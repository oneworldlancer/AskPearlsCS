@* Publish & Embed — responsive selector, guarded publish UI. *@
<div class="ap-page publish-embed-page" data-ap-page="publish-embed" data-pe-script-url="https://cdn.askpearls.com/app.widgets/widget.js" data-pe-api-origin="https://api.askpearls.com">
    @Html.AntiForgeryToken()
    <nav class="ap-breadcrumb" aria-label="Breadcrumb"><a href="/Dashboard">AskPearls</a><span class="ap-breadcrumb-separator">/</span><span class="ap-breadcrumb-current">Publish &amp; Embed</span></nav>
    <header class="pe-page-header ap-page-header">
        <div class="ap-page-heading"><h1 class="ap-page-title">Publish &amp; Embed</h1><p class="ap-page-description">Publish your widget and install it on your website.</p></div>
        <div class="pe-header-actions ap-page-actions"><span class="pe-status-badge" id="peStatusBadge"><i class="bi bi-circle-fill"></i> Select a widget</span><button type="button" class="pe-btn-primary" id="pePublishBtn" disabled><i class="bi bi-rocket-takeoff"></i> Publish Widget</button></div>
    </header>
    <section class="pe-card pe-widget-selector ap-widget-selector">
        <div class="pe-widget-icon ap-widget-selector-icon" aria-hidden="true">
            <i class="bi bi-grid-1x2"></i>
        </div>
        <div class="pe-widget-info ap-widget-selector-info">
            <label for="peWidgetSelect">Select widget</label>
            <div class="pe-selector-inline">
                <select id="peWidgetSelect" class="ap-widget-selector-control">
                    <option value="">-- Select a widget --</option>
                </select>
            </div>
            <small class="ap-widget-selector-help">Choose the widget you want to publish.</small>
        </div>
        <div class="pe-version ap-widget-selector-version">
            <span>Draft / Live</span>
            <strong id="peVersion">—</strong>
        </div>
    </section>

    <p class="pe-publish-reason" id="pePublishReason" role="status" aria-live="polite">Select a widget to check publishing eligibility.</p>
    <div class="pe-summary-grid">
        <div class="pe-summary-card"><div class="pe-summary-icon pe-green"><i class="bi bi-globe2"></i></div><div><span>Publishing status</span><strong id="peSummaryStatus">No widget selected</strong><small id="peStatusDescription">Select a widget to view its publishing status.</small></div></div>
        <div class="pe-summary-card"><div class="pe-summary-icon pe-blue"><i class="bi bi-code-slash"></i></div><div><span>Installation method</span><strong id="peSummaryPlatform">Custom HTML</strong><small>Copy and paste the embed code</small></div></div>
        <div class="pe-summary-card"><div class="pe-summary-icon pe-purple"><i class="bi bi-shield-check"></i></div><div><span>Allowed domains</span><strong id="peDomainCount">0 domains</strong><small>Saved domains</small></div></div>
    </div>
    <div class="pe-main-grid">
        <section class="pe-card pe-install-card">
            <div class="pe-card-heading"><div><h5>Install your widget</h5><p>Choose your website platform and follow the instructions.</p></div><i class="bi bi-plug"></i></div>
            <div class="pe-platform-tabs" role="tablist" aria-label="Website platform">
                <button type="button" class="pe-platform-tab active" data-pe-platform="html" role="tab" aria-selected="true"><i class="bi bi-code-square"></i> Custom HTML</button>
                <button type="button" class="pe-platform-tab" data-pe-platform="wordpress" role="tab" aria-selected="false"><i class="bi bi-wordpress"></i> WordPress</button>
                <button type="button" class="pe-platform-tab" data-pe-platform="shopify" role="tab" aria-selected="false"><i class="bi bi-bag"></i> Shopify</button>
                <button type="button" class="pe-platform-tab" data-pe-platform="wix" role="tab" aria-selected="false"><i class="bi bi-window"></i> Wix</button>
            </div>
            <div class="pe-instructions">
                <div class="pe-instruction-title"><span class="pe-step-number">1</span><div><h6 id="peInstructionHeading">Copy your embed code</h6><p id="peInstructionDescription">Copy the snippet below and add it to your website.</p></div></div>
                <div class="pe-code-heading"><div><i class="bi bi-filetype-html"></i> <span id="peCodeLabel">HTML embed snippet</span></div><button type="button" class="pe-copy-btn" id="peCopyCode" disabled><i class="bi bi-clipboard"></i> Copy code</button></div>
                <pre class="pe-code-block"><code id="peEmbedCode"></code></pre>
                <div class="pe-instruction-title pe-second-step"><span class="pe-step-number">2</span><div><h6 id="peStepTwoHeading">Paste the code into your website</h6><p id="peStepTwoDescription">Place the snippet before the closing body tag, then save your page.</p></div></div>
                <div class="pe-tip"><i class="bi bi-lightbulb"></i><div><strong>Installation tip</strong><p id="peInstallTip">Add the snippet once per website.</p></div></div>
            </div>
        </section>
        <section class="pe-card pe-domain-card">
            <div class="pe-card-heading"><div><h5>Allowed domains</h5><p>Manage the websites that may host this widget.</p></div><i class="bi bi-shield-lock"></i></div>
            <div class="pe-security-note"><i class="bi bi-info-circle"></i><span>Domains belong to your account. Verify ownership using a DNS TXT record before installing a widget.</span></div>
            <form id="peDomainForm" class="pe-domain-form"><label for="peDomainInput">Add a website domain</label><div class="pe-domain-input-row"><input type="text" id="peDomainInput" placeholder="example.com" maxlength="253" autocomplete="off" /><button type="submit" class="pe-btn-primary pe-add-domain"><i class="bi bi-plus-lg"></i> Add</button></div><small>Enter a domain such as example.com, without a URL path.</small><div class="pe-domain-error" id="peDomainError" role="alert"></div></form>
            <div class="pe-domain-list-heading"><strong>Configured domains</strong><span id="peDomainListCount">0</span></div><div class="pe-domain-list" id="peDomainList"></div>
            <div class="pe-domain-empty" id="peDomainEmpty"><i class="bi bi-globe"></i><strong>No domains configured</strong><span>Add a domain authorized to host this widget.</span></div>
        </section>
    </div>
    <section class="pe-card pe-checklist-card">
        <div class="pe-card-heading"><div><h5>Before you go live</h5><p>Review these steps before installing the widget on your website.</p></div><i class="bi bi-check2-square"></i></div>
        <div class="pe-checklist">
            <label class="pe-check-item" for="peCheckContent"><input type="checkbox" id="peCheckContent" class="pe-checklist-checkbox" /><span class="pe-custom-check"><i class="bi bi-check"></i></span><span class="pe-check-copy"><strong>Review your widget content</strong><small>Confirm your questions and recommendation items are ready.</small></span></label>
            <label class="pe-check-item" for="peCheckDesign"><input type="checkbox" id="peCheckDesign" class="pe-checklist-checkbox" /><span class="pe-custom-check"><i class="bi bi-check"></i></span><span class="pe-check-copy"><strong>Review your widget design</strong><small>Check colors, typography, and mobile appearance.</small></span></label>
            <label class="pe-check-item" for="peCheckInstall"><input type="checkbox" id="peCheckInstall" class="pe-checklist-checkbox" /><span class="pe-custom-check"><i class="bi bi-check"></i></span><span class="pe-check-copy"><strong>Prepare your installation</strong><small>Choose a platform and copy the relevant embed snippet.</small></span></label>
        </div>
        <div class="pe-checklist-progress" aria-live="polite"><span id="peChecklistStatus">0 of 3 steps completed</span><div class="pe-checklist-progress-track"><div id="peChecklistProgressBar" class="pe-checklist-progress-bar" role="progressbar" aria-label="Go-live checklist progress" aria-valuemin="0" aria-valuemax="3" aria-valuenow="0"></div></div></div>
        <div class="pe-checklist-complete" id="peChecklistComplete" hidden><span class="pe-checklist-complete-icon"><i class="bi bi-check-lg"></i></span><div class="pe-checklist-complete-copy"><strong>You're ready to go live</strong><span>Your checklist is complete. Continue to the publish controls when you're ready.</span></div><button type="button" class="pe-checklist-next" id="peChecklistNext">Go to publish controls <i class="bi bi-arrow-up-right"></i></button></div>
    </section>
    <div class="pe-toast" id="peToast" role="status" aria-live="polite"></div>
</div>
<link href="~/app_page_css/app_page_publish_embed_css.css" rel="stylesheet" asp-append-version="true" />
<link href="~/app_page_css/app_page_publish_embed_selector_update.css" rel="stylesheet" asp-append-version="true" />
<link href="~/app_page_css/app_page_publish_embed_verification_css.css" rel="stylesheet" asp-append-version="true" />
<link href="~/app_page_css/app_page_publish_embed_responsive_update.css" rel="stylesheet" asp-append-version="true" />
<link href="~/app_page_css/app_page_publish_embed_alignment_fix.css" rel="stylesheet" asp-append-version="true" />
<script src="~/app_page_js/app_page_publish_embed_js.js" asp-append-version="true"></script>
<script src="~/app_page_js/app_page_publish_embed_guard_js.js" asp-append-version="true"></script>

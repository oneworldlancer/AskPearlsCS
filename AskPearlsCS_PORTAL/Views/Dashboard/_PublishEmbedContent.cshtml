
<!-- PAGE: PUBLISH & EMBED -->
<div class="ap-page publish-embed-page" data-ap-page="publish-embed">
    <!-- Shared AskPearls breadcrumb -->
    <nav class="ap-breadcrumb" aria-label="Breadcrumb">
        <a href="/Dashboard">AskPearls</a>
        <span class="ap-breadcrumb-separator" aria-hidden="true">/</span>
        <span class="ap-breadcrumb-current" aria-current="page">Publish &amp; Embed</span>
    </nav>


    <header class="pe-page-header ap-page-header">
        <div class="ap-page-heading">
            <h1 class="ap-page-title">Publish &amp; Embed</h1>
            <p class="ap-page-description">Publish your widget and install it on your website.</p>
        </div>
        <div class="pe-header-actions ap-page-actions">
            <span class="pe-status-badge" id="peStatusBadge">
                <i class="bi bi-circle-fill"></i> Draft
            </span>
            <button type="button" class="pe-btn-primary" id="pePublishBtn">
                <i class="bi bi-rocket-takeoff"></i> Publish Widget
            </button>
        </div>
    </header>

    <!-- Widget selection -->
    <section class="pe-card pe-widget-selector">
        <div class="pe-widget-icon"><i class="bi bi-grid-1x2"></i></div>
        <div class="pe-widget-info">
            <label for="peWidgetSelect">Select widget</label>
            <select id="peWidgetSelect">
                <option value="pk_demo_sofa_finder">Sofa Finder Widget</option>
                <option value="pk_furniture_recommendation">Furniture Recommendation Widget</option>
                <option value="pk_demo_recommendation">Demo Recommendation Widget</option>
            </select>
            <small>Choose the widget you want to publish.</small>
        </div>
        <div class="pe-version">
            <span>Current version</span>
            <strong id="peVersion">v1.0.0</strong>
        </div>
    </section>

    <!-- Publishing overview -->
    <div class="pe-summary-grid">
        <div class="pe-summary-card">
            <div class="pe-summary-icon pe-green"><i class="bi bi-globe2"></i></div>
            <div>
                <span>Publishing status</span>
                <strong id="peSummaryStatus">Draft</strong>
                <small id="peStatusDescription">Not published yet</small>
            </div>
        </div>
        <div class="pe-summary-card">
            <div class="pe-summary-icon pe-blue"><i class="bi bi-code-slash"></i></div>
            <div>
                <span>Installation method</span>
                <strong id="peSummaryPlatform">Custom HTML</strong>
                <small>Copy and paste the embed code</small>
            </div>
        </div>
        <div class="pe-summary-card">
            <div class="pe-summary-icon pe-purple"><i class="bi bi-shield-check"></i></div>
            <div>
                <span>Allowed domains</span>
                <strong id="peDomainCount">2 domains</strong>
                <small>Mock security configuration</small>
            </div>
        </div>
    </div>

    <div class="pe-main-grid">

        <!-- INSTALLATION -->
        <section class="pe-card pe-install-card">
            <div class="pe-card-heading">
                <div>
                    <h5>Install your widget</h5>
                    <p>Choose your website platform and follow the instructions.</p>
                </div>
                <i class="bi bi-plug"></i>
            </div>

            <div class="pe-platform-tabs" role="tablist" aria-label="Website platform">
                <button type="button" class="pe-platform-tab active"
                        data-pe-platform="html" role="tab" aria-selected="true">
                    <i class="bi bi-code-square"></i> Custom HTML
                </button>
                <button type="button" class="pe-platform-tab"
                        data-pe-platform="wordpress" role="tab" aria-selected="false">
                    <i class="bi bi-wordpress"></i> WordPress
                </button>
                <button type="button" class="pe-platform-tab"
                        data-pe-platform="shopify" role="tab" aria-selected="false">
                    <i class="bi bi-bag"></i> Shopify
                </button>
                <button type="button" class="pe-platform-tab"
                        data-pe-platform="wix" role="tab" aria-selected="false">
                    <i class="bi bi-window"></i> Wix
                </button>
            </div>

            <div class="pe-instructions">
                <div class="pe-instruction-title">
                    <span class="pe-step-number">1</span>
                    <div>
                        <h6 id="peInstructionHeading">Copy your embed code</h6>
                        <p id="peInstructionDescription">
                            Copy the snippet below and add it to your website.
                        </p>
                    </div>
                </div>

                <div class="pe-code-heading">
                    <div>
                        <i class="bi bi-filetype-html"></i>
                        <span id="peCodeLabel">HTML embed snippet</span>
                    </div>
                    <button type="button" class="pe-copy-btn" id="peCopyCode">
                        <i class="bi bi-clipboard"></i> Copy code
                    </button>
                </div>

                <pre class="pe-code-block"><code id="peEmbedCode"></code></pre>

                <div class="pe-instruction-title pe-second-step">
                    <span class="pe-step-number">2</span>
                    <div>
                        <h6 id="peStepTwoHeading">Paste the code into your website</h6>
                        <p id="peStepTwoDescription">
                            Place the snippet before the closing body tag, then save your page.
                        </p>
                    </div>
                </div>

                <div class="pe-tip">
                    <i class="bi bi-lightbulb"></i>
                    <div>
                        <strong>Installation tip</strong>
                        <p id="peInstallTip">
                            Add the snippet once per website. The widget can then load wherever
                            the configured script is included.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- DOMAIN CONFIGURATION -->
        <section class="pe-card pe-domain-card">
            <div class="pe-card-heading">
                <div>
                    <h5>Allowed domains</h5>
                    <p>Manage the websites that may host this widget.</p>
                </div>
                <i class="bi bi-shield-lock"></i>
            </div>

            <div class="pe-security-note">
                <i class="bi bi-info-circle"></i>
                <span>Demo configuration only. Domain restrictions are not enforced yet.</span>
            </div>

            <form id="peDomainForm" class="pe-domain-form">
                <label for="peDomainInput">Add a website domain</label>
                <div class="pe-domain-input-row">
                    <input type="text" id="peDomainInput"
                           placeholder="example.com" maxlength="253"
                           autocomplete="off">
                    <button type="submit" class="pe-btn-primary pe-add-domain">
                        <i class="bi bi-plus-lg"></i> Add
                    </button>
                </div>
                <small>Enter a domain such as example.com, without a URL path.</small>
                <div class="pe-domain-error" id="peDomainError" role="alert"></div>
            </form>

            <div class="pe-domain-list-heading">
                <strong>Configured domains</strong>
                <span id="peDomainListCount">2</span>
            </div>

            <div class="pe-domain-list" id="peDomainList">
                <!-- Rendered by JavaScript -->
            </div>

            <div class="pe-domain-empty" id="peDomainEmpty" hidden>
                <i class="bi bi-globe"></i>
                <strong>No domains configured</strong>
                <span>Add a domain to your mock allowlist.</span>
            </div>
        </section>
    </div>

    <!-- FINAL CHECK -->
    <section class="pe-card pe-checklist-card">
        <div class="pe-card-heading">
            <div>
                <h5>Before you go live</h5>
                <p>Review these steps before installing the widget on your website.</p>
            </div>
            <i class="bi bi-check2-square"></i>
        </div>

        <div class="pe-checklist">
            <label class="pe-check-item">
                <input type="checkbox" id="peCheckContent">
                <span class="pe-custom-check"><i class="bi bi-check"></i></span>
                <span class="pe-check-copy">
                    <strong>Review your widget content</strong>
                    <small>Confirm your questions and recommendation items are ready.</small>
                </span>
            </label>
            <label class="pe-check-item">
                <input type="checkbox" id="peCheckDesign">
                <span class="pe-custom-check"><i class="bi bi-check"></i></span>
                <span class="pe-check-copy">
                    <strong>Review your widget design</strong>
                    <small>Check colors, typography, and mobile appearance.</small>
                </span>
            </label>
            <label class="pe-check-item">
                <input type="checkbox" id="peCheckInstall">
                <span class="pe-custom-check"><i class="bi bi-check"></i></span>
                <span class="pe-check-copy">
                    <strong>Prepare your installation</strong>
                    <small>Choose a platform and copy the relevant embed snippet.</small>
                </span>
            </label>
        </div>
    </section>

    <div class="pe-toast" id="peToast" role="status" aria-live="polite"></div>
</div>

 <link href="~/app_page_css/app_page_publish_embed_css.css" rel="stylesheet" />

  <script src="~/app_page_js/app_page_publish_embed_js.js" />


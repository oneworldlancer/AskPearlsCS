    /* Subscription modal: hide scrollbar, preserve scrolling and rounded corners */
    .account-settings-page .as-plans-modal {
        display: block;
        width: min(1180px, 100%);
        max-height: calc(100dvh - 32px);
        overflow-x: hidden;
        overflow-y: auto;
        /* Preserve rounded corners */
        border-radius: 18px;
        clip-path: inset(0 round 18px);
        background: var(--ap-card-bg, #fff);
        color: var(--ap-text, #17212b);
        /* Firefox */
        scrollbar-width: none;
        /* Legacy Microsoft browsers */
        -ms-overflow-style: none;
    }

        /* Chrome, Edge, Safari */
        .account-settings-page .as-plans-modal::-webkit-scrollbar {
            display: none;
            width: 0;
            height: 0;
        }

    /* Keep mobile scrolling and rounded corners */
    @@media (max-width: 575.98px) {
        .account-settings-page .as-plans-modal {
            width: 100%;
            max-height: calc(100dvh - 20px);
            border-radius: 16px;
            clip-path: inset(0 round 16px);
        }
    }



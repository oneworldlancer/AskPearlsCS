<!-- PAGE: ACCOUNT & SETTINGS -->
<div class="ap-page account-settings-page" data-ap-page="account-settings">
    @Html.AntiForgeryToken()
    <!-- Shared AskPearls breadcrumb -->
    <nav class="ap-breadcrumb" aria-label="Breadcrumb">
        <a href="/Dashboard">AskPearls</a>
        <span class="ap-breadcrumb-separator" aria-hidden="true">/</span>
        <span class="ap-breadcrumb-current" aria-current="page">Account &amp; Settings</span>
    </nav>


    <header class="ap-page-header as-page-header">
        <div>
            <h1 class="ap-page-title">Account &amp; Settings</h1>
            <p class="ap-page-description">Manage your profile, organization, and notification preferences.</p>
        </div>
        <div class="ap-page-actions as-header-actions">
            <span class="as-save-status" id="asSaveStatus">
                <i class="bi bi-circle-fill"></i> Unsaved changes
            </span>
            <button type="button" class="as-btn as-btn-outline" id="asReset">
                <i class="bi bi-arrow-counterclockwise"></i> Reset
            </button>
            <button type="button" class="as-btn as-btn-primary" id="asSave">
                <i class="bi bi-check-lg"></i> Save this step
            </button>
        </div>
    </header>

    <div class="as-layout">

        <!-- SETTINGS NAVIGATION -->
        <aside class="as-navigation">
            <div class="as-nav-profile">
                <div class="as-avatar" id="asAvatar">JD</div>
                <div class="as-profile-summary">
                    <strong id="asSidebarName">John Doe</strong>
                    <span id="asSidebarJobTitle">AskPearls Member</span>
                </div>
            </div>

            <div class="as-nav-label">ACCOUNT</div>

            <button type="button" class="as-nav-item active" data-as-section="profile">
                <i class="bi bi-person"></i>
                <span>Profile</span>
                <i class="bi bi-chevron-right as-nav-chevron"></i>
            </button>

            <button type="button" class="as-nav-item" data-as-section="organization">
                <i class="bi bi-building"></i>
                <span>Organization</span>
                <i class="bi bi-chevron-right as-nav-chevron"></i>
            </button>

            <button type="button" class="as-nav-item" data-as-section="companies">
                <i class="bi bi-buildings"></i>
                <span>Companies</span>
                <i class="bi bi-chevron-right as-nav-chevron"></i>
            </button>

            <div class="as-nav-label">NOTIFICATIONS</div>

            <button type="button" class="as-nav-item" data-as-section="notifications">
                <i class="bi bi-bell"></i>
                <span>Notifications</span>
                <i class="bi bi-chevron-right as-nav-chevron"></i>
            </button>

            <div class="as-nav-bottom">
                <i class="bi bi-info-circle"></i>
                <div>
                    <strong>Account settings</strong>
                    <p id="asNavBottomMessage">Loading your account settings.</p>
                </div>
            </div>
        </aside>

        <!-- SETTINGS CONTENT -->
        <main class="as-content">

            <!-- PROFILE -->
            <section class="as-panel active" data-as-panel="profile">
                <div class="as-panel-heading">
                    <div>
                        <h4>Personal profile</h4>
                        <p>Update your personal information and public profile details.</p>
                    </div>
                    <span class="as-heading-icon"><i class="bi bi-person-badge"></i></span>
                </div>

                <div class="as-panel-body">

                    <div class="as-avatar-editor">
                        <div class="as-avatar as-avatar-large" id="asLargeAvatar">JD</div>
                        <div>
                            <strong>Profile photo</strong>
                            <p>Your initials are displayed in this UI prototype.</p>
                            <span class="as-muted-note">Photo upload will be added during integration.</span>
                        </div>
                    </div>

                    <div class="as-form-grid">
                        <div class="as-field">
                            <label for="asFirstName">First name <span>*</span></label>
                            <input type="text" id="asFirstName" value="" maxlength="60" required>
                        </div>
                        <div class="as-field">
                            <label for="asLastName">Last name <span>*</span></label>
                            <input type="text" id="asLastName" value="" maxlength="60" required>
                        </div>
                        <div class="as-field">
                            <label for="asEmail">Email address <span>*</span></label>
                            <input type="email" id="asEmail" value="" readonly maxlength="150" required>
                            <small>Your sign-in email is managed by Google and cannot be changed here.</small>
                        </div>
                        <div class="as-field">
                            <label for="asJobTitle">Job title</label>
                            <input type="text" id="asJobTitle" value="" maxlength="100">
                        </div>
                        <div class="as-field as-field-full">
                            <label for="asBio">About</label>
                            <textarea id="asBio" rows="3" maxlength="500"
                                      placeholder="Tell us a little about yourself...">Building better customer experiences with AskPearls.</textarea>
                            <small>Maximum 500 characters.</small>
                        </div>
                    </div>
                </div>
            </section>

            <!-- ORGANIZATION -->
            <section class="as-panel" data-as-panel="organization" hidden>
                <div class="as-panel-heading">
                    <div>
                        <h4>Organization details</h4>
                        <p>Manage the company information associated with your workspace.</p>
                    </div>
                    <span class="as-heading-icon"><i class="bi bi-building"></i></span>
                </div>

                <div class="as-panel-body">

                    <div class="as-info-banner">
                        <i class="bi bi-info-circle"></i>
                        <span>Your organization details are saved to your AskPearls account.</span>
                    </div>

                 
                       
                    <!-- ORGANIZATION BRANDING -->
                    <div class="as-org-branding">
                        <div class="as-org-logo-preview" id="asOrgLogoPreview">
                            <span id="asOrgLogoInitials">AP</span>
                            <img id="asOrgLogoImage" alt="Organization logo preview" hidden>
                        </div>

                        <div class="as-org-branding-details">
                            <strong>Organization branding</strong>
                            <p>Personalize your workspace with your company logo.</p>

                            <div class="as-org-branding-actions">
                                <input type="url" id="asOrgLogoInput" class="as-logo-url-input"
                                       placeholder="https://example.com/logo.png"
                                       maxlength="500" aria-label="Organization logo URL">
                                <button type="button" class="as-btn as-btn-outline" id="asOrgLogoRemove">
                                    <i class="bi bi-trash3"></i> Remove
                                </button>
                            </div>
                            <small>Public HTTPS image URL only. No file upload.</small>
                            <small id="asOrgLogoMessage" role="status" aria-live="polite"></small>
                        </div>

                        <div class="as-org-brand-card">
                            <span class="as-org-brand-label">WORKSPACE PREVIEW</span>
                            <div class="as-org-brand-identity">
                                <div class="as-org-mini-logo" id="asOrgMiniLogo">AP</div>
                                <div>
                                    <strong id="asOrgPreviewName">AskPearls Limited</strong>
                                    <span>Organization workspace</span>
                                </div>
                            </div>
                        </div>
                    </div>









                    <div class="as-form-grid">
                        <div class="as-field as-field-full">
                            <label for="asCompanyName">Organization name <span>*</span></label>
                            <input type="text" id="asCompanyName" value="" maxlength="150" required>
                        </div>
                        <div class="as-field">
                            <label for="asWebsite">Organization website</label>
                            <input type="url" id="asWebsite" value="" maxlength="200">
                        </div>
                        <div class="as-field">
                            <label for="asIndustry">Industry</label>
                            <select id="asIndustry">
                                <option value="technology" selected>Technology / SaaS</option>
                                <option value="ecommerce">E-commerce &amp; Retail</option>
                                <option value="real-estate">Real Estate</option>
                                <option value="healthcare">Healthcare</option>
                                <option value="education">Education</option>
                                <option value="professional">Professional Services</option>
                                <option value="other">Other</option>
                            </select>
                        </div>
                    </div>
                </div>
            </section>


            <!-- COMPANIES: fully integrated, no separate partial required -->
<section class="as-panel" data-as-panel="companies" hidden>
    <div class="as-panel-heading"><div><h4>Companies</h4><p>Manage businesses belonging to your organization.</p></div><span class="as-heading-icon"><i class="bi bi-buildings"></i></span></div>
    <div class="as-panel-body">
        <div class="as-field"><label for="asCompanyOrganization">Organization</label><select id="asCompanyOrganization"></select></div>
        <div class="as-field" style="margin-top:18px"><label for="asCompanySelect">Companies</label><select id="asCompanySelect"><option value="">New company</option></select></div>
        <div class="as-form-grid" style="margin-top:20px">
            <div class="as-field as-field-full"><label for="asBusinessName">Company name *</label><input id="asBusinessName" maxlength="150" required></div>
            <div class="as-field"><label for="asBusinessWebsite">Website</label><input id="asBusinessWebsite" type="url" maxlength="200" placeholder="https://example.com"></div>
            <div class="as-field"><label for="asBusinessLogo">Logo HTTPS URL</label><input id="asBusinessLogo" type="url" maxlength="500"></div>
            <div class="as-field"><label for="asBusinessIndustry">Industry</label><select id="asBusinessIndustry"><option value="">Select</option><option value="technology">Technology / SaaS</option><option value="ecommerce">E-commerce &amp; Retail</option><option value="real-estate">Real Estate</option><option value="healthcare">Healthcare</option><option value="education">Education</option><option value="professional">Professional Services</option><option value="finance">Finance &amp; Insurance</option><option value="manufacturing">Manufacturing</option><option value="logistics">Logistics &amp; Transportation</option><option value="hospitality">Hospitality &amp; Tourism</option><option value="construction">Construction</option><option value="media">Media &amp; Entertainment</option><option value="agriculture">Agriculture</option><option value="nonprofit">Nonprofit</option><option value="other">Other</option></select></div>
            <div class="as-field"><label for="asBusinessSize">Company size</label><select id="asBusinessSize"><option value="">Select</option><option value="1">Just me</option><option value="2-10">2–10</option><option value="11-50">11–50</option><option value="51-200">51–200</option><option value="201+">201+</option></select></div>
            <div class="as-field"><label for="asBusinessCountry">Country</label><select id="asBusinessCountry"><option value="">Select</option><option value="EG">Egypt</option><option value="US">United States</option><option value="GB">United Kingdom</option><option value="CA">Canada</option><option value="DE">Germany</option><option value="FR">France</option><option value="NL">Netherlands</option><option value="SE">Sweden</option><option value="NO">Norway</option><option value="DK">Denmark</option><option value="CH">Switzerland</option><option value="BE">Belgium</option><option value="AE">United Arab Emirates</option><option value="SA">Saudi Arabia</option><option value="AU">Australia</option><option value="IN">India</option><option value="other">Other</option></select></div>
            <div class="as-field"><label for="asBusinessCity">City</label><input id="asBusinessCity" maxlength="100"></div>
            <div class="as-field"><label for="asBusinessEmail">Business email</label><input id="asBusinessEmail" maxlength="150"></div>
            <div class="as-field"><label for="asBusinessPhone">Business phone</label><input id="asBusinessPhone" maxlength="50"></div>
        </div>
        <div style="display:flex;gap:10px;justify-content:flex-end;margin-top:22px">
            <button type="button" class="as-btn as-btn-outline" id="asBusinessNew"><i class="bi bi-plus"></i> New company</button>
            <button type="button" class="as-btn as-btn-primary" id="asBusinessSave"><i class="bi bi-check-lg"></i> Save company</button>
        </div>
        <div id="asBusinessStatus" role="status" aria-live="polite" style="margin-top:12px"></div>
    </div>
</section>

            <!-- NOTIFICATIONS -->
            <section class="as-panel" data-as-panel="notifications" hidden>
                <div class="as-panel-heading">
                    <div>
                        <h4>Notifications</h4>
                        <p>Choose which updates you would like to receive.</p>
                    </div>
                    <span class="as-heading-icon"><i class="bi bi-bell"></i></span>
                </div>

                <div class="as-panel-body">

                    
                    <div class="as-setting-row as-notification-master">
                        <div class="as-setting-copy">
                            <strong>Non-essential notifications</strong>
                            <p>Control optional workspace updates and activity summaries.</p>
                            <span class="as-muted-note" id="asNotificationMasterStatus">
                                Optional notifications are enabled.
                            </span>
                        </div>

                        <label class="as-switch">
                            <input type="checkbox"
                                   id="asNonEssentialNotifications"
                                   checked>
                            <span class="as-switch-track"></span>
                        </label>
                    </div>


                    <div class="as-setting-row" data-nonessential="true">
                        <div class="as-setting-copy">
                            <strong>Email notifications</strong>
                            <p>Receive important account and workspace updates by email.</p>
                        </div>
                        <label class="as-switch">
                            <input type="checkbox" id="asEmailNotifications" checked>
                            <span class="as-switch-track"></span>
                        </label>
                    </div>

                    <div class="as-setting-row" data-nonessential="true">
                        <div class="as-setting-copy">
                            <strong>Widget activity reports</strong>
                            <p>Receive summaries about views, interactions, and completions.</p>
                        </div>
                        <label class="as-switch">
                            <input type="checkbox" id="asActivityReports" checked>
                            <span class="as-switch-track"></span>
                        </label>
                    </div>

                    <div class="as-setting-row" data-nonessential="true">
                        <div class="as-setting-copy">
                            <strong>Product updates</strong>
                            <p>Hear about new AskPearls features and improvements.</p>
                        </div>
                        <label class="as-switch">
                            <input type="checkbox" id="asProductUpdates">
                            <span class="as-switch-track"></span>
                        </label>
                    </div>

                    <div class="as-setting-row">
                        <div class="as-setting-copy">
                            <strong>Security alerts</strong>
                            <p>Get notified about important security-related events.</p>
                            <span class="as-muted-note">Security alerts remain enabled to protect your account.</span>
                        </div>
                        <label class="as-switch">
                            <input type="checkbox" id="asSecurityAlerts" checked disabled>
                            <span class="as-switch-track"></span>
                        </label>
                    </div>

                    <div class="as-info-banner">
                        <i class="bi bi-info-circle"></i>
                        <span>Your preferences are saved to your account. In-app alerts appear when supported AskPearls events occur. Email delivery requires a configured notification sender.</span>
                    </div>
                </div>
            </section>

            <!-- PLAN SUMMARY -->
            <section class="as-plan-card">
                <div class="as-plan-top">
                    <div class="as-plan-icon"><i class="bi bi-stars"></i></div>
                    <div class="as-plan-title">
                        <span>YOUR SUBSCRIPTION</span>
                        <h4><span id="asCurrentPlanName">Free Plan</span> <span class="as-plan-badge" id="asCurrentPlanBadge">Current</span></h4>
                        <p>A preview of your plan and resource usage.</p>
                    </div>
                </div>

                <div class="as-plan-usage">
                    <div class="as-usage-heading">
                        <span>Widgets created</span>
                        <strong><span id="asWidgetsUsed">0</span> <small>/ <span id="asWidgetsLimit">5</span></small></strong>
                    </div>
                    <div class="as-usage-track">
                        <div class="as-usage-fill" id="asUsageFill" style="width:0%"></div>
                    </div>
                    <div class="as-usage-foot">
                        <span id="asUsageSummary">Usage from your account</span>
                        <span id="asWidgetsRemaining">5 remaining</span>
                    </div>
                </div>

                <div class="as-plan-bottom">
                    <span><i class="bi bi-check-circle"></i> Core widget features</span>
                    <button type="button" class="as-btn as-btn-primary" id="asUpgradePlan">
                        Explore plans <i class="bi bi-arrow-right"></i>
                    </button>
                </div>
                <div class="as-plan-disclaimer" id="asSubscriptionNote">Subscription details are loaded from your account.</div>
            </section>

        </main>
    </div>

    
    <!-- SUBSCRIPTION PLANS MODAL -->
    <div class="as-modal-backdrop as-plans-backdrop" id="asPlansModal" hidden>
        <section class="as-modal as-plans-modal"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="asPlansModalTitle">

            <div class="as-modal-header">
                <div>
                    <h4 id="asPlansModalTitle">Choose your AskPearls plan</h4>
                    <p>Find the right plan for your growing business.</p>
                </div>
                <button type="button" class="as-modal-close"
                        id="asPlansClose" aria-label="Close plans">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="as-plans-intro">
                <span class="as-plans-kicker">
                    <i class="bi bi-stars"></i> SIMPLE, FLEXIBLE PRICING
                </span>
                <h3>Grow at your own pace</h3>
                <p>Start free and explore more capabilities as you grow.</p>
                <span class="as-plans-demo-note">
                    <i class="bi bi-info-circle"></i>
                    Demo pricing only — not live offers.
                </span>
            </div>

            <div class="as-plans-grid">

                <!-- FREE -->
                <article class="as-plan-option" data-plan="Free">
                    <div class="as-plan-option-top">
                        <span class="as-plan-name">Free</span>
                        <span class="as-plan-current">Current plan</span>
                    </div>
                    <div class="as-plan-price">
                        <strong>$0</strong><span>/ month</span>
                    </div>
                    <p class="as-plan-description">
                        Explore the essentials and build your first widgets.
                    </p>
                    <button type="button"
                            class="as-btn as-btn-outline as-plan-select"
                            data-select-plan="Free"
                            disabled>
                        Your current plan
                    </button>
                    <div class="as-plan-divider"></div>
                    <ul class="as-plan-features">
                        <li><i class="bi bi-check-circle-fill"></i> Up to 5 widgets</li>
                        <li><i class="bi bi-check-circle-fill"></i> Core widget features</li>
                        <li><i class="bi bi-check-circle-fill"></i> Basic customization</li>
                        <li><i class="bi bi-check-circle-fill"></i> Basic analytics</li>
                        <li class="as-feature-muted"><i class="bi bi-dash-circle"></i> Priority support</li>
                    </ul>
                </article>

                <!-- STARTER -->
                <article class="as-plan-option" data-plan="Starter">
                    <div class="as-plan-option-top">
                        <span class="as-plan-name">Starter</span>
                    </div>
                    <div class="as-plan-price">
                        <strong>$19</strong><span>/ month</span>
                    </div>
                    <p class="as-plan-description">
                        A practical next step for a small, growing business.
                    </p>
                    <button type="button"
                            class="as-btn as-btn-outline as-plan-select"
                            data-select-plan="Starter">
                        Choose Starter
                    </button>
                    <div class="as-plan-divider"></div>
                    <ul class="as-plan-features">
                        <li><i class="bi bi-check-circle-fill"></i> Up to 10 widgets</li>
                        <li><i class="bi bi-check-circle-fill"></i> Core widget features</li>
                        <li><i class="bi bi-check-circle-fill"></i> Standard customization</li>
                        <li><i class="bi bi-check-circle-fill"></i> Basic analytics</li>
                        <li class="as-feature-muted"><i class="bi bi-dash-circle"></i> Priority support</li>
                    </ul>
                </article>

                <!-- PROFESSIONAL -->
                <article class="as-plan-option as-plan-featured" data-plan="Professional">
                    <span class="as-plan-popular">POPULAR</span>
                    <div class="as-plan-option-top">
                        <span class="as-plan-name">Professional</span>
                    </div>
                    <div class="as-plan-price">
                        <strong>$49</strong><span>/ month</span>
                    </div>
                    <p class="as-plan-description">
                        More control and insights for established teams.
                    </p>
                    <button type="button"
                            class="as-btn as-btn-primary as-plan-select"
                            data-select-plan="Professional">
                        Choose Professional
                    </button>
                    <div class="as-plan-divider"></div>
                    <ul class="as-plan-features">
                        <li><i class="bi bi-check-circle-fill"></i> Up to 25 widgets</li>
                        <li><i class="bi bi-check-circle-fill"></i> Core widget features</li>
                        <li><i class="bi bi-check-circle-fill"></i> Advanced customization</li>
                        <li><i class="bi bi-check-circle-fill"></i> Advanced analytics</li>
                        <li><i class="bi bi-check-circle-fill"></i> Priority support</li>
                    </ul>
                </article>

                <!-- PREMIUM -->
                <article class="as-plan-option" data-plan="Premium">
                    <div class="as-plan-option-top">
                        <span class="as-plan-name">Premium</span>
                    </div>
                    <div class="as-plan-price">
                        <strong>$99</strong><span>/ month</span>
                    </div>
                    <p class="as-plan-description">
                        A comprehensive feature set for ambitious businesses.
                    </p>
                    <button type="button"
                            class="as-btn as-btn-outline as-plan-select"
                            data-select-plan="Premium">
                        Choose Premium
                    </button>
                    <div class="as-plan-divider"></div>
                    <ul class="as-plan-features">
                        <li><i class="bi bi-check-circle-fill"></i> Unlimited widgets</li>
                        <li><i class="bi bi-check-circle-fill"></i> Core widget features</li>
                        <li><i class="bi bi-check-circle-fill"></i> Full customization</li>
                        <li><i class="bi bi-check-circle-fill"></i> Advanced analytics</li>
                        <li><i class="bi bi-check-circle-fill"></i> Priority support</li>
                    </ul>
                </article>
            </div>

            <div class="as-plan-confirmation" id="asPlanConfirmation" hidden>
                <div class="as-plan-confirmation-icon">
                    <i class="bi bi-check2-circle"></i>
                </div>
                <div class="as-plan-confirmation-copy">
                    <strong id="asPlanConfirmationTitle">Confirm plan selection</strong>
                    <p id="asPlanConfirmationText"></p>
                </div>
                <button type="button" class="as-btn as-btn-primary"
                        id="asPlanConfirm">
                    Confirm demo
                </button>
                <button type="button" class="as-btn as-btn-outline"
                        id="asPlanCancel">
                    Cancel
                </button>
            </div>

            <div class="as-plans-footer">
                <span>
                    <i class="bi bi-shield-check"></i>
                    No payment will be collected in this prototype.
                </span>
                <button type="button" class="as-btn as-btn-outline"
                        id="asPlansDone">
                    Close
                </button>
            </div>
        </section>
    </div>






    <div class="as-toast" id="asToast" role="status" aria-live="polite"></div>
</div>
<link href="~/app_page_css/app_page_account_settings_css.css?v=20261115-2" rel="stylesheet" />
<script src="~/app_js/app_input_value_helper.js?v=20261115-1"></script>
<script src="~/app_page_js/app_page_account_settings_js.js?v=20261115-2"></script>
<script src="~/app_page_js/app_page_account_companies_js.js?v=20261115-4"></script>

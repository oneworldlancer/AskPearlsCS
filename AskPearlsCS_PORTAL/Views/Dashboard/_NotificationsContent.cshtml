<div class="ap-page ap-notifications-page" data-ap-page="notifications">
    @Html.AntiForgeryToken()
    <nav class="ap-breadcrumb" aria-label="Breadcrumb"><a href="/Dashboard">AskPearls</a><span class="ap-breadcrumb-separator">/</span><span class="ap-breadcrumb-current">Notifications</span></nav>
    <header class="ap-notifications-heading">
        <div><h1 class="ap-page-title">My Notifications</h1><p class="ap-page-description">Updates from your AskPearls workspace.</p></div>
        <button type="button" class="ap-n-btn" id="apNotifMarkAll"><i class="bi bi-check2-all"></i> Mark all as read</button>
    </header>
    <div class="ap-notifications-toolbar" role="group" aria-label="Filter notifications">
        <button type="button" class="ap-n-tab active" data-notification-filter="all" aria-pressed="true">All</button>
        <button type="button" class="ap-n-tab" data-notification-filter="unread" aria-pressed="false">Unread</button>
        <button type="button" class="ap-n-tab" data-notification-filter="read" aria-pressed="false">Read</button>
        <span class="ap-n-count" id="apNotifSummary" aria-live="polite"></span>
    </div>
    <div id="apNotifError" class="ap-n-error" role="alert" hidden></div>
    <div id="apNotifList" class="ap-n-list" aria-live="polite"><div class="ap-n-empty">Loading notifications…</div></div>
    <div class="ap-n-pagination">
        <button type="button" class="ap-n-btn" id="apNotifPrev">Previous</button><span id="apNotifPageLabel"></span><button type="button" class="ap-n-btn" id="apNotifNext">Next</button>
    </div>
</div>

<!-- Only ONE modal. Keep inside the AJAX-loaded notifications partial. -->
<div class="modal fade ap-notification-modal" id="apNotificationReader" tabindex="-1" aria-labelledby="apNotificationReaderTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <div class="min-w-0">
                    <div class="ap-n-reader-kicker"><i class="bi bi-stars"></i> ASKPEARLS PORTAL</div>
                    <h2 class="modal-title" id="apNotificationReaderTitle">Notification</h2>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body ap-n-reader-scroll">
                <section id="apNotificationReadPanel">
                    <div class="ap-n-reader-meta" id="apNotificationReaderMeta"></div>
                    <div class="ap-n-reader-message" id="apNotificationReaderMessage"></div>
                </section>
                <section id="apNotificationSupportPanel" hidden>
                    <h3 class="ap-n-support-heading">Contact AskPearls support</h3>
                    <p class="ap-n-support-description">Tell us what you need help with. Our team will get back to you by email.</p>
                    <form id="apNotificationSupportForm" class="ap-n-support-form">
                        @* Account identity is resolved server-side from the authenticated Google session.
                           Do not send user name/email from browser form inputs. *@
                        <div class="ap-n-account-identity" role="note">
                            <i class="bi bi-person-check" aria-hidden="true"></i>
                            <div>
                                <strong>Sending as @((User.FindFirst("name")?.Value ?? User.Identity?.Name) ?? "your AskPearls account")</strong>
                                <span>We'll reply to your signed-in Google email: @(User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? User.FindFirst("email")?.Value ?? "your registered account email")</span>
                            </div>
                        </div>
                        <label for="apNotificationSupportSubject">Subject</label>
                        <input id="apNotificationSupportSubject" name="subject" type="text" maxlength="200" placeholder="What is your request about?" required />
                        <label for="apNotificationSupportMessage">How can we help?</label>
                        <textarea id="apNotificationSupportMessage" name="message" rows="6" maxlength="10000" placeholder="Describe the issue or question…" required></textarea>
                        <p class="ap-n-support-note"><i class="bi bi-info-circle"></i> Please don't include passwords or sensitive information.</p>
                        <p class="ap-n-support-note">Support mailbox: <strong>HelpDesk@AskPearls.com</strong></p>
                        <p class="ap-n-support-status" id="apNotificationSupportStatus" role="status" aria-live="polite"></p>
                    </form>
                </section>
            </div>
            <div class="modal-footer" id="apNotificationReadFooter">
                <button type="button" class="ap-n-btn ap-n-primary" data-n-contact><i class="bi bi-envelope"></i> Contact Support</button>
                <a class="ap-n-btn ap-n-support-link" id="apNotificationReaderAction" href="#" hidden><i class="bi bi-box-arrow-up-right"></i> Open related page</a>
                <button type="button" class="ap-n-btn" data-bs-dismiss="modal">Close</button>
            </div>
            <div class="modal-footer" id="apNotificationSupportFooter" hidden>
                <button type="button" class="ap-n-btn" data-n-back><i class="bi bi-arrow-left"></i> Back to notification</button>
                <button type="submit" class="ap-n-btn ap-n-primary" form="apNotificationSupportForm" id="apNotificationSupportSubmit"><i class="bi bi-send"></i> Send support request</button>
                <button type="button" class="ap-n-btn" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

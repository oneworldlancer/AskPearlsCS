    <style>





/* ==========================================
   FIX: Sidebar footer remains visible
   ========================================== */

#askPearlsSidebar.ap-sidebar {
    position: fixed;
    top: var(--header-height, 64px);
    /* bottom: 50px; */ /* Height of your green portal footer */
    left: 0;

/*     width: 290px;
    min-width: 290px; */
    height: auto;
    min-height: 0;

    display: flex;
    flex-direction: column;

    overflow: hidden;
    box-sizing: border-box;
    z-index: 900;

    background: #071f25;
}

/* Only the agents and Account & Settings scroll */
#askPearlsSidebar .ap-sidebar-scroll {
    flex: 1 1 0;
    min-height: 0;
    height: 0;

    overflow-x: hidden;
    overflow-y: auto;

    overscroll-behavior: contain;
}

/* Keep attribution outside the scrolling area */
#askPearlsSidebar .ap-sidebar-footer {
    position: relative;
    flex: 0 0 auto;

    width: 100%;
    min-height: 46px;
    padding: 13px 8px;

    box-sizing: border-box;
    background: #071f25;
    border-top: 1px solid #24434a;

    color: #a7bdc3;
    font-size: 11px;
    text-align: center;
}

/* Attribution link */
#askPearlsSidebar .ap-sidebar-footer a {
    color: inherit;
    text-decoration: underline;
}

/* Keep the header above the sidebar */
.header {
    z-index: 1000;
}

/* Adjust sidebar width on smaller screens */
@@media (max-width: 767.98px) {
    #askPearlsSidebar.ap-sidebar {
        width: 270px;
        min-width: 270px;
    }
}



.ap-sidebar-heading {
    padding: 17px 20px 12px;
    color: var(--ap-sidebar-muted);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.2px;
}

.ap-agent-accordion {
    padding: 0 9px;
}

.ap-agent-accordion .accordion-item {
    margin-bottom: 7px;
    overflow: hidden;
    border: 1px solid transparent;
    border-radius: 9px;
    background: transparent;
}

.ap-agent-header,
.ap-agent-accordion .accordion-button {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    min-height: 63px;
    padding: 10px 12px;
    border: 0;
    border-radius: 8px !important;
    background: var(--ap-sidebar-panel);
    color: var(--ap-sidebar-text);
    text-align: left;
    box-shadow: none;
}

.ap-agent-header::after {
    width: 12px;
    height: 12px;
    margin-left: 8px;
    background-size: 12px;
    filter: brightness(0) invert(1);
    opacity: 0.8;
}

.ap-agent-header:focus {
    box-shadow: none;
}

.ap-agent-icon {
    display: inline-flex;
    flex: 0 0 34px;
    align-items: center;
    justify-content: center;
    font-size: 25px;
}

.ap-agent-info {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
    gap: 4px;
}

.ap-agent-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 6px;
}

.ap-agent-title {
    color: inherit;
    font-size: 14px;
    font-weight: 700;
}

.ap-agent-description {
    color: var(--ap-sidebar-muted);
    font-size: 11px;
    line-height: 1.4;
}

/* Active DecisionOS */
.ap-agent-active {
    border-color: rgba(37, 211, 102, 0.35) !important;
    border-left: 3px solid var(--ap-green) !important;
    background: rgba(37, 211, 102, 0.035) !important;
}

.ap-agent-active > .accordion-header > .ap-agent-header,
.ap-agent-active > .accordion-header > .accordion-button {
    background: linear-gradient(
        110deg,
        rgba(37, 211, 102, 0.19),
        rgba(37, 211, 102, 0.06)
    );
    color: #ffffff;
}

.ap-agent-active .ap-agent-icon {
    color: #b8ffd0;
}

.ap-status {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 4px 8px;
    border-radius: 20px;
    font-size: 9px;
    font-weight: 800;
    line-height: 1.2;
    white-space: nowrap;
}

.ap-status-active {
    background: var(--ap-green);
    color: #063c24;
}

.ap-status-soon {
    background: #52666f;
    color: #ffffff;
}

/* DecisionOS submenu */
.ap-agent-body {
    padding: 4px 8px 8px;
    background: transparent;
}

.ap-agent-navigation {
    display: flex;
    flex-direction: column;
    gap: 3px;
}

.ap-nav-link {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 35px;
    padding: 8px 12px;
    border-radius: 6px;
    color: var(--ap-sidebar-text);
    font-size: 12px;
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease;
}

.ap-nav-link > i {
    display: inline-flex;
    width: 17px;
    justify-content: center;
    font-size: 15px;
}

.ap-nav-link:hover {
    background: rgba(255, 255, 255, 0.07);
    color: #ffffff;
}

.ap-nav-link.active {
    background: linear-gradient(
        90deg,
        rgba(37, 211, 102, 0.25),
        rgba(37, 211, 102, 0.12)
    );
    color: #ffffff;
}

.ap-nav-link.active > i {
    color: var(--ap-green);
}

/* Future agents: visible but unavailable */
.ap-agent-disabled > .accordion-header > .ap-agent-header,
.ap-agent-disabled > .accordion-header > .accordion-button {
    cursor: not-allowed;
    opacity: 0.9;
    background: #102932;
}

.ap-agent-disabled .ap-agent-icon {
    color: #a9c0c6;
}

.ap-agent-disabled .ap-agent-title {
    color: #d6e2e5;
}

.ap-agent-disabled .ap-agent-description {
    color: #9ab0b7;
}

.ap-agent-disabled .ap-status-soon {
    background: #536a73;
}

/* Account settings */
.ap-sidebar-bottom {
    margin-top: auto;
    padding: 10px 9px;
    border-top: 1px solid var(--ap-sidebar-border);
}

.ap-settings-link {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px;
    border-radius: 7px;
    color: var(--ap-sidebar-text);
    font-size: 13px;
    text-decoration: none;
}

.ap-settings-link > i:first-child {
    font-size: 19px;
}

.ap-settings-link:hover {
    background: rgba(255, 255, 255, 0.06);
    color: #ffffff;
}

.ap-settings-arrow {
    margin-left: auto;
    font-size: 12px;
}

/* Sidebar footer */
.ap-sidebar-footer {
    padding: 13px 8px;
    border-top: 1px solid var(--ap-sidebar-border);
    color: var(--ap-sidebar-muted);
    font-size: 11px;
    text-align: center;
}

.ap-sidebar-footer a {
    color: inherit;
    text-decoration: underline;
}

/* Narrow screens */
@@media (max-width: 767.98px) {
    .ap-sidebar {
        width: 270px;
        min-width: 270px;
    }
}


/* =========================================
   AskPearls Agent Sidebar
   ========================================= */

    
/* ==========================================
   FIX: DecisionOS ACTIVE badge in both themes
   ========================================== */

#askPearlsSidebar .ap-agent-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: nowrap;
    gap: 8px;
    min-width: 0;
}

#askPearlsSidebar .ap-agent-title {
    flex: 1 1 auto;
    min-width: 0;
    color: inherit;
    font-weight: 700;
    line-height: 1.3;
}

#askPearlsSidebar .ap-status.ap-status-active {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;

    padding: 4px 9px;
    min-height: 20px;
    border: 0;
    border-radius: 999px;

    background-color: #25D366 !important;
    color: #063B22 !important;

    font-size: 9px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0.3px;
    white-space: nowrap;
    opacity: 1;
    visibility: visible;
}

/* Keep the badge readable in dark theme */
[data-bs-theme="dark"] #askPearlsSidebar .ap-status.ap-status-active,
.dark-theme #askPearlsSidebar .ap-status.ap-status-active {
    background-color: #25D366 !important;
    color: #063B22 !important;
}

/* Keep the badge readable in light theme */
[data-bs-theme="light"] #askPearlsSidebar .ap-status.ap-status-active,
.light-theme #askPearlsSidebar .ap-status.ap-status-active {
    background-color: #25D366 !important;
    color: #063B22 !important;
}

/* Allow the title and badge to fit on narrower screens */
@@media (max-width: 350px) {
    #askPearlsSidebar .ap-agent-title-row {
        flex-wrap: wrap;
        justify-content: flex-start;
    }
}

  
/* Fix title/badge overlap for future agents */
#askPearlsSidebar .ap-agent-disabled .ap-agent-title-row {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    flex-wrap: nowrap;
    gap: 5px;
}

#askPearlsSidebar .ap-agent-disabled .ap-agent-title {
    display: block;
    max-width: 100%;
    line-height: 1.3;
}

#askPearlsSidebar .ap-agent-disabled .ap-status.ap-status-soon {
    display: inline-flex;
    position: static;
    flex: 0 0 auto;
    align-self: flex-start;
    margin: 0;
    transform: none;
    white-space: nowrap;
    line-height: 1.2;
}

/* Keep DecisionOS ACTIVE on the title row */
#askPearlsSidebar .ap-agent-active .ap-agent-title-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
}

#askPearlsSidebar .ap-agent-active .ap-status.ap-status-active {
    flex: 0 0 auto;
    white-space: nowrap;
}










        color: var(--ap-text, var(--bs-body-color, #17212b));
        font-size: 11px;
    }

    .publish-embed-page .pe-domain-list-heading span {
        display: grid;
        place-items: center;
        min-width: 24px;
        height: 24px;
        padding: 0 7px;
        border-radius: 20px;
        background: rgba(13,168,139,.12);
        color: #0d9278;
        font-size: 10px;
        font-weight: 800;
    }

    .publish-embed-page .pe-domain-list { padding: 0 18px 18px; }

    .publish-embed-page .pe-domain-row {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 0;
        border-bottom: 1px solid var(--ap-border, var(--bs-border-color, #e2e8f0));
    }

    .publish-embed-page .pe-domain-row:last-child { border-bottom: 0; }

    .publish-embed-page .pe-domain-icon {
        display: grid;

            /* Test Rule preview */
            .decision-rules-page .dr-test-panel {
                margin: 20px 0;
                padding: 18px;
                border: 1px solid var(--ap-border, #dbe3ed);
                border-radius: 14px;
                background: var(--ap-card-bg, #f8fafc);
                color: var(--ap-text, #172033);
            }

            .decision-rules-page .dr-test-heading {
                display: flex;
                align-items: flex-start;
                justify-content: space-between;
                gap: 12px;
                margin-bottom: 16px;
            }

            .decision-rules-page .dr-test-heading h4 {
                margin: 0 0 6px;
                color: var(--ap-text, #172033);
                font-size: 16px;
                font-weight: 700;
            }

            .decision-rules-page .dr-test-heading p {
                margin: 0;
                color: var(--ap-muted, #64748b);
                font-size: 13px;
                line-height: 1.5;
            }

            .decision-rules-page .dr-test-badge {
                flex-shrink: 0;
                padding: 5px 9px;
                border-radius: 20px;
                background: #e0f2fe;
                color: #075985;
                font-size: 11px;
                font-weight: 700;
            }

            .decision-rules-page .dr-test-grid {
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 0 16px;
            }

            .decision-rules-page .dr-test-grid .dr-field {
                margin-bottom: 12px;
            }

            .decision-rules-page .dr-test-result {
                margin-top: 14px;
                padding: 14px;
                border: 1px solid var(--ap-border, #dbe3ed);
                border-radius: 10px;
                background: var(--ap-surface-soft, #f8fafc);
                color: var(--ap-text, #172033);
            }

            .decision-rules-page .dr-test-result[hidden] {
                display: none !important;
            }

            .decision-rules-page .dr-test-result.is-match {
                background: #ecfdf5;
                border-color: #86efac;
                color: #065f46;
            }

            .decision-rules-page .dr-test-result.is-no-match {
                background: #fff7ed;
                border-color: #fdba74;
                color: #9a3412;
            }

            .decision-rules-page .dr-test-result h5 {
                margin: 0 0 8px;
                font-size: 14px;
                font-weight: 700;
            }

            .decision-rules-page .dr-test-result ul {
                margin: 8px 0 0;
                padding-left: 20px;
            }

            .decision-rules-page .dr-test-result li {
                margin: 5px 0;
                font-size: 13px;
            }

            /* Dark theme */
            :is(
                html[data-theme="dark"],
                body[data-theme="dark"],
                html[data-bs-theme="dark"],
                body[data-bs-theme="dark"],
                html.dark,
                body.dark,

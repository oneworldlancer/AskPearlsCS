                body.dark-mode,
                .dark-theme,
                .theme-dark
            ) .decision-rules-page .dr-test-result {
                background: #10221c;
                border-color: #344d44;
                color: #e6edf5;
            }

            @@media (max-width: 600px) {
                .decision-rules-page .dr-test-grid {
                    grid-template-columns: 1fr;
                }

                .decision-rules-page .dr-test-heading {
                    flex-direction: column;
                }

@{
    Layout = null;
}
<!doctype html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#04110e" />
    <title>Welcome to AskPearls</title>
    <link href="~/app_page_css/app_page_index_2_css.css" rel="stylesheet" />
    <link href="~/app_css/app_page_signin_info_modal_css.css" rel="stylesheet" />
    <script src="~/app_page_js/app_page_index_js.js" defer></script>
</head>
<body>
    <div class="sign-in-page">
        <header class="topbar">
            <a class="brand" href="/" aria-label="AskPearls home">
                <img src="/app_img/img_logo_color.png" alt="" class="brand-mark" />
                <span class="brand-copy"><strong>AskPearls</strong><small>Capture. Engage. Convert.</small></span>
            </a>
            <nav class="top-actions" aria-label="Page options">
                <button class="help-link" type="button" data-info-open="help" aria-label="Open Help Center"><span class="help-mark" aria-hidden="true">?</span>Help</button>
                <button class="theme-toggle" id="theme-toggle" type="button" data-theme-toggle aria-label="Switch to light theme" title="Switch theme">
                    <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"></path></svg>
                    <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 15.5A8.5 8.5 0 0 1 8.5 3.5 8.5 8.5 0 1 0 20.5 15.5Z"></path></svg>
                </button>
            </nav>
        </header>

        <main class="main-content">
            <section class="brand-story" aria-labelledby="story-title">
                <div class="network-art" aria-hidden="true">
                    <span class="network-orbit orbit-one"></span><span class="network-orbit orbit-two"></span>
                    <span class="network-node node-top">AP</span>
                    <span class="network-node node-chat">•••</span><span class="network-node node-list">▤</span>
                    <span class="network-node node-chart">▥</span><span class="network-node node-team">♙</span>
                </div>
                <p class="eyebrow">WELCOME TO ASKPEARLS</p>
                <h1 id="story-title">Your workspace<br /><span>starts here.</span></h1>
                <p class="story-copy">One secure Google sign-in for every AskPearls tool.</p>
                <div class="feature-list">
                    <article class="feature-item">
                        <span class="feature-icon" aria-hidden="true">⌘</span>
                        <div><h2>DecisionOS</h2><p>Turn website visitors into confident buyers with guided decisions and recommendations.</p></div>
                    </article>
                    <article class="feature-item">
                        <span class="feature-icon" aria-hidden="true">♧</span>
                        <div><h2>Customer engagement</h2><p>Capture questions, understand intent, and deliver personalized experiences.</p></div>
                    </article>
                    <article class="feature-item">
                        <span class="feature-icon" aria-hidden="true">▥</span>
                        <div><h2>Insights &amp; analytics</h2><p>See what matters, track performance, and continuously improve.</p></div>
                    </article>
                </div>
            </section>

            <section class="auth-column" aria-labelledby="auth-title">
                <div class="auth-card" id="google-auth-card" data-google-auth-url="/Home/GoogleLogin">
                    <p class="card-kicker">ASKPEARLS DEVELOPMENT PORTAL</p>
                    <h2 id="auth-title">Sign in to AskPearls</h2>
                    <p class="auth-description">Continue with your Google account.<br />New users are set up automatically.</p>
                    <button class="google-button" id="google-signin" type="button" data-google-signin>
                        <svg viewBox="0 0 48 48" aria-hidden="true"><path fill="#FFC107" d="M43.6 24.5c0-1.6-.1-3.1-.4-4.5H24v8.5h11a9.4 9.4 0 0 1-4.1 6.2v5.2h6.7c3.9-3.6 6-8.9 6-15.4Z" /><path fill="#FF3D00" d="M24 44c5.5 0 10.1-1.8 13.5-4.9l-6.7-5.2c-1.8 1.2-4.1 2-6.8 2-5.2 0-9.7-3.5-11.3-8.2H5.8v5.4A20 20 0 0 0 24 44Z" /><path fill="#4CAF50" d="M12.7 27.7a12 12 0 0 1 0-7.4v-5.4H5.8a20 20 0 0 0 0 18.2l6.9-5.4Z" /><path fill="#1976D2" d="M24 12.1c3 0 5.6 1 7.7 3.1l5.8-5.8C34 6.1 29.4 4 24 4A20 20 0 0 0 5.8 14.9l6.9 5.4c1.6-4.7 6.1-8.2 11.3-8.2Z" /></svg>
                        <span>Continue with Google</span>
                    </button>
                    <p class="auth-message" id="auth-message" data-auth-message role="status" aria-live="polite"></p>
                    <div class="trust-note"><span aria-hidden="true">◇</span><p>We only access your name, email, and basic profile from Google to create your account and provide our services.</p></div>
                    <p class="legal-copy">By continuing, you agree to our<br /><button class="legal-trigger" type="button" data-info-open="terms">Terms of Service</button> and <button class="legal-trigger" type="button" data-info-open="privacy">Privacy Policy</button>.</p>
                </div>
            </section>
        </main>

        <partial name="_SignInInfoModal" />
        <partial name="_IndexFooterModel" />
    </div>
</body>
</html>

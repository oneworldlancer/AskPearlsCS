@{
    Layout = null;
}
<!doctype html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5faf7" />
    <title>AskPearls | Your ideas take flight</title>
    <link rel="stylesheet" href="~/app_css/app_page_index_concepts_shared_css.css?v=2" />
    <link rel="stylesheet" href="~/app_page_css/app_page_index_12_css.css?v=4" />
    <link rel="stylesheet" href="~/app_css/app_page_signin_info_modal_css.css" />
    <script src="~/app_page_js/app_page_index_js.js" defer></script>
</head>
<body>
    <div class="concept-page concept-12">
        <header class="concept-header"><a class="concept-brand" href="/" aria-label="AskPearls home"><img src="/app_img/img_logo_color.png" alt="" /><span><strong>AskPearls</strong><small>Capture. Engage. Convert.</small></span></a><nav class="concept-actions" aria-label="Page options"><button class="concept-help" type="button" data-info-open="help"><span class="help-ring">?</span>Help</button><button class="concept-theme" id="theme-toggle" type="button" data-theme-toggle aria-label="Switch to dark theme" title="Switch theme"><svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l-1.42-1.42m11.3-11.3 1.42-1.42" /></svg><svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 15.5A8.5 8.5 0 0 1 8.5 3.5 8.5 8.5 0 1 0 20.5 15.5Z" /></svg></button></nav></header>
        <main class="concept-main">
            <section class="concept-story" aria-labelledby="concept-title">
                <div class="concept-copy"><p class="concept-kicker">FROM FIRST THOUGHT TO WHAT’S NEXT</p><h1 id="concept-title">Your ideas<br />take <em>flight.</em></h1><p class="concept-description">Turn a simple question into a clear plan, with insights that move you forward.</p></div><div class="concept-art flight-world" role="img" aria-label="An open idea journal sends a paper plane along a glowing path toward a bright horizon">
                <svg class="flight-scene" viewBox="0 0 900 420" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <defs>
                        <radialGradient id="flightGlow"><stop stop-color="#83edc2" stop-opacity=".58" /><stop offset="1" stop-color="#83edc2" stop-opacity="0" /></radialGradient>
                        <linearGradient id="flightHill" x1="0" y1="0" x2="1" y2="1"><stop stop-color="var(--surface2,#edf7f1)" /><stop offset="1" stop-color="var(--glow,#b9ecd6)" /></linearGradient>
                        <linearGradient id="flightPlane" x1="0" y1="0" x2="1" y2="1"><stop stop-color="var(--surface,#fff)" /><stop offset=".48" stop-color="var(--glow,#b9ecd6)" /><stop offset="1" stop-color="var(--accent2,#20ba83)" /></linearGradient>
                        <filter id="flightShadow" x="-40%" y="-40%" width="180%" height="180%"><feDropShadow dx="0" dy="12" stdDeviation="10" flood-color="#176747" flood-opacity=".18" /></filter>
                    </defs>
                    <ellipse cx="530" cy="270" rx="380" ry="170" fill="url(#flightGlow)" />
                    <path d="M0 326 Q145 268 286 310 T566 293 T900 300 V420 H0Z" fill="url(#flightHill)" opacity=".72" />
                    <path d="M0 354 Q168 298 304 344 T603 323 T900 326" fill="none" stroke="#fff" stroke-opacity=".76" stroke-width="3" />
                    <path d="M40 350 C210 320 258 248 386 236 S603 214 760 84" fill="none" stroke="#48c997" stroke-opacity=".25" stroke-width="28" stroke-linecap="round" />
                    <path d="M40 350 C210 320 258 248 386 236 S603 214 760 84" fill="none" stroke="#159d68" stroke-opacity=".72" stroke-width="2" stroke-dasharray="4 10" stroke-linecap="round" />
                    <g class="flight-journal" filter="url(#flightShadow)">
                        <path d="M94 280 Q158 259 223 282 L226 367 Q160 343 98 366Z" fill="#fffdf5" stroke="#b7dcca" stroke-width="2" />
                        <path d="M223 282 Q278 255 340 270 L335 358 Q278 345 226 367Z" fill="#fff" stroke="#b7dcca" stroke-width="2" />
                        <path d="M223 282 226 367" stroke="#8bc8a8" stroke-width="2" />
                        <path d="M119 300l15-7 12 8-15 7z" fill="#27a875" /><path d="M151 301h51M151 311h48M246 294h65M246 305h56M246 316h60" stroke="#90bba4" stroke-width="4" stroke-linecap="round" />
                        <text x="119" y="333" fill="#236447" font-family="Georgia,serif" font-size="15">A good question</text>
                    </g>
                    <g class="flight-note" transform="rotate(-8 373 146)" filter="url(#flightShadow)">
                        <rect x="322" y="116" width="116" height="61" rx="12" fill="var(--surface,#fff)" stroke="#9bd6b8" stroke-width="2" /><circle cx="345" cy="146" r="12" fill="#dff7eb" /><path d="m341 146 3 3 6-7" fill="none" stroke="#078650" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" /><text x="365" y="143" fill="var(--text,#122e26)" font-family="Inter,Arial,sans-serif" font-size="12" font-weight="700">A clear plan</text><path d="M365 153h52" stroke="#9fc9b1" stroke-width="3" stroke-linecap="round" />
                    </g>
                    <g class="flight-plane-new" filter="url(#flightShadow)" transform="translate(484 92) rotate(-9 130 86)">
                        <path d="M5 98 262 5 151 114Z" fill="url(#flightPlane)" stroke="#078650" stroke-width="2.5" stroke-linejoin="round" />
                        <path d="m151 114 111-109-48 172-35-89Z" fill="#39b982" stroke="#078650" stroke-width="2.5" stroke-linejoin="round" />
                        <path d="m151 114 89-37-24 65Z" fill="#edfff6" stroke="#62c99b" stroke-width="1.5" />
                        <path d="m151 114 61-37" fill="none" stroke="#078650" stroke-opacity=".72" stroke-width="2" />
                    </g>
                    <circle cx="777" cy="75" r="58" fill="url(#flightGlow)" />
                    <circle cx="777" cy="75" r="27" fill="#fff8d5" stroke="#fff" stroke-width="5" />
                    <circle cx="777" cy="75" r="10" fill="#fff" opacity=".9" />
                    <path d="m778 34 4 12 12 4-12 4-4 12-4-12-12-4 12-4z" fill="#fff" />
                    <path d="m694 125 3 8 8 3-8 3-3 8-3-8-8-3 8-3z" fill="#fff" opacity=".9" />
                    <circle cx="462" cy="82" r="4" fill="#f0c96c" />
                    <circle cx="846" cy="181" r="3" fill="#e7bf54" />
                    <text x="568" y="338" fill="var(--muted,#62766e)" font-family="Inter,Arial,sans-serif" font-size="11" letter-spacing="1.5">IDEA  ·  DIRECTION  ·  POSSIBILITY</text>
                </svg><p class="art-caption">Capture an idea. Find a direction. Move forward.</p>
            </div>
        </section>
        <section class="concept-auth" aria-labelledby="auth-title"><div class="concept-auth-card" id="google-auth-card" data-google-auth-url="https://localhost:7014/api/auth/google/start"><div class="concept-auth-mark"><img src="/app_img/img_logo_color.png" alt="" /></div><p class="concept-auth-kicker">ASKPEARLS DEVELOPMENT PORTAL</p><h2 id="auth-title">Let your next<br />idea take flight.</h2><p class="concept-auth-copy">Your ideas, notes and next steps come together in one place.</p><button class="google-button" id="google-signin" type="button" data-google-signin><svg viewBox="0 0 48 48" aria-hidden="true"><path fill="#FFC107" d="M43.6 24.5c0-1.6-.1-3.1-.4-4.5H24v8.5h11a9.4 9.4 0 0 1-4.1 6.2v5.2h6.7c3.9-3.6 6-8.9 6-15.4Z" /><path fill="#FF3D00" d="M24 44c5.5 0 10.1-1.8 13.5-4.9l-6.7-5.2c-1.8 1.2-4.1 2-6.8 2-5.2 0-9.7-3.5-11.3-8.2H5.8v5.4A20 20 0 0 0 24 44Z" /><path fill="#4CAF50" d="M12.7 27.7a12 12 0 0 1 0-7.4v-5.4H5.8a20 20 0 0 0 0 18.2l6.9-5.4Z" /><path fill="#1976D2" d="M24 12.1c3 0 5.6 1 7.7 3.1l5.8-5.8C34 6.1 29.4 4 24 4A20 20 0 0 0 5.8 14.9l6.9 5.4c1.6-4.7 6.1-8.2 11.3-8.2Z" /></svg><span>Continue with Google</span></button><p class="auth-message" id="auth-message" data-auth-message role="status" aria-live="polite"></p><div class="concept-trust"><span class="trust-check">✓</span><span>New users are set up automatically. Your work stays private.</span></div><p class="concept-legal">By continuing, you agree to our<br /><button type="button" data-info-open="terms">Terms of Service</button> and <button type="button" data-info-open="privacy">Privacy Policy</button>.</p></div></section>
    </main>
    <partial name="_SignInInfoModal" /><footer class="concept-footer"><a class="concept-footer-brand" href="/"><img src="/app_img/img_logo_color.png" alt="" /><strong>AskPearls Limited</strong></a><span>From ideas to action.</span><nav aria-label="Help and legal"><button type="button" data-info-open="help">Help</button><button type="button" data-info-open="contact">Contact support</button><button type="button" data-info-open="terms">Terms</button><button type="button" data-info-open="privacy">Privacy</button></nav><span>© <span id="footer-year" data-year></span> All Rights Reserved.</span></footer>
</div>
</body>
</html>

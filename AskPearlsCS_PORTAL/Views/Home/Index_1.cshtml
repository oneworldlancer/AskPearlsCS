@{
    Layout = null;
}
<!doctype html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#f5fbf8">
    <title>Welcome to AskPearls</title>
    <link rel="stylesheet" href="~/app_page_css/app_page_index_1_css.css">
    <link rel="stylesheet" href="~/app_css/app_page_signin_info_modal_css.css">
    <script src="~/app_page_js/app_page_index_js.js" defer></script>
</head>
<body>
    <div class="sign-in-page">
        <header class="topbar">
            <a class="brand" href="/" aria-label="AskPearls home">
                <img src="/app_img/img_logo_color.png" alt="" class="brand-mark">
                <span class="brand-copy"><strong>AskPearls</strong><small>Capture. Engage. Convert.</small></span>
            </a>
            <nav class="top-actions" aria-label="Page options">
                <button class="help-link" type="button" data-info-open="help" aria-label="Open Help Center"><span>Help</span></button>
                <button class="theme-toggle" id="theme-toggle" type="button" data-theme-toggle aria-label="Switch to dark theme" title="Switch theme">
                    <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"></path></svg>
                    <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 15.5A8.5 8.5 0 0 1 8.5 3.5 8.5 8.5 0 1 0 20.5 15.5Z"></path></svg>
                </button>
            </nav>
        </header>

        <main class="main-content">
            <section class="welcome-panel" aria-labelledby="welcome-title">
                <p class="eyebrow">YOUR WORKSPACE, CONNECTED</p>
                <h1 id="welcome-title">Welcome to<br><span>AskPearls</span></h1>
                <p class="welcome-description">Build intelligent customer experiences for your website visitors.</p>

                <div class="workflow-art" aria-hidden="true">
                    <svg viewBox="0 0 560 300" role="presentation">
                        <defs>
                            <linearGradient id="flow" x1="0" x2="1"><stop stop-color="#19b982" /><stop offset="1" stop-color="#087b46" /></linearGradient>
                            <filter id="softGlow" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="5" result="blur" /><feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge></filter>
                        </defs>
                        <path class="flow-line" d="M280 67v49M280 116H105v54M280 116v54M280 116h175v54" />
                        <rect class="flow-root" x="202" y="20" width="156" height="52" rx="14" />
                        <circle class="flow-dot" cx="254" cy="46" r="6" />
                        <circle class="flow-dot" cx="280" cy="46" r="6" />
                        <circle class="flow-dot" cx="306" cy="46" r="6" />
                        <circle class="flow-node" cx="280" cy="116" r="11" />
                        <g class="flow-card" transform="translate(33 170)"><rect width="144" height="106" rx="18" /><circle cx="72" cy="36" r="17" /><path d="M43 78c2-17 12-25 29-25s27 8 29 25" /><path class="placeholder" d="M47 91h50" /></g>
                        <g class="flow-card" transform="translate(208 170)"><rect width="144" height="106" rx="18" /><path d="M47 34h50l-6 29H55zM53 34l-5-11h-9m25 52a4 4 0 1 0 0-8 4 4 0 0 0 0 8m29 0a4 4 0 1 0 0-8 4 4 0 0 0 0 8" /><path class="placeholder" d="M47 91h50" /></g>
                        <g class="flow-card" transform="translate(383 170)"><rect width="144" height="106" rx="18" /><path d="M47 72V53m25 19V38m25 34V25" /><path class="placeholder" d="M47 91h50" /></g>
                        <circle class="flow-node" cx="105" cy="170" r="8" />
                        <circle class="flow-node" cx="280" cy="170" r="8" />
                        <circle class="flow-node" cx="455" cy="170" r="8" />
                    </svg>
                </div>
                <p class="workflow-caption"><span class="caption-dot"></span> One sign-in connects you to every AskPearls workspace.</p>
            </section>

            <section class="auth-column" aria-labelledby="auth-title">
                <div class="auth-card" id="google-auth-card" data-google-auth-url="https://localhost:7014/api/auth/google/start">
                    <div class="google-emblem" aria-hidden="true">
                        <svg viewBox="0 0 48 48"><path fill="#FFC107" d="M43.6 24.5c0-1.6-.1-3.1-.4-4.5H24v8.5h11a9.4 9.4 0 0 1-4.1 6.2v5.2h6.7c3.9-3.6 6-8.9 6-15.4Z" /><path fill="#FF3D00" d="M24 44c5.5 0 10.1-1.8 13.5-4.9l-6.7-5.2c-1.8 1.2-4.1 2-6.8 2-5.2 0-9.7-3.5-11.3-8.2H5.8v5.4A20 20 0 0 0 24 44Z" /><path fill="#4CAF50" d="M12.7 27.7a12 12 0 0 1 0-7.4v-5.4H5.8a20 20 0 0 0 0 18.2l6.9-5.4Z" /><path fill="#1976D2" d="M24 12.1c3 0 5.6 1 7.7 3.1l5.8-5.8C34 6.1 29.4 4 24 4A20 20 0 0 0 5.8 14.9l6.9 5.4c1.6-4.7 6.1-8.2 11.3-8.2Z" /></svg>
                    </div>
                    <p class="card-kicker">ASKPEARLS DEVELOPMENT PORTAL</p>
                    <h2 id="auth-title">Continue to your workspace</h2>
                    <p class="auth-description">Use your Google account to sign in or create your AskPearls account.</p>
                    <button class="google-button" id="google-signin" type="button" data-google-signin>
                        <svg viewBox="0 0 48 48" aria-hidden="true"><path fill="#FFC107" d="M43.6 24.5c0-1.6-.1-3.1-.4-4.5H24v8.5h11a9.4 9.4 0 0 1-4.1 6.2v5.2h6.7c3.9-3.6 6-8.9 6-15.4Z" /><path fill="#FF3D00" d="M24 44c5.5 0 10.1-1.8 13.5-4.9l-6.7-5.2c-1.8 1.2-4.1 2-6.8 2-5.2 0-9.7-3.5-11.3-8.2H5.8v5.4A20 20 0 0 0 24 44Z" /><path fill="#4CAF50" d="M12.7 27.7a12 12 0 0 1 0-7.4v-5.4H5.8a20 20 0 0 0 0 18.2l6.9-5.4Z" /><path fill="#1976D2" d="M24 12.1c3 0 5.6 1 7.7 3.1l5.8-5.8C34 6.1 29.4 4 24 4A20 20 0 0 0 5.8 14.9l6.9 5.4c1.6-4.7 6.1-8.2 11.3-8.2Z" /></svg>
                        <span>Continue with Google</span>
                        <span class="button-arrow" aria-hidden="true">→</span>
                    </button>
                    <p class="auth-message" id="auth-message" data-auth-message role="status" aria-live="polite"></p>
                    <div class="first-time-note"><span class="note-check" aria-hidden="true">✓</span><p><strong>First time here?</strong><br>Your account and workspace are created after sign-in.</p></div>
                    <div class="privacy-note"><span class="privacy-icon" aria-hidden="true">◆</span><p>We only use the basic profile details needed to create and secure your account.</p></div>
                    <p class="legal-copy">By continuing, you agree to our<br><button class="legal-trigger" type="button" data-info-open="terms">Terms of Service</button> and <button class="legal-trigger" type="button" data-info-open="privacy">Privacy Policy</button>.</p>
                </div>
                <p class="support-copy">Need help getting started? <button class="legal-trigger" type="button" data-info-open="help">Visit the Help Center</button></p>
            </section>
        </main>

        <partial name="_SignInInfoModal" />
        <footer class="site-footer"><a href="/">AskPearls Limited</a><nav aria-label="Help and legal"><button class="legal-trigger" type="button" data-info-open="help">Help</button><button class="legal-trigger" type="button" data-info-open="contact">Contact support</button><button class="legal-trigger" type="button" data-info-open="terms">Terms</button><button class="legal-trigger" type="button" data-info-open="privacy">Privacy</button></nav><span>Patent Pending. © <span id="footer-year" data-year></span> All Rights Reserved.</span></footer>
    </div>
</body>
</html>

@{
    Layout = null;
}
<!doctype html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4faf7" />
    <title>AskPearls | One sign-in, every workspace</title>
    <link href="~/app_page_css/app_page_index_3_css.css" rel="stylesheet" />
    <link href="~/app_css/app_page_signin_info_modal_css.css" rel="stylesheet" />
    <script src="~/app_page_js/app_page_index_js.js" defer></script>
</head>
<body>
    <div class="portal-page">
        <header class="topbar">
            <a class="brand" href="/" aria-label="AskPearls home">
                <img src="/app_img/img_logo_color.png" alt="" class="brand-mark" />
                <span class="brand-copy"><strong>AskPearls</strong><small>Capture. Engage. Convert.</small></span>
            </a>
            <nav class="top-actions" aria-label="Page options">
                <button class="help-link" type="button" data-info-open="help" aria-label="Open Help Center"><span class="help-mark" aria-hidden="true">?</span><span class="help-label">Help</span></button>
                <button class="theme-toggle" id="theme-toggle" type="button" data-theme-toggle aria-label="Switch to dark theme" title="Switch theme">
                    <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"></path></svg>
                    <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 15.5A8.5 8.5 0 0 1 8.5 3.5 8.5 8.5 0 1 0 20.5 15.5Z"></path></svg>
                </button>
            </nav>
        </header>

        <main class="main-content">
            <section class="welcome-copy" aria-labelledby="welcome-title">
                <p class="eyebrow">DEVELOPMENT PORTAL</p>
                <h1 id="welcome-title">One sign-in.<br />Every <span>AskPearls</span> workspace.</h1>
                <p class="intro">Use your Google account to enter your portal. We’ll set up your account automatically if this is your first visit.</p>
                <div class="benefits">
                    <div class="benefit"><span class="benefit-icon" aria-hidden="true">✦</span><p><strong>Build faster</strong><small>Create and manage decision widgets with DecisionOS.</small></p></div>
                    <div class="benefit"><span class="benefit-icon" aria-hidden="true">▥</span><p><strong>Understand your visitors</strong><small>Turn conversations into useful insights.</small></p></div>
                    <div class="benefit"><span class="benefit-icon" aria-hidden="true">✧</span><p><strong>Convert with confidence</strong><small>Deliver recommendations that move customers forward.</small></p></div>
                </div>
            </section>

            <section class="workspace-stage" aria-label="AskPearls workspace sign-in">
                <div class="orbit orbit-outer" aria-hidden="true"></div>
                <div class="orbit orbit-inner" aria-hidden="true"></div>
                <span class="orbit-point point-top" aria-hidden="true"></span><span class="orbit-point point-right" aria-hidden="true"></span><span class="orbit-point point-bottom" aria-hidden="true"></span><span class="orbit-point point-left" aria-hidden="true"></span>

                <article class="workspace-tile tile-decision" aria-hidden="true"><span class="tile-icon">⌘</span><span><strong>DecisionOS</strong><small>Guided decisions</small></span></article>
                <article class="workspace-tile tile-engage" aria-hidden="true"><span class="tile-icon">◌</span><span><strong>Conversations</strong><small>Customer engagement</small></span></article>
                <article class="workspace-tile tile-analytics" aria-hidden="true"><span class="tile-icon">▥</span><span><strong>Analytics</strong><small>Performance insights</small></span></article>
                <article class="workspace-tile tile-recommend" aria-hidden="true"><span class="tile-icon">✦</span><span><strong>Recommendations</strong><small>Personalized outcomes</small></span></article>

                <div class="auth-card" id="google-auth-card" data-google-auth-url="/Home/GoogleLogin">
                    <div class="google-emblem" aria-hidden="true"><svg viewBox="0 0 48 48"><path fill="#FFC107" d="M43.6 24.5c0-1.6-.1-3.1-.4-4.5H24v8.5h11a9.4 9.4 0 0 1-4.1 6.2v5.2h6.7c3.9-3.6 6-8.9 6-15.4Z" /><path fill="#FF3D00" d="M24 44c5.5 0 10.1-1.8 13.5-4.9l-6.7-5.2c-1.8 1.2-4.1 2-6.8 2-5.2 0-9.7-3.5-11.3-8.2H5.8v5.4A20 20 0 0 0 24 44Z" /><path fill="#4CAF50" d="M12.7 27.7a12 12 0 0 1 0-7.4v-5.4H5.8a20 20 0 0 0 0 18.2l6.9-5.4Z" /><path fill="#1976D2" d="M24 12.1c3 0 5.6 1 7.7 3.1l5.8-5.8C34 6.1 29.4 4 24 4A20 20 0 0 0 5.8 14.9l6.9 5.4c1.6-4.7 6.1-8.2 11.3-8.2Z" /></svg></div>
                    <p class="card-kicker">ASKPEARLS WORKSPACE</p>
                    <h2>Welcome to your portal</h2>
                    <p class="auth-description">Continue securely with your Google account.</p>
                    <button class="google-button" id="google-signin" type="button" data-google-signin>
                        <svg viewBox="0 0 48 48" aria-hidden="true"><path fill="#FFC107" d="M43.6 24.5c0-1.6-.1-3.1-.4-4.5H24v8.5h11a9.4 9.4 0 0 1-4.1 6.2v5.2h6.7c3.9-3.6 6-8.9 6-15.4Z" /><path fill="#FF3D00" d="M24 44c5.5 0 10.1-1.8 13.5-4.9l-6.7-5.2c-1.8 1.2-4.1 2-6.8 2-5.2 0-9.7-3.5-11.3-8.2H5.8v5.4A20 20 0 0 0 24 44Z" /><path fill="#4CAF50" d="M12.7 27.7a12 12 0 0 1 0-7.4v-5.4H5.8a20 20 0 0 0 0 18.2l6.9-5.4Z" /><path fill="#1976D2" d="M24 12.1c3 0 5.6 1 7.7 3.1l5.8-5.8C34 6.1 29.4 4 24 4A20 20 0 0 0 5.8 14.9l6.9 5.4c1.6-4.7 6.1-8.2 11.3-8.2Z" /></svg>
                        <span>Continue with Google</span><span class="button-arrow" aria-hidden="true">→</span>
                    </button>
                    <p class="auth-message" id="auth-message" data-auth-message role="status" aria-live="polite"></p>
                    <p class="first-time-note"><span aria-hidden="true">✓</span><span><strong>First time here?</strong><br />Your account and workspace are created after sign-in.</span></p>
                    <p class="legal-copy">By continuing, you agree to our<br /><button class="legal-trigger" type="button" data-info-open="terms">Terms of Service</button> and <button class="legal-trigger" type="button" data-info-open="privacy">Privacy Policy</button>.</p>
                </div>
            </section>
        </main>

        <partial name="_SignInInfoModal" />
        <partial name="_IndexFooterModel" />
    </div>
</body>
</html>

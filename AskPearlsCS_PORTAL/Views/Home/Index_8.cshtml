<body>
    <div class="concept-page concept-8">
        <header class="concept-header"><a class="concept-brand" href="/" aria-label="AskPearls home"><img src="/app_img/img_logo_color.png" alt="" /><span><strong>AskPearls</strong><small>Capture. Engage. Convert.</small></span></a><nav class="concept-actions" aria-label="Page options"><button class="concept-help" type="button" data-info-open="help"><span class="help-ring">?</span>Help</button><button class="concept-theme" id="theme-toggle" type="button" data-theme-toggle aria-label="Switch to dark theme" title="Switch theme"><svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42 1.42" /></svg><svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 15.5A8.5 8.5 0 0 1 8.5 3.5 8.5 8.5 0 1 0 20.5 15.5Z" /></svg></button></nav></header>
        <main class="concept-main">
            <section class="concept-story" aria-labelledby="concept-title">
                <div class="concept-copy"><p class="concept-kicker">YOUR IDEAS, IN ONE THOUGHTFUL WORKSPACE</p><h1 id="concept-title">Your ideas.<br /><em>Organised.</em><br />With you.</h1><p class="concept-description">Ask, plan, create and get clearer answers — all in one intelligent workspace.</p></div>
                <div class="concept-art desk-art" role="img" aria-label="A woman working at her laptop, surrounded by idea, research, plan and create cards"><div class="desk-glow"></div><div class="leaf-cluster"><i></i><i></i><i></i><i></i></div><div class="idea-card-float idea-note"><b>✦</b><span>Ideas<i></i><i></i></span></div><div class="idea-card-float plan-note"><b>✓</b><span>Plan<i></i><i></i></span></div><div class="idea-card-float research-note"><b>⌕</b><span>Research<i></i><i></i></span></div><div class="idea-card-float create-note"><b>✎</b><span>Create<i></i><i></i></span></div><div class="desk-person" aria-hidden="true"><div class="person-body"></div><div class="person-neck"></div><div class="person-hair"></div><div class="person-face"></div><div class="person-arm"></div></div><div class="desk-laptop" aria-hidden="true">✦</div><div class="desk-surface"></div><div class="desk-cup"></div><p class="art-caption">Turn ideas into plans · Work better together · Get things done faster</p></div>
            </section>
            <section class="concept-auth" aria-labelledby="auth-title"><div class="concept-auth-card" id="google-auth-card" data-google-auth-url="https://localhost:7014/api/auth/google/start"><div class="concept-auth-mark"><img src="/app_img/img_logo_color.png" alt="" /></div><p class="concept-auth-kicker">ASKPEARLS DEVELOPMENT PORTAL</p><h2 id="auth-title">Your ideas,<br />ready to grow.</h2><p class="concept-auth-copy">Sign in to save your work and pick up where inspiration left off.</p><button class="google-button" id="google-signin" type="button" data-google-signin><svg viewBox="0 0 48 48" aria-hidden="true"><path fill="#FFC107" d="M43.6 24.5c0-1.6-.1-3.1-.4-4.5H24v8.5h11a9.4 9.4 0 0 1-4.1 6.2v5.2h6.7c3.9-3.6 6-8.9 6-15.4Z" /><path fill="#FF3D00" d="M24 44c5.5 0 10.1-1.8 13.5-4.9l-6.7-5.2c-1.8 1.2-4.1 2-6.8 2-5.2 0-9.7-3.5-11.3-8.2H5.8v5.4A20 20 0 0 0 24 44Z" /><path fill="#4CAF50" d="M12.7 27.7a12 12 0 0 1 0-7.4v-5.4H5.8a20 20 0 0 0 0 18.2l6.9-5.4Z" /><path fill="#1976D2" d="M24 12.1c3 0 5.6 1 7.7 3.1l5.8-5.8C34 6.1 29.4 4 24 4A20 20 0 0 0 5.8 14.9l6.9 5.4c1.6-4.7 6.1-8.2 11.3-8.2Z" /></svg><span>Continue with Google</span></button><p class="auth-message" id="auth-message" data-auth-message role="status" aria-live="polite"></p><div class="concept-trust"><span class="trust-check">✓</span><span>New users are set up automatically. Your Google password stays with Google.</span></div><p class="concept-legal">By continuing, you agree to our<br /><button type="button" data-info-open="terms">Terms of Service</button> and <button type="button" data-info-open="privacy">Privacy Policy</button>.</p></div></section>
        </main>
        <partial name="_SignInInfoModal" /><footer class="concept-footer"><a class="concept-footer-brand" href="/"><img src="/app_img/img_logo_color.png" alt="" /><strong>AskPearls Limited</strong></a><span>Ideas, organised. Possibilities, unlocked.</span><nav aria-label="Help and legal"><button type="button" data-info-open="help">Help</button><button type="button" data-info-open="contact">Contact support</button><button type="button" data-info-open="terms">Terms</button><button type="button" data-info-open="privacy">Privacy</button></nav><span>© <span id="footer-year" data-year></span> All Rights Reserved.</span></footer>

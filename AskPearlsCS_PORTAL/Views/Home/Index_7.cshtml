@{
    Layout = null;
}
<!doctype html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#faf9f2" />
    <title>AskPearls | Every great choice starts with a question</title>
    <link rel="stylesheet" href="~/app_page_css/app_page_index_7_css.css?v=7" />
    <link rel="stylesheet" href="~/app_css/app_page_signin_info_modal_css.css" />
    <script src="~/app_page_js/app_page_index_js.js" defer></script>
</head>
<body>
    <div class="garden-page">
        <header class="garden-header">
            <a class="garden-brand" href="/" aria-label="AskPearls home">
                <img src="/app_img/img_logo_color.png" alt="" />
                <span><strong>AskPearls</strong><small>Deeper questions. Brighter tomorrows.</small></span>
            </a>
            <nav class="garden-actions" aria-label="Page options">
                <button class="garden-help" type="button" data-info-open="help"><span class="help-circle" aria-hidden="true">?</span> Help</button>
                <button class="garden-theme" id="theme-toggle" type="button" data-theme-toggle aria-label="Switch to dark theme" title="Switch theme">
                    <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"></path></svg>
                    <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 15.5A8.5 8.5 0 0 1 8.5 3.5 8.5 8.5 0 1 0 20.5 15.5Z"></path></svg>
                </button>
            </nav>
        </header>

        <main class="garden-main">
            <div class="garden-stage">
                <section class="garden-story" aria-labelledby="garden-title">
                    <div class="garden-copy">
                        <p class="garden-eyebrow"><span aria-hidden="true">✦</span> A CLEARER PATH FORWARD</p>
                        <h1 id="garden-title">Every great choice<br />starts with a <em>question.</em></h1>
                        <p class="garden-intro">Ask deeper questions. Explore new perspectives. Get personalized recommendations to move forward with confidence.</p>
                    </div>
                    <div class="choice-garden" role="img" aria-label="A peaceful garden landscape with three open paths leading toward a glowing pearl">
                        <svg class="garden-art-illustration" viewBox="0 0 900 420" role="img" aria-labelledby="garden-art-title" preserveAspectRatio="xMidYMid meet">
                            <title id="garden-art-title">Open paths through a calm garden</title>
                            <defs>
                                <linearGradient id="garden-hill-back" x1="0" y1="0" x2="0" y2="1"><stop stop-color="#9fd7b8" stop-opacity=".32" /><stop offset="1" stop-color="#3a9b70" stop-opacity=".12" /></linearGradient>
                                <linearGradient id="garden-hill-front" x1="0" y1="0" x2="0" y2="1"><stop stop-color="#2e8a62" stop-opacity=".25" /><stop offset="1" stop-color="#0c563b" stop-opacity=".42" /></linearGradient>
                                <linearGradient id="garden-road" x1="0" y1="0" x2="0" y2="1"><stop stop-color="#f8e9b2" /><stop offset="1" stop-color="#caa85c" /></linearGradient>
                                <radialGradient id="garden-pearl-fill" cx="35%" cy="28%"><stop stop-color="#fffef0" /><stop offset=".38" stop-color="#d8f7dc" /><stop offset="1" stop-color="#5bcf9b" /></radialGradient>
                                <filter id="garden-glow" x="-100%" y="-100%" width="300%" height="300%"><feGaussianBlur stdDeviation="15" /></filter>
                            </defs>
                            <circle cx="450" cy="335" r="86" fill="#7ce0b5" opacity=".17" filter="url(#garden-glow)" />
                            <path d="M0 236 Q120 164 245 222 T470 202 Q680 136 900 210 V420 H0Z" fill="url(#garden-hill-back)" />
                            <path d="M0 284 Q130 218 260 270 T500 246 Q700 192 900 250 V420 H0Z" fill="url(#garden-hill-front)" />
                            <path d="M450 350 C425 295 388 260 300 232 C242 214 204 197 180 161" fill="none" stroke="url(#garden-road)" stroke-width="24" stroke-linecap="round" opacity=".78" />
                            <path d="M450 350 C450 288 450 242 450 174" fill="none" stroke="url(#garden-road)" stroke-width="26" stroke-linecap="round" opacity=".86" />
                            <path d="M450 350 C478 294 520 261 600 232 C666 207 708 191 730 157" fill="none" stroke="url(#garden-road)" stroke-width="24" stroke-linecap="round" opacity=".78" />
                            <path d="M0 344 Q160 312 305 342 T600 337 Q760 310 900 344 V420 H0Z" fill="#1d704d" opacity=".15" />
                            <g fill="#338b5d" opacity=".8"><path d="M52 320q-35-40-3-61 19 31 3 61Zm11 2q5-49 39-45-4 36-39 45Zm-3 8q-10-35 13-48 15 30-13 48Z" /><path d="M837 320q-35-40-3-61 19 31 3 61Zm11 2q5-49 39-45-4 36-39 45Zm-3 8q-10-35 13-48 15 30-13 48Z" /></g>
                            <circle cx="450" cy="350" r="42" fill="#66d8a6" opacity=".25" />
                            <circle cx="450" cy="350" r="30" fill="url(#garden-pearl-fill)" stroke="#f5f7d9" stroke-width="5" />
                            <path d="m450 336 4 10 10 4-10 4-4 10-4-10-10-4 10-4Z" fill="#fffde7" />
                        </svg>
                    </div>
                </section>

                <section class="garden-auth" aria-labelledby="auth-title">
                    <div class="garden-card" id="google-auth-card" data-google-auth-url="/Home/GoogleLogin">
                        <p class="auth-eyebrow">ASKPEARLS DEVELOPMENT PORTAL</p>
                        <h2 id="auth-title">Your AskPearls<br />workspace</h2>
                        <p class="auth-intro">Sign in to save your conversations, see personalized recommendations, and pick up where you left off.</p>
                        <button class="google-button" id="google-signin" type="button" data-google-signin>
                            <svg viewBox="0 0 48 48" aria-hidden="true"><path fill="#FFC107" d="M43.6 24.5c0-1.6-.1-3.1-.4-4.5H24v8.5h11a9.4 9.4 0 0 1-4.1 6.2v5.2h6.7c3.9-3.6 6-8.9 6-15.4Z" /><path fill="#FF3D00" d="M24 44c5.5 0 10.1-1.8 13.5-4.9l-6.7-5.2c-1.8 1.2-4.1 2-6.8 2-5.2 0-9.7-3.5-11.3-8.2H5.8v5.4A20 20 0 0 0 24 44Z" /><path fill="#4CAF50" d="M12.7 27.7a12 12 0 0 1 0-7.4v-5.4H5.8a20 20 0 0 0 0 18.2l6.9-5.4Z" /><path fill="#1976D2" d="M24 12.1c3 0 5.6 1 7.7 3.1l5.8-5.8C34 6.1 29.4 4 24 4A20 20 0 0 0 5.8 14.9l6.9 5.4c1.6-4.7 6.1-8.2 11.3-8.2Z" /></svg>
                            <span>Continue with Google</span>
                        </button>
                        <p class="auth-message" id="auth-message" data-auth-message role="status" aria-live="polite"></p>
                        <div class="new-account"><span class="account-rule"></span><p><strong>New to AskPearls?</strong><br />Your account is created automatically when you sign in with Google.</p></div>
                        <div class="privacy-note"><span class="privacy-shield" aria-hidden="true">⌑</span><p>Your data is private and secure.<br /><small>We never share your personal information.</small></p></div>
                        <p class="legal-copy">By continuing, you agree to our<br /><button type="button" data-info-open="terms">Terms of Service</button><span> and </span><button type="button" data-info-open="privacy">Privacy Policy</button>.</p>
                    </div>
                    <p class="auth-caption"><span>✦</span> Your account and workspace are ready after sign-in.</p>
                </section>
            </div>

            <section class="garden-benefits" aria-label="How AskPearls helps">
                <article><span class="benefit-icon">♧</span><h3>Explore</h3><p>Ask what matters and uncover new possibilities.</p></article>
                <article><span class="benefit-icon">◉</span><h3>Get perspective</h3><p>See tailored insights based on your unique context.</p></article>
                <article><span class="benefit-icon">✧</span><h3>Make confident choices</h3><p>Turn clarity into action with recommendations.</p></article>
                <article><span class="benefit-icon">❧</span><h3>Grow over time</h3><p>Save your insights and revisit your journey.</p></article>
            </section>
        </main>

        <partial name="_SignInInfoModal" />
        <partial name="_IndexFooterModel" />
    </div>
</body>
</html>

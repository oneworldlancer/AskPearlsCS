
@* ==============================================
   ASKPEARLS — SHARED INDEX HEADER
   Used by all 15 homepage designs
   ============================================== *@

<header class="atelier-header">

    <!-- Logo + Brand -->
    <a class="atelier-brand ap-uniform-brand"
       href="/"
       aria-label="AskPearls home">

        <img src="/app_img/img_logo_color.png"
             alt="AskPearls Logo" />

        <span class="ap-uniform-copy"><strong class="ap-uniform-name">Ask<span class="ap-uniform-accent">Pearls</span></strong><small class="ap-uniform-slogan">@(ViewData["HeaderSlogan"] as string ?? "Capture. Engage. Convert.")</small></span>

    </a>

    <!-- Header Actions -->
    <nav class="atelier-actions"
         aria-label="Page options">

        <!-- Help -->
        <button class="atelier-help"
                type="button"
                data-info-open="help">

            <span class="help-mark"
                  aria-hidden="true">?</span>

            <span>Help</span>

        </button>

        <!-- Divider -->
        <span class="action-divider"
              aria-hidden="true"></span>

        <!-- Theme Toggle -->
      
        <button type="button"
                id="theme-toggle"
                class="ap-theme-toggle"
                data-theme-toggle
                aria-label="Switch to dark theme"
                title="Switch theme">

            <svg class="icon-moon"
                 viewBox="0 0 24 24"
                 aria-hidden="true">
                <path d="M20.5 15.5A8.5 8.5 0 0 1 8.5 3.5 8.5 8.5 0 1 0 20.5 15.5Z" />
            </svg>

            <svg class="icon-sun"
                 viewBox="0 0 24 24"
                 aria-hidden="true">
                <circle cx="12" cy="12" r="4" />
                <path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" />
            </svg>

        </button>


    </nav>

</header>

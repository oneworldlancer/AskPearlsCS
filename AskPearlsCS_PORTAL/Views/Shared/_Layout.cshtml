<script>


        $(document).on("click", "#askPearlsSidebar .ap-nav-link", function(e) {
            e.preventDefault();

            const section = $(this).data("page");

            if (!section) {
                console.warn("No data-page attribute found.");
                return;
            }

            console.log("Loading portal section:", section);

            $("#askPearlsSidebar .ap-nav-link").removeClass("active");
            $(this).addClass("active");

            $.ajax({
                url: "/Dashboard/LoadSection",
                type: "GET",
                data: { section: section },

                success: function(html) {
                    $("#apMainContent").html(html);
                },

                error: function(xhr) {
                    console.error(
                        "Section loading failed:",
                        xhr.status,
                        xhr.responseText
                    );

                    alert("Unable to load the Dashboard section. Check the browser console.");
                }
            });
        });





        $(document).on(
            "click",
            "#apMainContent [data-page='widget-builder']",
            function(e) {
                e.preventDefault();

                const section = $(this).data("page");

                $.ajax({
                    url: "/Dashboard/LoadSection",
                    type: "GET",
                    data: { section: section },

                    success: function(html) {
                        $("#apMainContent").html(html);
                    },

                    error: function() {
                        console.error("Failed to load page:", section);
                    }
                });
            }
        );


</script>



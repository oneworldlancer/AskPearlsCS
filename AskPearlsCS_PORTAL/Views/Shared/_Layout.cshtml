<!-- Modal Container with custom 'modal-bottom' class -->
<style>
        /* Position the modal container at the very bottom */
        .modal-bottom .modal-dialog {
            position: fixed;
            margin: 0;
            width: 100%;
            max-width: 100%;
            bottom: 0;
            left: 0;
            right: 0;
        }

        /* Set the initial hidden position below the viewport */
        .modal-bottom.fade .modal-dialog {
            transform: translate3d(0, 100%, 0);
            transition: transform 0.3s ease-out;
        }

        /* Slide it up to its final position when active */
        .modal-bottom.show .modal-dialog {
            transform: translate3d(0, 0, 0);
        }

        /* Round only the top corners of the modal sheet */
        .modal-bottom .modal-content {
            border-radius: 1rem 1rem 0 0;
            border: none;
        }

</style>

<div class="modal fade modal-bottom" id="bottomModal" data-bs-backdrop="static" tabindex="10000" aria-labelledby="bottomModalLabel" aria-hidden="true">

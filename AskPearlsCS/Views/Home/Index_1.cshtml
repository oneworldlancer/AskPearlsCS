@{ Layout = null; ViewData["Title"] = "AskPearls | AI Customer Engagement Platform"; }
<!DOCTYPE html>
<html lang="en" data-theme="light"><head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"/>
<meta name="theme-color" content="#f6fbfa"/>
<partial name="_SeoMeta"/><partial name="_SeoStructuredData"/><partial name="_GoogleTracking"/>
<title>AskPearls | AI Customer Engagement Platform</title>
<link href="~/app_img/favicon.ico" rel="icon"/><link href="~/app_img/apple-touch-icon.png" rel="apple-touch-icon"/>
<script>try {var t=localStorage.getItem('askpearls-public-theme');document.documentElement.dataset.theme=t==='dark'?'dark':'light';}catch(e){}</script>
<link rel="stylesheet" href="~/css/site.css"/>
<link rel="stylesheet" href="~/app_page_css/app_page_public_home_variant_1.css" asp-append-version="true"/>
<link rel="stylesheet" href="~/app_css/app_scrollbar_css.css"/>
<link rel="stylesheet" href="~/app_page_css/askpearls_uniform_brand.css" asp-append-version="true"/>
<link rel="stylesheet" href="~/app_page_css/askpearls_uniform_exact.css" asp-append-version="true"/>
<link rel="stylesheet" href="~/app_page_css/askpearls_public_header_theme_fix.css" asp-append-version="true"/>
<script src="~/app_page_js/app_page_public_home_js.js" defer asp-append-version="true"></script>
</head><body><div class="ap-public" id="apPublic">
<header class="ap-header">
<a class="ap-brand ap-uniform-brand" href="/" data-home aria-label="AskPearls home"><img src="~/app_img/img_logo_color.png" alt=""/><span class="ap-uniform-copy"><strong class="ap-uniform-name">Ask<span class="ap-uniform-accent">Pearls</span></strong><small class="ap-uniform-slogan">@ViewBag.HeaderSlogan</small></span></a>
<nav class="ap-nav" aria-label="Primary navigation"><button type="button" data-menu="product" aria-expanded="false">Product <span>⌄</span></button><button type="button" data-menu="solutions" aria-expanded="false">Solutions <span>⌄</span></button><button type="button" data-menu="cases" aria-expanded="false">Use Cases <span>⌄</span></button><button type="button" data-view="pricing">Pricing</button><button type="button" data-menu="resources" aria-expanded="false">Resources <span>⌄</span></button></nav>
<div class="ap-actions"><button class="ap-theme" type="button" data-theme-toggle aria-label="Switch to dark theme" title="Toggle light or dark theme"><svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 15.6A8.6 8.6 0 0 1 8.4 4 8.5 8.5 0 1 0 20 15.6Z"/></svg><svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg></button><a class="ap-join ap-join-top" href="https://portal.askpearls.com/">Join AskPearls <span aria-hidden="true">→</span></a><button class="ap-hamburger" type="button" data-mobile-toggle aria-label="Open navigation" aria-expanded="false"><span></span><span></span><span></span></button></div>
</header>
<div class="ap-menu-panel" data-menu-panel hidden></div>
<div class="ap-mobile-menu" data-mobile-menu hidden><div class="ap-mobile-links"><button data-view="home">Home</button><button data-menu="product">Product ▾</button><button data-menu="solutions">Solutions ▾</button><button data-menu="cases">Use Cases ▾</button><button data-view="pricing">Pricing</button><button data-menu="resources">Resources ▾</button><button data-view="about">About Us</button><button data-view="contact">Contact Us</button><button data-view="privacy">Privacy Policy</button><button data-view="terms">Terms of Service</button></div><a class="ap-join" href="https://portal.askpearls.com/">Join AskPearls →</a></div>
<main class="ap-stage" id="apStage"><section class="ap-home" data-home-panel aria-labelledby="apHeadline">
<div class="ap-copy"><p class="ap-eyebrow"><span></span> THE INTELLIGENT CUSTOMER ASSISTANT</p><h1 id="apHeadline">Capture.<br/>Engage.<br/>Convert.<br/><em>With AskPearls.</em></h1><p class="ap-intro">Turn website visitors into qualified leads, answer questions instantly, and keep conversations moving with intelligent automation.</p><div class="ap-hero-actions"><a class="ap-join" href="https://portal.askpearls.com/">Join AskPearls →</a><button class="ap-outline" type="button" data-view="how">See How It Works ↗</button></div><div class="ap-benefits"><span>✓ Free account</span><span>✓ Quick setup</span><span>✓ No credit card</span></div></div><div class="ap-visual" aria-label="Illustration of AskPearls AI responding to a customer inquiry">
<div class="ap-orbit orbit-one"></div><div class="ap-orbit orbit-two"></div>
<div class="ap-pearl-halo"><div class="ap-pearl"><img src="~/app_img/img_logo_color.png" alt="" /></div></div>
<div class="ap-chat"><div class="ap-chat-head"><span class="ap-avatar">AP</span><div><strong>AskPearls AI</strong><small><i></i> Your business assistant</small></div><span>•••</span></div><div class="ap-bubble visitor">Do you offer custom solutions for small businesses?</div><div class="ap-bubble agent">Absolutely! Tell me what you're looking for and I'll help you get started.</div><div class="ap-chat-quick"><span>Book a meeting</span><span>Get a proposal</span></div><div class="ap-chat-input">Type a message... <b>➤</b></div></div>
<div class="ap-feature f1">◉ <span>AI Conversations</span></div><div class="ap-feature f2">◎ <span>Lead Capture</span></div><div class="ap-feature f3">ϟ <span>Automation</span></div><div class="ap-feature f4">↗ <span>Business Growth</span></div>
</div></section><section class="ap-inner" data-inner-panel hidden aria-live="polite"><div class="ap-inner-heading"><button type="button" data-view="home" class="ap-back">← Home</button><span class="ap-inner-label">ASKPEARLS</span></div><div class="ap-inner-scroll" data-inner-scroll tabindex="0"></div></section></main>
<footer class="ap-footer"><span>© @DateTime.UtcNow.Year AskPearls</span><nav aria-label="Footer"><button data-view="about">About Us</button><button data-view="contact">Contact Us</button><button data-view="privacy">Privacy Policy</button><button data-view="terms">Terms of Service</button><a href="https://developer.askpearls.com/">Developer Center</a></nav><span>AI Chat · Leads · Growth</span></footer>
</div></body></html>

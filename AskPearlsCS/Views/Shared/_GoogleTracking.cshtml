@{
    var ga4Id = "G-XXXXXXXXXX";
    var googleAdsId = "AW-XXXXXXXXXX";
}

<script async
        src="https://www.googletagmanager.com/gtag/js?id=@ga4Id">
</script>

<script>
    window.dataLayer = window.dataLayer || [];

    function gtag() {
        dataLayer.push(arguments);
    }

    gtag('js', new Date());

    gtag('config', '@ga4Id');
    gtag('config', '@googleAdsId');
</script>